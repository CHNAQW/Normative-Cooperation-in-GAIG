],["become","VERB",""],["more","ADV",""],["sophisticated","ADJ",""],null,["it","PRON",""],["is","AUX","be"],["important","ADJ",""],["to","PART",""],["ensure","VERB",""],["that","SCONJ",""],["individuals","NOUN","individual"],["realize","VERB",""],["when","SCONJ",""],["they","PRON",""],["are","AUX","be"],["interacting","VERB","interact"],["with","ADP",""],["an","DET",""],["ai","PROPN",""],["system","NOUN",""],["or","CCONJ",""],["with","ADP",""],["ai","PROPN",""],null,["generated","VERB","generate"],["content","NOUN",""],null],"text":"Generative AI systems pose a particular challenge for transparency.Their output can be difficult to explain or rationalize, and their training data and source code may not be publicly available.As generative AI systems become more sophisticated, it is important to ensure that individuals realize when they are interacting with an AI system or with AI-generated content.","idx":30,"match_words":["generative","system","a particular challenge","transparency","their output","training","datum","code","available","generative","system","more","important","ensure","individual","an ai system","generate","content"],"words":["generative","ai","system","pose","a particular challenge","for","transparency","their output","can","be","difficult","to","explain","or","rationalize","and","their","training","datum","and","source","code","may","not","be","publicly","available","as","generative","ai","system","become","more","sophisticated","it","be","important","to","ensure","that","individual","realize","when","they","be","interact","with","an ai system","or","with","ai","generate","content"],"unmatched_count":35,"match_length":18,"cut_length":53},{"key":"34","text_words":[["developers","NOUN","developer"],["and","CCONJ",""],["deployers","NOUN","deployer"],["of","ADP",""],["generative","ADJ",""],["ai","PROPN",""],["systems","NOUN","system"],["would","AUX",""],[":","PUNCT",""]],"text":"Developers and deployers of generative AI systems would:","idx":31,"match_w