it"},{"p":"0.0030","w":"potentially harmful or inappropriate use"},{"p":"0.0030","w":"human"},{"p":"0.0029","w":"specific"},{"p":"0.0029","w":"testing"},{"p":"0.0029","w":"the ai value chain"},{"p":"0.0028","w":"a generative ai system"},{"p":"0.0028","w":"wide"},{"p":"0.0028","w":"a meaningful explanation"},{"p":"0.0028","w":"the process"},{"p":"0.0028","w":"profile"},{"p":"0.0028","w":"any organization"},{"p":"0.0028","w":"a comprehensive and multifaceted risk management process"},{"p":"0.0027","w":"assess"},{"p":"0.0027","w":"practice"},{"p":"0.0025","w":"expert"},{"p":"0.0025","w":"a particular challenge"}]],"texts":[{"key":"0","text_words":[["advanced","PROPN",""],["ai","PROPN",""],["systems","NOUN","system"],["capable","ADJ",""],["of","ADP",""],["generating","VERB","generate"],["content","NOUN",""],null,["—","PUNCT",""],["such","ADJ",""],["as","ADP",""],["chatgpt","NOUN","chatgpt"],null,["dall·e","PROPN",""],["2","NUM",""],null,["and","CCONJ",""],["midjourney","PROPN",""],null,["—","PUNCT",""],["have","AUX",""],["captured","VERB","capture"],["the","DET",""],["world","NOUN",""],["'s","PART",""],["attention","NOUN",""],null,["the","DET","the"],["general","ADJ",""],null,["purpose","NOUN",""],["capabilities","NOUN","capability"],["of","ADP",""],["these","DET",""],["advanced","ADJ",""],["ai","PROPN",""],["systems","NOUN","system"],["offer","VERB",""],["enormous","ADJ",""],["potential","NOUN",""],["for","ADP",""],["innovation","NOUN",""],["in","ADP",""],["a","DET",""],["number","NOUN",""],["of","ADP",""],["fields","NOUN","field"],null,["and","CCONJ",""],["they","PRON",""],["are","AUX","be"],["already","ADV",""],["being","AUX","be"],["adopted","VERB","adopt"],["and","CCONJ",""],["put","VERB",""],["to","PART",""],["use","VERB",""],["in","ADP",""],["a","DET",""],["variety","NOUN",""],["of","ADP",""],["contexts","PROPN",""],null,["these","DET","these"],["advanced","ADJ",""],["systems","NOUN","system"],["may","AUX",""],["be","AUX",""],["used","VERB","use"],["to","PART",""],["perform","VERB",""],["many","ADJ",""],["different","ADJ",""],["kinds","NOUN","kind"],["of","ADP",""],["tasks","NOUN","task"],null,["—","PUNCT",""],["such","ADJ",""],["as","ADP",""],["writing","VERB","write"],["emails","NOUN","email"],null,["answering","VERB","answer"],["complex","ADJ",""],["questions","NOUN","question"],null,["generating","VERB","generate"],["realistic","ADJ",""],["images","NOUN","image"],["or","CCONJ",""],["videos","NOUN","video"],null,["or","CCONJ",""],["writing","VERB","write"],["software","NOUN",""],["code","NOUN",""],null],"text":"Advanced AI systems capable of generating content — such as ChatGPT, DALL·E 2, and Midjourney — have captured the world's attention.The general-purpose capabilities of these advanced AI systems offer enormous potential for innovation in a number of fields, and they are already being adopted and put to use in a variety of contexts.These advanced systems may be used to perform many different kinds of tasks — such as writing emails, answering complex questions, generating realistic images or videos, or writing software code.","idx":0,"match_words":["advanced","system","generate","content","such","have","world","purpose","capability","advanced","system","enormous potential","a number","put","use","a variety","advanced","system","use","perform","many","different","task","such","generate","image","software code"],"words":["advanced","ai","system","capable","of","generate","content","such","as","chatgpt","dall·e","and","midjourney","have","capture","the","world","'s","attention","the","general","purpose","capability","of","these","advanced","ai","system","offer","enormous potential","for","innovation","in","a number","of","field","and","they","be","already","be","adopt","and","put","to","use","in","a variety","of","contexts","these","advanced","system","may","be","use","to","perform","many","different","kind","of","task","such","as","write","email","answer","complex","question","generate","realistic","image","or","video","or","write","software code"],"unmatched_count":51,"match_length":27,"cut_length":78},{"key":"1","text_words":[["while","SCONJ","while"],["they","PRON",""],["have","VERB",""],["many","ADJ",""],["benefits","NOUN","benefit"],null,["advanced","ADJ",""],["generative","ADJ",""],["ai","PROPN",""],["systems","NOUN","system"],["also","ADV",""],["carry","VERB",""],["a","DET",""],["distinctly","ADV",""],["broad","ADJ",""],["risk","NOUN",""],["profile","NOUN",""],null,["due","ADP",""],["to","ADP",""],["the","DET",""],["broad","ADJ",""],["scope","NOUN",""],["of","ADP",""],["data","NOUN","datum"],["on","ADP",""],["which","PRON",""],["they","PRON",""],["are","AUX","be"],["trained","VERB","train"],null,["their","PRON",""],["wide","ADJ",""],["range","NOUN",""],["of","ADP",""],["potential","ADJ",""],["uses","NOUN","use"],null,["and","CCONJ",""],["the","DET",""],["scale","NOUN",""],["of","ADP",""],["their","PRON",""],["deployment","NOUN",""],null,["systems","NOUN","system"],["that","PRON",""],["are","AUX","be"],["made","VERB","make"],["publicly","ADV",""],["available","ADJ",""],["for","ADP",""],["a","DET",""],["range","NOUN",""],["of","ADP",""],["different","ADJ",""],["uses","NOUN","use"],["can","AUX",""],["present","VERB",""],["risks","NOUN","risk"],["to","ADP",""],["health","NOUN",""],["and","CCONJ",""],["safety","NOUN",""],null,["can","AUX",""],["propagate","VERB",""],["bias","NOUN",""],null,["and","CCONJ",""],["carry","VERB",""],["the","DET",""],["potential","NOUN",""],["for","ADP",""],["broader","ADJ","broad"],["societal","ADJ",""],["impacts","NOUN","impact"],null,["particularly","ADV",""],["when","SCONJ",""],["used","VERB","use"],["by","ADP",""],["malicious","ADJ",""],["actors","NOUN","actor"],null,["for","ADP","for"],["example","NOUN",""],null,["the","DET",""],["capability","NOUN",""],["to","PART",""],["generate","VERB",""],["realistic","ADJ",""],["images","NOUN","image"],["and","CCONJ",""],["video","NOUN",""],null,["or","CCONJ",""],["to","PART",""],["impersonate","VERB",""],["the","DET",""],["voices","NOUN","voice"],["of","ADP",""],["real","ADJ",""],["people","NOUN",""],null,["can","AUX",""],["enable","VERB",""],["deception","NOUN",""],["at","ADP",""],["a","DET",""],["scale","NOUN",""],["that","PRON",""],["can","AUX",""],["damage","VERB",""],["important","ADJ",""],["institutions","NOUN","institution"],null,["including","VERB","include"],["democratic","ADJ",""],["and","CCONJ",""],["criminal","ADJ",""],["justice","NOUN",""],["systems","NOUN","system"],null,["these","DET","these"],["systems","NOUN","system"],["may","AUX",""],["also","ADV",""],["have","VERB",""],["important","ADJ",""],["implications","NOUN","implication"],["for","ADP",""],["individual","ADJ",""],["privacy","NOUN",""],["rights","NOUN","right"],null,["as","SCONJ",""],["highlighted","VERB","highlight"],["in","ADP",""],["the","DET",""],["g7","PROPN",""],["data","PROPN",""],["protection","PROPN",""],["and","CCONJ",""],["privacy","PROPN",""],["authorities","PROPN",""],["'","PART",""],null,["statement","PROPN",""],["on","ADP",""],["generative","PROPN",""],["ai","PROPN",""],null],"text":"While they have many benefits, advanced generative AI systems also carry a distinctly broad risk profile, due to the broad scope of data on which they are trained, their wide range of potential uses, and the scale of their deployment.Systems that are made publicly available for a range of different uses can present risks to health and safety, can propagate bias, and carry the potential for broader societal impacts, particularly when used by malicious actors.For example, the capability to generate realistic images and video, or to impersonate the voices of real people, can enable deception at a scale that can damage important institutions, including democratic and criminal justice systems.These systems may also have important implications for individual privacy rights, as highlighted in the G7 Data Protection and Privacy Authorities' Statement on Generative AI.","idx":1,"match_words":["have","many","advanced","generative ai","system","also","a distinctly broad risk profile","the broad scope","datum","train","their wide range","potential","use","the scale","their deployment","system","make","available","a range","different","use","risk","safety","bias","the potential","broad","impact","use","malicious","example","the capability","generate","image","real people","a scale","important","include","system","system","also","have","important","individual","right","the g7 data protection","privacy authorities","generative"],"words":["while","they","have","many","benefit","advanced","generative ai","system","also","carry","a distinctly broad risk profile","due","to","the broad scope","of","datum","on","which","they","be","train","their wide range","of","potential","use","and","the scale","of","their deployment","system","that","be","make","publicly","available","for","a range","of","different","use","can","present","risk","to","health","and","safety","can","propagate","bias","and","carry","the potential","for","broad","societal","impact","particularly","when","use","by","malicious","actor","for","example","the capability","to","generate","realistic","image","and","video","or","to","impersonate","the","voice","of","real people","can","enable","deception","at","a scale","that","can","damage","important","institution","include","democratic","and","criminal","justice","system","these","system","may","also","have","important","implication","for","individual","privacy","right","as","highlight","in","the g7 data protection","and","privacy authorities","'","statement","on","generative","ai"],"unmatched_count":70,"match_length":47,"cut_length":117},{"key":"2","text_words":[["generative","ADJ","generative"],["systems","NOUN","system"],["can","AUX",""],["also","ADV",""],["be","AUX",""],["adapted","VERB","adapt"],["by","ADP",""],["organizations","NOUN","organization"],["for","ADP",""],["specific","ADJ",""],["uses","NOUN","use"],null,["–","PUNCT",""],["such","ADJ",""],["as","ADP",""],["corporate","ADJ",""],["knowledge","NOUN",""],["management","NOUN",""],["applications","NOUN","application"],["or","CCONJ",""],["customer","NOUN",""],["service","NOUN",""],["tools","NOUN","tool"],null,["–","PUNCT",""],["which","PRON",""],["generally","ADV",""],["present","VERB",""],["a","DET",""],["narrower","ADJ","narrow"],["range","NOUN",""],["of","ADP",""],["risks","NOUN","risk"],null,["even","ADV","even"],["so","ADV",""],null,["there","PRON",""],["are","VERB","be"],["a","DET",""],["number","NOUN",""],["of","ADP",""],["steps","NOUN","step"],["that","PRON",""],["need","VERB",""],["to","PART",""],["be","AUX",""],["taken","VERB","take"],["to","PART",""],["ensure","VERB",""],["that","SCONJ",""],["risks","NOUN","risk"],["are","AUX","be"],["appropriately","ADV",""],["identified","VERB","identify"],["and","CCONJ",""],["mitigated","VERB","mitigate"],null],"text":"Generative systems can also be adapted by organizations for specific uses – such as corporate knowledge management applications or customer service tools – which generally present a narrower range of risks.Even so, there are a number of steps that need to be taken to ensure that risks are appropriately identified and mitigated.","idx":2,"match_words":["generative","system","also","organization","specific","use","such","management","tool","range","risk","a number","step","need","take","ensure","risk","identify","mitigate"],"words":["generative","system","can","also","be","adapt","by","organization","for","specific","use","such","as","corporate","knowledge","management","application","or","customer","service","tool","which","generally","present","a","narrow","range","of","risk","even","so","there","be","a number","of","step","that","need","to","be","take","to","ensure","that","risk","be","appropriately","identify","and","mitigate"],"unmatched_count":31,"match_length":19,"cut_length":50},{"key":"3","text_words":[["to","PART","to"],["address","VERB",""],["and","CCONJ",""],["mitigate","VERB",""],["these","DET",""