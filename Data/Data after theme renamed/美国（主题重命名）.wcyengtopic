rtnership carried out under this section.The Secretary may not give any special consideration to any agency or entity in return for a donation.","idx":115,"match_words":["the secretary","request","provide","fund","other","federal","department","agency","state","united states territory","local","tribal","government","agency","private sector","entity","nonprofit","entity","available","the extent","provide","act","support","a research project","partnership","carry","this section","the secretary","give","any special consideration","any agency","entity","a donation"],"words":["the secretary","may","request","accept","and","provide","fund","from","other","federal","department","and","agency","state","united states territory","local","or","tribal","government","agency","private sector","for","profit","entity","and","nonprofit","entity","to","be","available","to","the extent","provide","by","appropriation","act","to","support","a research project","or","partnership","carry","out","under","this section","the secretary","may","not","give","any special consideration","to","any agency","or","entity","in","return","for","a donation"],"unmatched_count":25,"match_length":33,"cut_length":58},{"key":"116","text_words":[["in","ADP","in"],["carrying","VERB","carry"],["out","ADP",""],["the","DET",""],["activities","NOUN","activity"],["authorized","VERB","authorize"],["in","ADP",""],["this","DET",""],["section","NOUN",""],null,["the","DET",""],["secretary","PROPN",""],["shall","AUX",""],["collaborate","VERB",""],["with","ADP",""],["a","DET",""],["range","NOUN",""],["of","ADP",""],["stakeholders","NOUN","stakeholder"],["including","VERB","include"],["small","ADJ",""],["businesses","NOUN","business"],null,["institutes","NOUN","institute"],["of","ADP",""],["higher","ADJ","high"],["education","NOUN",""],null,["industry","NOUN",""],null,["and","CCONJ",""],["the","DET",""],["national","PROPN",""],["laboratories","PROPN",""],[";","PUNCT",""],["leverage","VERB",""],["the","DET",""],["collective