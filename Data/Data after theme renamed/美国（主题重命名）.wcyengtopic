 use grant funds provided under clause (i) for the purposes of recruiting new tenure-track or tenured faculty members that conduct research and teaching in artificial intelligence and related fields and research areas, including technology ethics; and paying salary and benefits for the academic year of newly recruited tenure-track or tenured faculty members for a duration of up to three years.","idx":95,"match_words":["an institution","high","education","use","grant","fund","provide","purpose","recruit","new","tenure","track","tenured","faculty","member","conduct","research","artificial intelligence","related","field","research","area","include","technology","ethic","benefit","the academic year","recruit","tenure","track","tenured","faculty","member","a duration","year"],"words":["an institution","of","high","education","shall","use","grant","fund","provide","under","clause","i","for","the","purpose","of","recruit","new","tenure","track","or","tenured","faculty","member","that","conduct","research","and","teaching","in","artificial intelligence","and","related","field","and","research","area","include","technology","ethic","and","pay","salary","and","benefit","for","the academic year","of","newly","recruit","tenure","track","or","tenured","faculty","member","for","a duration","of","up","to","year"],"unmatched_count":27,"match_length":35,"cut_length":62},{"key":"96","text_words":[["for","ADP","for"],["purposes","NOUN","purpose"],["of","ADP",""],["this","DET",""],["subparagraph","NOUN",""],null,["an","DET",""],["eligible","ADJ",""],["institution","NOUN",""],["of","ADP",""],["higher","ADJ","high"],["education","NOUN",""],["is","AUX","be"],["a","DET",""],["historically","PROPN",""],["black","PROPN",""],["college","PROPN",""],["and","CCONJ",""],["university","PROPN",""],null,["within","ADP",""],["the","DET",""],["meaning","NOUN",""],["of","ADP",""],["the","DET",""],["term","NOUN",""],["\"","PUNCT",""],["part","NOUN",""],["b","NOUN","b"],["institution","NOUN",""],["\"","P