nity (including the National Academies of Sciences, Engineering, and Medicine, scientific professional societies, and academic institutions),the defense and law enforcement communities, and other appropriate organizations."],["the members","the Advisory Committee","the Secretary","Commerce","consideration","recommendations","Congress","industry","nonprofit organizations","the scientific community","the National Academies","Sciences","Engineering","Medicine","scientific professional societies","academic institutions),the defense and law enforcement communities","other appropriate organizations"],[["In","ADP","in","",["prep","seek"]],["selecting","VERB","select","",["pcomp","in"]],["the","DET","","",["det","member"]],["members","NOUN","member","",["dobj","select"]],["of","ADP","","",["prep","member"]],["the","DET","","ORG",["det","Committee"]],["Advisory","PROPN","","ORG",["compound","Committee"]],["Committee","PROPN","","ORG",["pobj","of"]],"",["the","DET","","",["det","Secretary"]],["Secretary","PROPN","","",["nsubj","seek"]],["of","ADP","","",["prep","Secretary"]],["Commerce","PROPN","","ORG",["pobj","of"]],["shall","AUX","","",["aux","seek"]],["seek","VERB","","",["ROOT","seek"]],["and","CCONJ","","",["cc","seek"]],["give","VERB","","",["conj","seek"]],["consideration","NOUN","","",["dobj","give"]],["to","ADP","","",["dative","give"]],["recommendations","NOUN","recommendation","",["pobj","to"]],["from","ADP","","",["prep","recommendation"]],["Congress","PROPN","","ORG",["pobj","from"]],"",["industry","NOUN","","",["conj","Congress"]],"",["nonprofit","ADJ","","",["amod","organization"]],["organizations","NOUN","organization","",["conj","industry"]],"",["the","DET","","",["det","community"]],["scientific","ADJ","","",["amod","community"]],["community","NOUN","","",["conj","organization"]],"",["including","VERB","include","",["prep","community"]],["the","DET","","LAW",["det","Academies"]],["National","PROPN","","LAW",["compound","Academies"]],["Academies","PROPN","",