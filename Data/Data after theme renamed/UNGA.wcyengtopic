rights","NOUN","right"],["of","ADP",""],["the","DET",""],["child","NOUN",""],["in","ADP",""],["the","DET",""],["digital","ADJ",""],["space","NOUN",""],null,["in","ADP",""],["line","NOUN",""],["with","ADP",""],["international","ADJ",""],["human","ADJ",""],["rights","NOUN","right"],["law","NOUN",""],null,["including","VERB","include"],["the","DET",""],["convention","PROPN",""],["on","ADP",""],["the","DET",""],["rights","PROPN",""],["of","ADP",""],["the","DET",""],["child21","PROPN",""],null,["all","DET",""],["sdgs","NOUN","sdg"],null,[";","PUNCT",""],["refrain","VERB","refrain"],["from","ADP",""],["imposing","VERB","impose"],["restrictions","NOUN","restriction"],["on","ADP",""],["the","DET",""],["free","ADJ",""],["flow","NOUN",""],["of","ADP",""],["information","NOUN",""],["and","CCONJ",""],["ideas","NOUN","idea"],["that","PRON",""],["are","AUX","be"],["inconsistent","ADJ",""],["with","ADP",""],["obligations","NOUN","obligation"],["under","ADP",""],["international","ADJ",""],["law","NOUN",""],null,["all","DET",""],["sdgs","NOUN","sdg"],null,null],"text":"23.We commit to: Ensure that the development and implementation of national legislation relevant to digital technologies is compliant with obligations under international law, including international human rights law (all SDGs); Establish appropriate safeguards to prevent and address any adverse impact on human rights arising from the use of digital and emerging technologies and protect individuals against violations and abuses of their human rights in the digital space, including through human rights due diligence and establishing effective oversight and remedy mechanisms (all SDGs); Strengthen legal and policy frameworks to protect the rights of the child in the digital space, in line with international human rights law, including the Convention on the Rights of the Child21 (all SDGs);Refrain from imposing restrictions on the free flow of information and ideas that are inconsistent with obligations under international law (all SDGs).","idx":34,"match_words":["commit","ensure","the development","implementation","national legislation","relevant","digital","technology","international law","include","international","human","right","law","sdg","establish","safeguard","prevent","address","any adverse impact","human","right","the use","digital","emerge","technology","protect","individual","violation","abuse","human","right","the digital space","include","human","right","due diligence","establish","effective","oversight","mechanism","sdg","strengthen","legal","policy","framework","protect","right","the child","the digital space","line","international","human","right","law","include","the convention","the rights","the child21","sdg","the free flow","information","international law","sdg"],"words":["we","commit","to","ensure","that","the development","and","implementation","of","national legislation","relevant","to","digital","technology","be","compliant","with","obligation","under","international law","include","international","human","right","law","all","sdg","establish","appropriate","safeguard","to","prevent","and","address","any adverse impact","on","human","right","arise","from","the use","of","digital","and","emerge","technology","and","protect","individual","against","violation","and","abuse","of","their","human","right","in","the digital space","include","through","human","right","due diligence","and","establish","effective","oversight","and","remedy","mechanism","all","sdg","strengthen","legal","and","policy","framework","to","protect","the","right","of","the child","in","the digital space","in","line","with","international","human","right","law","include","the convention","on","the rights","of","the child21","all","sdg","refrain","from","impose","restriction","on","the free flow","of","information","and","idea","that","be","inconsistent","with","obligation","under","international law","all","sdg"],"unmatched_count":56,"match_length":64,"cut_length":120},{"key":"41","text_word