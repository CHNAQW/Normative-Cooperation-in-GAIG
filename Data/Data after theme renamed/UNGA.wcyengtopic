ct","relevant","datum","protection","and","privacy","safeguard","and","applicable","legal","framework","sdg"],"unmatched_count":23,"match_length":44,"cut_length":67},{"key":"72","text_words":[["47","NUM",""],null,["we","PRON","we"],["commit","VERB",""],null,["by","ADP",""],["2030","NUM",""],null,["to","PART",""],["advance","VERB",""],["consultations","NOUN","consultation"],["among","ADP",""],["all","DET",""],["relevant","ADJ",""],["stakeholders","NOUN","stakeholder"],["to","PART",""],["better","ADV","well"],["understand","VERB",""],["commonalities","NOUN","commonality"],null,["complementarities","NOUN","complementarity"],null,["convergence","NOUN",""],["and","CCONJ",""],["divergence","NOUN",""],["between","ADP",""],["regulatory","ADJ",""],["approaches","NOUN","approach"],["on","ADP",""],["how","SCONJ",""],["to","PART",""],["facilitate","VERB",""],["cross","ADJ",""],null,["border","ADJ",""],["data","NOUN","datum"],["flows","VERB","flow"],["with","ADP",""],["trust","NOUN",""],["so","SCONJ",""],["as","SCONJ",""],["to","PART",""],["develop","VERB",""],["publicly","ADV",""],["available","ADJ",""],["knowledge","NOUN",""],["and","CCONJ",""],["best","ADJ","good"],["practices","NOUN","practice"],null,["sdg","PROPN",""],["17","NUM",""],null,null],"text":"47.We commit, by 2030, to advance consultations among all relevant stakeholders to better understand commonalities, complementarities, convergence and divergence between regulatory approaches on how to facilitate cross-border data flows with trust so as to develop publicly available knowledge and best practices (SDG 17).","idx":64,"match_words":["commit","advance","consultation","relevant","stakeholder","well","regulatory","approach","facilitate","cross","border","datum","flow","trust","develop","publicly available knowledge","good","practice","sdg"],"words":["we","commit","by","to","advance","consultation","among","all","relevant","stakeholder","to","well","understand","commonality","complementarity","convergence","and","div