NOUN",""],null,["sdg","PROPN",""],["8)","NUM",""],[";","PUNCT",""],["develop","VERB","develop"],["interoperable","ADJ",""],["digital","ADJ",""],["competency","NOUN",""],["frameworks","NOUN","framework"],["and","CCONJ",""],["training","NOUN",""],["standards","NOUN","standard"],["to","AUX",""],["facilitate","VERB",""],["pooling","NOUN",""],["of","ADP",""],["training","NOUN",""],["resources","NOUN","resource"],null,["the","DET",""],["mobilization","NOUN",""],["of","ADP",""],["public","ADJ",""],["and","CCONJ",""],["private","ADJ",""],["funds","NOUN","fund"],["in","ADP",""],["support","NOUN",""],["of","ADP",""],["capacity","NOUN",""],null,["building","NOUN",""],["and","CCONJ",""],["its","PRON",""],["continuous","ADJ",""],["adaptation","NOUN",""],["to","PART",""],["address","VERB",""],["rapid","ADJ",""],["technological","ADJ",""],["change","NOUN",""],["and","CCONJ",""],["the","DET",""],["prevention","NOUN",""],["of","ADP",""],["brain","NOUN",""],["drain","NOUN",""],null,["sdgs","PROPN",""],["4","NUM",""],["and","CCONJ",""],["17","NUM",""],null,[";","PUNCT",""],["support","NOUN","support"],["efforts","NOUN","effort"],["to","PART",""],["provide","VERB",""],["opportunities","NOUN","opportunity"],["for","ADP",""],["quality","NOUN",""],["and","CCONJ",""],["inclusive","ADJ",""],["science","NOUN",""],null,["technology","NOUN",""],null,["engineering","NOUN",""],["and","CCONJ",""],["mathematics","NOUN","mathematic"],["education","NOUN",""],["and","CCONJ",""],["research","NOUN",""],["and","CCONJ",""],["promote","VERB",""],["women","NOUN","woman"],["'s","PART",""],["and","CCONJ",""],["girls","NOUN","girl"],["'","PART",""],["participation","NOUN",""],["in","ADP",""],["all","DET",""],["roles","NOUN","role"],["and","CCONJ",""],["at","ADP",""],["all","DET",""],["levels","NOUN","level"],null,["sdg","NOUN","sdg"],["4","NUM",""],null,null],"text":"13.We commit, by 2030, to: Establish and support national digital skills strategies, adapt teacher training and education curricula and provide for adult training programmes for the digital age.Our aim is maximum coverage of basic digital skills for as many as possible, while also advancing intermediate or advanced digital skills (SDGs 4 and 5); Increase the availability, accessibility and affordability of digital technology platforms, services, software and educational curricula in diverse languages and formats, as well as accessible user interfaces for persons with disabilities (SDGs 4 and 10); Target and tailor capacity-building for women and girls, children and youth, as well as older persons, persons with disabilities, migrants, refugees and internally displaced persons, Indigenous Peoples and those in vulnerable situations, and ensure their meaningful engagement in the design and implementation of programmes (SDGs 5 and 10); Develop and undertake national digital inclusion surveys with data disaggregated by income, sex, age, race, ethnicity, migration status, disability and geographical location and other characteristics relevant in national contexts, to identify learning gaps and inform priorities in specific contexts (SDGs 5 and 10); Prioritize and set targets for the development of digital competencies of public officials and institutions to enact, develop and implement strategies and policies for inclusive, secure and user-centred digital public services, including the development of skills and capacity to ensure the safe, secure and resilient functioning of digital systems, networks and data (SDG 16);Develop vocational, upskilling and reskilling training for workers in occupations impacted by digitalization and automation to mitigate potential negative consequences for workforces and promote decent work (SDG 8); Develop interoperable digital competency frameworks and training standards to facilitate pooling of training resources, the mobilization of public and private funds in support of capacity-building and its continuous adaptation to address rapid technological change and the prevention of brain drain (SDGs 4 and 17); Support efforts to provide opportunities for quality and inclusive science, technology, engineering and mathematics education and research and promote women's and girls' participation in all roles and at all levels (SDG 4) .","idx":18,"match_words":["commit","establish","support","national","digital","skill","strategy","adapt","teacher training","education","provide","training","programme","the digital age","our aim","maximum coverage","digital","skill","also","advance","digital","skill","sdg","increase","the availability","accessibility","digital","technology","platform","service","software","educational curricula","diverse","language","well","accessible","user","person","disability","sdgs","target","capacity","building","woman","girl","child","youth","well","person","person","disability","person","indigenous peoples","vulnerable","situation","ensure","their meaningful engagement","the design","implementation","programme","sdg","develop","national","digital","inclusion","datum","disaggregate","income","age","migration status","disability","geographical location","other","relevant","national contexts","identify","gap","inform","priority","specific","context","sdgs","set","target","the development","digital","public","develop","implement","strategy","policy","inclusive","secure","user","centre","digital","public","service","include","the development","skill","capacity","ensure","safe","secure","resilient","functioning","digital","system","network","datum","sdg","develop","training","impact","digitalization","mitigate","potential","negative","promote","decent work","sdg","develop","interoperable","digital","framework","training","standard","facilitate","training","resource","the mobilization","public","private","fund","support","capacity","building","its continuous adaptation","address","rapid technological change","the prevention","brain drain","sdgs","support","effort","provide","opportunity","quality and inclusive science","technology","e