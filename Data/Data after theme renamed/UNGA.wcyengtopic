 development objectives, protect human rights, foster innovation and promote economic growth.The increasing collection, sharing and processing of data, including in artificial intelligence systems, may amplify risks in the absence of effective personal data protection and privacy norms.","idx":51,"match_words":["recognize","responsible and interoperable data governance","essential","advance","development","objective","protect","human","right","foster innovation","promote","economic growth","increase","collection","sharing","processing","datum","include","artificial","intelligence","system","amplify","risk","the absence","effective","datum","protection","privacy"],"words":["we","recognize","that","responsible and interoperable data governance","be","essential","to","advance","development","objective","protect","human","right","foster innovation","and","promote","economic growth","the","increase","collection","sharing","and","processing","of","datum","include","in","artificial","intelligence","system","may","amplify","risk","in","the absence","of","effective","personal","datum","protection","and","privacy","norm"],"unmatched_count":15,"match_length":28,"cut_length":43},{"key":"60","text_words":[["38","NUM",""],null,["we","PRON","we"],["recognize","VERB",""],["the","DET",""],["urgent","ADJ",""],["need","NOUN",""],["for","SCONJ",""],["strengthened","ADJ",""],["data","NOUN",""],["governance","NOUN",""],["cooperation","NOUN",""],["at","ADP",""],["all","DET",""],["levels","NOUN","level"],["with","ADP",""],["the","DET",""],["effective","ADJ",""],null,["equitable","ADJ",""],["and","CCONJ",""],["meaningful","ADJ",""],["participation","NOUN",""],["of","ADP",""],["all","DET",""],["countries","NOUN","country"],["and","CCONJ",""],["in","ADP",""],["consultation","NOUN",""],["with","ADP",""],["relevant","ADJ",""],["stakeholders","NOUN","stakeholder"],["to","PART",""],["unlock","VERB",""],["the","DET",""],["full","ADJ",""],["potential","NOUN",""],["of","ADP",""],["digital","ADJ",""]