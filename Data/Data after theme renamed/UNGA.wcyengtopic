ta governance.","idx":52,"match_words":["recognize","the urgent need","strengthened data governance cooperation","level","effective","equitable","meaningful","participation","country","consultation","relevant","stakeholder","unlock","the full potential","digital","emerge","technology","recognize","require","capacity","building","develop","country","the development","implementation","data","governance","framework","level","benefit","datum","use","protect","privacy","secure","datum","call","the united nations system","a role","promote","capacity","building","responsible and interoperable data governance"],"words":["we","recognize","the urgent need","for","strengthened data governance cooperation","at","all","level","with","the","effective","equitable","and","meaningful","participation","of","all","country","and","in","consultation","with","relevant","stakeholder","to","unlock","the full potential","of","digital","and","emerge","technology","we","recognize","that","this","will","require","capacity","building","for","develop","country","and","the development","and","implementation","of","data","governance","framework","at","all","level","that","maximize","the","benefit","of","datum","use","while","protect","privacy","and","secure","datum","we","call","on","the united nations system","to","play","a role","in","promote","capacity","building","for","responsible and interoperable data governance"],"unmatched_count":37,"match_length":43,"cut_length":80},{"key":"61","text_words":[["39","NUM",""],null,["we","PRON","we"],["commit","VERB",""],null,["by","ADP",""],["2030","NUM",""],null,["to","ADP",""],[":","PUNCT",""],["draw","VERB","draw"],["on","ADP",""],["existing","VERB","exist"],["international","ADJ",""],["and","CCONJ",""],["regional","ADJ",""],["guidelines","NOUN","guideline"],["on","ADP",""],["the","DET",""],["protection","NOUN",""],["of","ADP",""],["privacy","NOUN",""],["in","ADP",""],["the","DET",""],["development","NOUN",""],["of","ADP",""],["data","NOUN",""],["govern