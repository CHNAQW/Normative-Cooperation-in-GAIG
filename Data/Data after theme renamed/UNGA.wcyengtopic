"the internet","build","on","the giga initiative","of","the international telecommunication union","and","the","united","nations","children","'s","fund","and","enhance","telemedicine","service","and","capability","sdgs","and","promote","sustainability","across","the life cycle","of","digital","technology","include","context","specific","measure","to","increase","resource efficiency","and","to","conserve","and","sustainably","use","natural","resource","and","that","aim","to","ensure","that","digital infrastructure","and","equipment","be","sustainably","design","to","address","environmental","challenge","in","the context","of","sustainable development","and","effort","to","eradicate","poverty","sdgs","and","include","the","need","of","people","in","vulnerable","situation","and","those","in","underserved","rural","and","remote","area","in","the development","and","implementation","of","national","and","local","digital","connectivity","strategy","sdgs","and","mainstream","a gender perspective","in","digital","connectivity","strategy","to","address","structural","and","systematic","barrier","to","meaningful","safe","and","affordable","digital","connectivity","for","all","woman","and","girl","sdg"],"unmatched_count":149,"match_length":129,"cut_length":278},{"key":"22","text_words":[["digital","ADJ","digital"],["literacy","NOUN",""],null,["skills","NOUN","skill"],["and","CCONJ",""],["capacities","NOUN","capacity"]],"text":"Digital literacy, skills and capacities","idx":16,"match_words":["digital literacy","skill","capacity"],"words":["digital literacy","skill","and","capacity"],"unmatched_count":1,"match_length":3,"cut_length":4},{"key":"23","text_words":[["12","NUM",""],null,["to","PART","to"],["fully","ADV",""],["harness","VERB",""],["the","DET",""],["benefits","NOUN","benefit"],["of","ADP",""],["digital","ADJ",""],["connectivity","NOUN",""],null,["we","PRON",""],["must","AUX",""],["ensure","VERB",""],["that","SCONJ",""],["people","NOUN",""],["can","AUX",""],["meaningful