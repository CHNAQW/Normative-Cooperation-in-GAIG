"w":"address"}]],"texts":[{"key":"1","text_words":[["1","X",""],null,["digital","ADJ","digital"],["technologies","NOUN","technology"],["are","AUX","be"],["dramatically","ADV",""],["transforming","VERB","transform"],["our","PRON",""],["world","NOUN",""],null,["they","PRON","they"],["offer","VERB",""],["immense","ADJ",""],["potential","ADJ",""],["benefits","NOUN","benefit"],["for","ADP",""],["the","DET",""],["well","NOUN",""],null,["being","NOUN",""],["and","CCONJ",""],["advancement","NOUN",""],["of","ADP",""],["people","NOUN",""],["and","CCONJ",""],["societies","NOUN","society"],["and","CCONJ",""],["for","ADP",""],["our","PRON",""],["planet","NOUN",""],null,["they","PRON","they"],["hold","VERB",""],["out","ADP",""],["the","DET",""],["promise","NOUN",""],["of","ADP",""],["accelerating","VERB","accelerate"],["the","DET",""],["achievement","NOUN",""],["of","ADP",""],["the","DET",""],["sustainable","PROPN",""],["development","PROPN",""],["goals","PROPN",""],null],"text":"1.Digital technologies are dramatically transforming our world.They offer immense potential benefits for the well-being and advancement of people and societies and for our planet.They hold out the promise of accelerating the achievement of the Sustainable Development Goals.","idx":0,"match_words":["digital","technology","our world","potential","benefit","well","being","people","society","our planet","the promise","accelerate","the achievement","the sustainable development goals"],"words":["digital","technology","be","dramatically","transform","our world","they","offer","immense","potential","benefit","for","the","well","being","and","advancement","of","people","and","society","and","for","our planet","they","hold","out","the promise","of","accelerate","the achievement","of","the sustainable development goals"],"unmatched_count":19,"match_length":14,"cut_length":33},{"key":"2","text_words":[["2","X",""],null,["we","PRON","we"],["can","AUX",""],["only","ADV",""],["achieve","VERB",""],["this","PRON",""],["t