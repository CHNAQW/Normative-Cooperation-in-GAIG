n","the basis","of","biometric","datum","in","so","far","as","these","be","not","prohibit","under","this regulation","and","emotion","recognition","system","that","be","not","prohibit","under","this regulation","should","be","classify","as","high","risk","biometric","system","which","be","intend","to","be","use","solely","for","the purpose","of","enable","cybersecurity","and","personal","datum","protection","measure","should","not","be","consider","to","be","high","risk","ai","system"],"unmatched_count":102,"match_length":130,"cut_length":232},{"key":"54","text_words":[null,["55","NUM",""],null,["as","SCONJ","as"],["regards","VERB","regard"],["the","DET",""],["management","NOUN",""],["and","CCONJ",""],["operation","NOUN",""],["of","ADP",""],["critical","ADJ",""],["infrastructure","NOUN",""],null,["it","PRON",""],["is","AUX","be"],["appropriate","ADJ",""],["to","PART",""],["classify","VERB",""],["as","ADP",""],["high","ADJ",""],null,["risk","NOUN",""],["the","DET",""],["ai","PROPN",""],["systems","NOUN","system"],["intended","VERB","intend"],["to","PART",""],["be","AUX",""],["used","VERB","use"],["as","ADP",""],["safety","NOUN",""],["components","NOUN","component"],["in","ADP",""],["the","DET",""],["management","NOUN",""],["and","CCONJ",""],["operation","NOUN",""],["of","ADP",""],["critical","ADJ",""],["digital","ADJ",""],["infrastructure","NOUN",""],["as","SCONJ",""],["listed","VERB","list"],["in","ADP",""],["point","NOUN",""],null,["8)","NUM",""],["of","ADP",""],["the","DET",""],["annex","PROPN",""],["to","ADP",""],["directive","PROPN",""],null,["eu","PROPN",""],null,["2022/2557","NUM",""],null,["road","NOUN",""],["traffic","NOUN",""],["and","CCONJ",""],["the","DET",""],["supply","NOUN",""],["of","ADP",""],["water","NOUN",""],null,["gas","NOUN",""],null,["heating","NOUN",""],["and","CCONJ",""],["electricity","NOUN",""],null,["since","SCONJ",""],["their","PRON",""],["failure","NOUN",""],["or","CCONJ",""],["malfunctioning","NOUN",""],["may","AUX",""],["put","VERB",""