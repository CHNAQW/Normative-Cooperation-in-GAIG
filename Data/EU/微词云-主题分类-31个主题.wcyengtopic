rohibiting","VERB","prohibit"],["or","CCONJ",""],["restricting","VERB","restrict"],["access","NOUN",""],null,["company","NOUN","company"],["and","CCONJ",""],["factory","NOUN",""],["premises","NOUN","premise"],null,["as","ADV",""],["well","ADV",""],["as","ADP",""],["offices","NOUN","office"],["and","CCONJ",""],["workplaces","NOUN","workplace"],["that","PRON",""],["are","AUX","be"],["intended","VERB","intend"],["to","PART",""],["be","AUX",""],["accessed","VERB","access"],["only","ADV",""],["by","ADP",""],["relevant","ADJ",""],["employees","NOUN","employee"],["and","CCONJ",""],["service","NOUN",""],["providers","NOUN","provider"],null,["are","AUX","be"],["spaces","NOUN","space"],["that","PRON",""],["are","AUX","be"],["not","PART",""],["publicly","ADV",""],["accessible","ADJ",""],null,["publicly","ADV","publicly"],["accessible","ADJ",""],["spaces","NOUN","space"],["should","AUX",""],["not","PART",""],["include","VERB",""],["prisons","NOUN","prison"],["or","CCONJ",""],["border","NOUN",""],["control","NOUN",""],null,["some","DET","some"],["other","ADJ",""],["spaces","NOUN","space"],["may","AUX",""],["comprise","VERB",""],["both","PRON",""],["publicly","ADV",""],["accessible","ADJ",""],["and","CCONJ",""],["non","ADJ",""],null,["publicly","ADV",""],["accessible","ADJ",""],["spaces","NOUN","space"],null,["such","ADJ",""],["as","ADP",""],["the","DET",""],["hallway","NOUN",""],["of","ADP",""],["a","DET",""],null,["private","ADJ",""],["residential","ADJ",""],["building","NOUN",""],["necessary","ADJ",""],["to","PART",""],["access","VERB",""],["a","DET",""],null,["doctor","NOUN",""],null,["office","NOUN",""],["or","CCONJ",""],["an","DET",""],["airport","NOUN",""],null,["online","ADJ","online"],["spaces","NOUN","space"],["are","AUX","be"],["not","PART",""],["covered","VERB","cover"],null,["as","SCONJ",""],["they","PRON",""],["are","AUX","be"],["not","PART",""],["physical","ADJ",""],["spaces","NOUN","space"],null,["whether","SCONJ","whether"],["a","DET",""],null,["given","VERB","give"],["space","NOUN",""],["is","AUX","be"],["accessible","ADJ",""],["to","ADP",""],["the","DET",""],["public","NOUN",""],["should","AUX",""],["however","ADV",""],["be","AUX",""],["determined","VERB","determine"],["on","ADP",""],["a","DET",""],null,["case","NOUN",""],null,["by","ADP",""],null,["case","NOUN",""],["basis","NOUN",""],null,["having","AUX",""],["regard","NOUN",""],["to","ADP",""],["the","DET",""],["specificities","NOUN","specificity"],["of","ADP",""],["the","DET",""],["individual","ADJ",""],["situation","NOUN",""],["at","ADP",""],["hand","NOUN",""],null],"text":"(19) For the purposes of this Regulation the notion of ‘publicly accessible space’ should be understood as referring to any physical space that is accessible to an undetermined number of natural persons, and irrespective of whether the space in question is privately or publicly owned, irrespective of the activity for which the space may be used, such as for commerce, for example, shops, restaurants, cafés; for services, for example, banks, professional activities, hospitality; for sport, for example, swimming pools, gyms, stadiums; for transport, for example, bus, metro and railway stations, airports, means of transport; for entertainment, for example, cinemas, theatres, museums, concert and conference halls; or for leisure or otherwise, for example, public roads and squares, parks, forests, playgrounds.A space should also be classified as being publicly accessible if, regardless of potential capacity or security restrictions, access is subject to certain predetermined conditions which can be fulfilled by an undetermined number of persons, such as the purchase of a ticket or title of transport, prior registration or having a certain age.In contrast, a space should not be considered to be publicly accessible if access is limited to specific and defined natural persons through either Union or national law directly related to public safety or security or through the clear manifestation of will by the person having the relevant authority over the space.The factual possibility of access alone, such as an unlocked door or an open gate in a fence, does not imply that the space is publicly accessible in the presence of indications or circumstances suggesting the contrary, such as.signs prohibiting or restricting access.Company and factory premises, as well as offices and workplaces that are intended to be accessed only by relevant employees and service providers, are spaces that are not publicly accessible.Publicly accessible spaces should not include prisons or border control.Some other spaces may comprise both publicly accessible and non-publicly accessible spaces, such as the hallway of a private residential building necessary to access a doctor’s office or an airport.Online spaces are not covered, as they are not physical spaces.Whether a given space is accessible to the public should however be determined on a case-by-case basis, having regard to the specificities of the individual situation at hand.","idx":18,"match_words":["purpose","this regulation","notion","publicly accessible space","understand","refer","any physical space","accessible","an undetermined number","natural","person","irrespective","the space","question","publicly","own","irrespective","the activity","the space","may","use","such","example","service","example","bank","professional","activity","example","pool","transport","example","mean","transport","example","otherwise","example","public","road","space","also","classify","publicly","accessible","regardless","potential capacity","security","restriction","access","subject","certain","condition","fulfil","an undetermined number","person","such","the purchase","title","transport","prior registration","have","certain","age","space","consider","publicly","accessible","access","limit","specific","define","natural","person","either union","national law","directly","relate","public safety","security","the clear manifestation","will","the person","hav