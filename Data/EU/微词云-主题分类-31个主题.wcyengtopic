rket surveillance authorities shall report annually to the Commission and relevant national competition authorities any information identified in the course of market surveillance activities that may be of potential interest for the application of Union law on competition rules.They shall also annually report to the Commission about the use of prohibited practices that occurred during that year and about the measures taken.","idx":728,"match_words":["part","reporting","obligation","article","regulation","market","surveillance","authority","report","the commission","relevant","national","competition","authority","any information","identify","the course","market","surveillance","activity","may","potential interest","the application","union law","competition","rule","also","report","the commission","the use","prohibit","practice","occur","that year","measure","take"],"words":["as","part","of","their","reporting","obligation","under","article","of","regulation","eu","the","market","surveillance","authority","shall","report","annually","to","the commission","and","relevant","national","competition","authority","any information","identify","in","the course","of","market","surveillance","activity","that","may","be","of","potential interest","for","the application","of","union law","on","competition","rule","they","shall","also","annually","report","to","the commission","about","the use","of","prohibit","practice","that","occur","during","that year","and","about","the","measure","take"],"unmatched_count":30,"match_length":36,"cut_length":66},{"key":"742","text_words":[["3","X",""],null,["for","ADP","for"],["high","ADJ",""],null,["risk","NOUN",""],["ai","PROPN",""],["systems","NOUN","system"],["related","VERB","relate"],["to","ADP",""],["products","NOUN","product"],["covered","VERB","cover"],["by","ADP",""],["the","DET",""],["union","PROPN",""],["harmonisation","NOUN",""],["legislation","NOUN",""],["listed","VERB","list"],["in","ADP",""],["section","PROPN",""],["a","PROPN","