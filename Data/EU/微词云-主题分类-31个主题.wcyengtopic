N",""],["ai","PROPN",""],["systems","NOUN","system"],["used","VERB","use"],["to","PART",""],["provide","VERB",""],["information","NOUN",""],["or","CCONJ",""],["recommendations","NOUN","recommendation"],["for","SCONJ",""],["decisions","NOUN","decision"],["to","PART",""],["be","AUX",""],["taken","VERB","take"],["by","ADP",""],["natural","ADJ",""],["persons","NOUN","person"],[";","PUNCT",""],["to","PART",""],["correctly","ADV",""],["interpret","VERB",""],["the","DET",""],["high","ADJ",""],null,["risk","NOUN",""],["ai","PROPN",""],["system","NOUN",""],null,["output","NOUN",""],null,["taking","VERB","take"],["into","ADP",""],["account","NOUN",""],null,["for","ADP",""],["example","NOUN",""],null,["the","DET",""],["interpretation","NOUN",""],["tools","NOUN","tool"],["and","CCONJ",""],["methods","NOUN","method"],["available","ADJ",""],[";","PUNCT",""],["to","PART",""],["decide","VERB",""],null,["in","ADP",""],["any","DET",""],["particular","ADJ",""],["situation","NOUN",""],null,["not","PART",""],["to","PART",""],["use","VERB",""],["the","DET",""],["high","ADJ",""],null,["risk","NOUN",""],["ai","PROPN",""],["system","NOUN",""],["or","CCONJ",""],["to","PART",""],["otherwise","ADV",""],["disregard","NOUN",""],null,["override","VERB",""],["or","CCONJ",""],["reverse","VERB",""],["the","DET",""],["output","NOUN",""],["of","ADP",""],["the","DET",""],["high","ADJ",""],null,["risk","NOUN",""],["ai","PROPN",""],["system","NOUN",""],[";","PUNCT",""],["to","PART",""],["intervene","VERB",""],["in","ADP",""],["the","DET",""],["operation","NOUN",""],["of","ADP",""],["the","DET",""],["high","ADJ",""],null,["risk","NOUN",""],["ai","PROPN",""],["system","NOUN",""],["or","CCONJ",""],["interrupt","VERB",""],["the","DET",""],["system","NOUN",""],["through","ADP",""],["a","DET",""],null,["‘","PUNCT","'"],["stop","VERB",""],["’","PUNCT","'"],["button","NOUN",""],["or","CCONJ",""],["a","DET",""],null,["similar","ADJ",""],["procedure","NOUN",""],["that","PRON",""],["allows","VERB","allow"],["the","DET",""],["system","NOUN",""],["to","PART",""],["come","VERB",""],["to","ADP",""],["a","DET",""],null,["halt","NOUN",""],["in","ADP",""],["a","DET",""],null,["safe","ADJ",""],["state","NOUN",""],null],"text":"4.For the purpose of implementing paragraphs 1, 2 and 3, the high-risk AI system shall be provided to the deployer in such a way that natural persons to whom human oversight is assigned are enabled, as appropriate and proportionate: to properly understand the relevant capacities and limitations of the high-risk AI system and be able to duly monitor its operation, including in view of detecting and addressing anomalies, dysfunctions and unexpected performance; to remain aware of the possible tendency of automatically relying or over-relying on the output produced by a high-risk AI system (automation bias), in particular for high-risk AI systems used to provide information or recommendations for decisions to be taken by natural persons; to correctly interpret the high-risk AI system’s output, taking into account, for example, the interpretation tools and methods available; to decide, in any particular situation, not to use the high-risk AI system or to otherwise disregard, override or reverse the output of the high-risk AI system; to intervene in the operation of the high-risk AI system or interrupt the system through a ‘stop’ button or a similar procedure that allows the system to come to a halt in a safe state.","idx":328,"match_words":["the purpose","implement","paragraph","high","risk","system","provide","the deployer","such","way","natural","person","human oversight","assign","enable","appropriate","proportionate","properly","understand","relevant","capacity","limitation","high","risk","system","able","duly","monitor","its operation","include","view","detect","address","anomaly","unexpected performance","remain","aware","the possible tendency","automatically","rely","over","rely","the output","produce","high","risk","system","automation bias","particular","h