e"],["a","DET",""],null,["high","ADJ",""],["level","NOUN",""],["of","ADP",""],["protection","NOUN",""],["of","ADP",""],["health","NOUN",""],null,["safety","NOUN",""],null,["fundamental","ADJ",""],["rights","NOUN","right"],["as","SCONJ",""],["enshrined","VERB","enshrine"],["in","ADP",""],["the","DET",""],["charter","PROPN",""],["of","ADP",""],["fundamental","PROPN",""],["rights","PROPN",""],["of","ADP",""],["the","DET",""],["european","PROPN",""],["union","PROPN",""],null,["the","DET",""],["‘","PUNCT","'"],["charter","PROPN",""],["’","PUNCT","'"],null,null,["including","VERB","include"],["democracy","NOUN",""],null,["the","DET",""],["rule","NOUN",""],["of","ADP",""],["law","NOUN",""],["and","CCONJ",""],["environmental","ADJ",""],["protection","NOUN",""],null,["to","PART",""],["protect","VERB",""],["against","ADP",""],["the","DET",""],["harmful","ADJ",""],["effects","NOUN","effect"],["of","ADP",""],["ai","PROPN",""],["systems","NOUN","system"],["in","ADP",""],["the","DET",""],["union","PROPN",""],null,["and","CCONJ",""],["to","PART",""],["support","VERB",""],["innovation","NOUN",""],null,["this","DET","this"],["regulation","PROPN",""],["ensures","VERB","ensure"],["the","DET",""],["free","ADJ",""],["movement","NOUN",""],null,["cross","ADJ",""],null,["border","NOUN",""],null,["of","ADP",""],["ai","PROPN",""],null,["based","VERB","base"],["goods","NOUN","good"],["and","CCONJ",""],["services","NOUN","service"],null,["thus","ADV",""],["preventing","VERB","prevent"],["member","PROPN",""],["states","PROPN",""],["from","ADP",""],["imposing","VERB","impose"],["restrictions","NOUN","restriction"],["on","ADP",""],["the","DET",""],["development","NOUN",""],null,["marketing","NOUN",""],["and","CCONJ",""],["use","NOUN",""],["of","ADP",""],["ai","PROPN",""],["systems","NOUN","system"],null,["unless","SCONJ",""],["explicitly","ADV",""],["authorised","VERB","authorise"],["by","ADP",""],["this","DET",""],null,["regulation","PROPN",""],null],"text":"(1) The purpose of this Regulation is to improve the functioning of the internal market by laying down a uniform legal framework in particular for the development, the placing on the market, the putting into service and the use of artificial intelligence systems (AI systems) in the Union, in accordance with Union values, to promote the uptake of human centric and trustworthy artificial intelligence (AI) while ensuring a high level of protection of health, safety, fundamental rights as enshrined in the Charter of Fundamental Rights of the European Union (the ‘Charter’), including democracy, the rule of law and environmental protection, to protect against the harmful effects of AI systems in the Union, and to support innovation.This Regulation ensures the free movement, cross-border, of AI-based goods and services, thus preventing Member States from imposing restrictions on the development, marketing and use of AI systems, unless explicitly authorised by this Regulation.","idx":0,"match_words":["the purpose","this regulation","improve","the functioning","the internal market","lay","down","uniform","legal","framework","particular","the development","placing","the market","putting","service","use","artificial","intelligence","system","system","the union","accordance","union","value","promote","the uptake","human centric","trustworthy artificial intelligence","ensure","high","level","protection","health","safety","fundamental","right","enshrine","the charter","fundamental rights","the european union","charter","include","democracy","the rule","law and environmental protection","protect","harmful","effect","system","the union","support","innovation","this regulation","ensure","the free movement","cross","border","base","good","service","thus","prevent","member states","impose","restriction","the development","marketing","use","system","explicitly","authorise","regulation"],"words":["the purpose","of","this regulation","be","to","improve","the functioning","of","the internal market","by","lay","down","a","uni