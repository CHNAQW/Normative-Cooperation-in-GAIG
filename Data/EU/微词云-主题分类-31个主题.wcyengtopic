d high-risk, the market surveillance authority shall carry out an evaluation of the AI system concerned in respect of its classification as a high-risk AI system based on the conditions set out in Article 6(3) and the Commission guidelines.","idx":777,"match_words":["market","surveillance","authority","have","sufficient reason","consider","an ai system","classify","the provider","non","high","risk","pursuant","article","6(3","high","risk","the market surveillance authority","carry","out","an evaluation","the ai system","concern","respect","its classification","high","risk","system","base","condition","set","out","article","commission","guideline"],"words":["where","a","market","surveillance","authority","have","sufficient reason","to","consider","that","an ai system","classify","by","the provider","as","non","high","risk","pursuant","to","article","6(3","be","indeed","high","risk","the market surveillance authority","shall","carry","out","an evaluation","of","the ai system","concern","in","respect","of","its classification","as","a","high","risk","ai","system","base","on","the","condition","set","out","in","article","and","the","commission","guideline"],"unmatched_count":21,"match_length":35,"cut_length":56},{"key":"792","text_words":[["2","X",""],null,["where","SCONJ","where"],null,["in","ADP",""],["the","DET",""],["course","NOUN",""],["of","ADP",""],["that","DET",""],["evaluation","NOUN",""],null,["the","DET",""],["market","NOUN",""],["surveillance","NOUN",""],["authority","NOUN",""],["finds","VERB","find"],["that","SCONJ",""],["the","DET",""],["ai","PROPN",""],["system","NOUN",""],["concerned","VERB","concern"],["is","AUX","be"],["high","ADJ",""],null,["risk","NOUN",""],null,["it","PRON",""],["shall","AUX",""],["without","ADP",""],["undue","ADJ",""],["delay","NOUN",""],["require","VERB",""],["the","DET",""],["relevant","ADJ",""],["provider","NOUN",""],["to","PART",""],["take","VERB",""],["all","DET",""],["necessary","ADJ",""],["actions","NOUN","action"],["to","PA