","PART",""],["apply","VERB",""],["to","ADP",""],["ai","PROPN",""],["systems","NOUN","system"],["authorised","VERB","authorise"],["by","ADP",""],["law","NOUN",""],["to","PART",""],["detect","VERB",""],null,["prevent","NOUN",""],null,["investigate","VERB",""],["or","CCONJ",""],["prosecute","VERB",""],["criminal","ADJ",""],["offences","NOUN","offence"],null,["subject","ADJ",""],["to","ADP",""],["appropriate","ADJ",""],["safeguards","NOUN","safeguard"],["for","ADP",""],["the","DET",""],["rights","NOUN","right"],["and","CCONJ",""],["freedoms","NOUN","freedom"],["of","ADP",""],["third","ADJ",""],["parties","NOUN","party"],null,["unless","SCONJ",""],["those","DET",""],["systems","NOUN","system"],["are","AUX","be"],["available","ADJ",""],["for","SCONJ",""],["the","DET",""],["public","NOUN",""],["to","PART",""],["report","VERB",""],["a","DET",""],null,["criminal","ADJ",""],["offence","NOUN",""],null],"text":"1. Providers shall ensure that AI systems intended to interact directly with natural persons are designed and developed in such a way that the natural persons concerned are informed that they are interacting with an AI system, unless this is obvious from the point of view of a natural person who is reasonably well-informed, observant and circumspect, taking into account the circumstances and the context of use.This obligation shall not apply to AI systems authorised by law to detect, prevent, investigate or prosecute criminal offences, subject to appropriate safeguards for the rights and freedoms of third parties, unless those systems are available for the public to report a criminal offence.","idx":551,"match_words":["provider","ensure","system","intend","interact","directly","natural","person","design","develop","such","way","natural","person","concern","inform","interact","an ai system","the point","view","natural","person","reasonably","well","inform","take","account","circumstance","the context","use","this obligation","apply","system","authorise","law","detect","p