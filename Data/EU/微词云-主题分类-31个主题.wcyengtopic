","discard"],["and","CCONJ",""],["deleted","VERB","delete"],null],"text":"3.For the purposes of paragraph 1, first subparagraph, point (h) and paragraph 2, each use for the purposes of law enforcement of a ‘real-time’ remote biometric identification system in publicly accessible spaces shall be subject to a prior authorisation granted by a judicial authority or an independent administrative authority whose decision is binding of the Member State in which the use is to take place, issued upon a reasoned request and in accordance with the detailed rules of national law referred to in paragraph 5.However, in a duly justified situation of urgency, the use of such system may be commenced without an authorisation provided that such authorisation is requested without undue delay, at the latest within 24 hours.If such authorisation is rejected, the use shall be stopped with immediate effect and all the data, as well as the results and outputs of that use shall be immediately discarded and deleted.","idx":270,"match_words":["purpose","paragraph","first","subparagraph","point","paragraph","each use","purpose","law enforcement","real","time","remote biometric identification system","publicly","accessible","space","subject","prior","authorisation","grant","judicial","authority","an independent administrative authority","whose decision","bind","the member state","the use","take","place","issue","reason","request","accordance","detailed","rule","national law","refer","paragraph","however","duly","justify","situation","urgency","the use","such system","may","commence","an authorisation","provide","such authorisation","request","undue delay","late","hour","such authorisation","reject","the use","stop","immediate effect","all","datum","well","result","output","that use","immediately","discard","delete"],"words":["for","the","purpose","of","paragraph","first","subparagraph","point","h","and","paragraph","each use","for","the","purpose","of","law enforcement","of","a","real","time","remote biometric identification system","in","publicly","accessible","space","shall","be","subject","to","a","prior","authorisation","grant","by","a","judicial","authority","or","an independent administrative authority","whose decision","be","bind","of","the member state","in","which","the use","be","to","take","place","issue","upon","a","reason","request","and","in","accordance","with","the","detailed","rule","of","national law","refer","to","in","paragraph","however","in","a","duly","justify","situation","of","urgency","the use","of","such system","may","be","commence","without","an authorisation","provide","that","such authorisation","be","request","without","undue delay","at","the","late","within","hour","if","such authorisation","be","reject","the use","shall","be","stop","with","immediate effect","and","all","the","datum","as","well","as","the","result","and","output","of","that use","shall","be","immediately","discard","and","delete"],"unmatched_count":60,"match_length":67,"cut_length":127},{"key":"272","text_words":[["the","DET","the"],["competent","ADJ",""],["judicial","ADJ",""],["authority","NOUN",""],["or","CCONJ",""],["an","DET",""],["independent","ADJ",""],["administrative","ADJ",""],["authority","NOUN",""],["whose","DET",""],["decision","NOUN",""],["is","AUX","be"],["binding","VERB","bind"],["shall","AUX",""],["grant","VERB",""],["the","DET",""],["authorisation","NOUN",""],["only","ADV",""],["where","SCONJ",""],["it","PRON",""],["is","AUX","be"],["satisfied","ADJ",""],null,["on","ADP",""],["the","DET",""],["basis","NOUN",""],["of","ADP",""],["objective","ADJ",""],["evidence","NOUN",""],["or","CCONJ",""],["clear","ADJ",""],["indications","NOUN","indication"],["presented","VERB","present"],["to","ADP",""],["it","PRON",""],null,["that","SCONJ",""],["the","DET",""],["use","NOUN",""],["of","ADP",""],["the","DET",""],["‘","PUNCT","'"],["real","ADJ",""],null,["time","NOUN",""],["’","PUNCT","'"],["remote","ADJ",""],["biometric","ADJ",""],["identification","NOUN",""],["system","NOUN",""],["concerned","VERB","concern"],["is","AUX","be"],["necessary","ADJ",""],["for","ADP",""],null,["and","CCONJ",""],["proportionate","VERB",""],["to","ADP",""],null,["achieving","VERB","achieve"],["one","NUM",""],["of","ADP",""],["the","DET",""],["objectives","NOUN","objective"],["specified","VERB","specify"],["in","ADP",""],["paragraph","NOUN",""],null,["1","NUM",""],null,["first","ADJ",""],["subparagraph","NOUN",""],null,["point","NOUN",""],null,["h","PROPN",""],null,null,["as","SCONJ",""],["identified","VERB","identify"],["in","ADP",""],["the","DET",""],["request","NOUN",""],["and","CCONJ",""],null,["in","ADP",""],["particular","ADJ",""],null,["remains","VERB","remain"],["limited","ADJ",""],["to","ADP",""],["what","PRON",""],["is","AUX","be"],["strictly","ADV",""],["necessary","ADJ",""],["concerning","VERB","concern"],["the","DET",""],["period","NOUN",""],["of","ADP",""],["time","NOUN",""],["as","ADV",""],["well","ADV",""],["as","ADP",""],["the","DET",""],["geographic","ADJ",""],["and","CCONJ",""],["personal","ADJ",""],["scope","NOUN",""],null,["in","ADP","in"],["deciding","VERB","decide"],["on","ADP",""],["the","DET",""],["request","NOUN",""],null,["that","DET",""],["authority","NOUN",""],["shall","AUX",""],["take","VERB",""],["into","ADP",""],["account","NOUN",""],["the","DET",""],["elements","NOUN","element"],["referred","VERB","refer"],["to","ADP",""],["in","ADP",""],["paragraph","NOUN",""],null,["2","NUM",""],null,["no","DET","no"],["decision","NOUN",""],["that","PRON",""],["produces","VERB","produce"],["an","DET",""],["adverse","ADJ",""],["legal","ADJ",""],["effect","NOUN",""],["on","ADP",""],["a","DET",""],null,["person","NOUN",""],["may","AUX",""],["be","AUX",""],["taken","VERB","take"],["based","VERB","base"],["solely","ADV",""],["on","ADP",""],["the","DET",""],["output","NOUN",""],["of","ADP",""],["the","DET",""],["‘","PUNCT","'"],["real","ADJ",""],null,["time","NOUN",""],["’","PUNCT","'"],["remote","ADJ",""],["biometric","ADJ",""],["identification","NOUN",""],["system","NOUN",""],null],"text":"The competent judicial authority or an independent administrative authority whose decision is binding shall grant the authorisation only where it is satisfied, on the basis of objective evidence or clear indications presented to it, that the use of the ‘real-time’ remote biometric identification system concerned is necessary for, and proportionate to, achieving one of the objectives specified in paragraph 1, first subparagraph, point (h), as identified in the request and, in particular, remains limited to what is strictly necessary concerning the period of time as well as the geographic and personal scope.In deciding on the request, that authority shall take into account the elements referred to in paragraph 2.No decision that produces an adverse legal effect on a person may be taken based solely on the output of the ‘real-time’ remote biometric identification system.","idx":271,"match_words":["the competent judicial authority","an independent administrative authority","whose decision","bind","grant","the authorisation","only","the basis","objective evidence","clear","indication","present","the use","real","time","remote","biometric","identification","system","concern","necessary","proportionate","achieve","objective","specify","paragraph","first","subparagraph","point","identify","the request","particular","remain","limited","strictly","necessary","concern","the period","time","well","the geographic and personal scope","decide","the request","that authority","take","account","element","refer","paragraph","no decision","produce","an adverse legal effect","person","may","take","base","solely","the output","real","time","remote","biometric","identification","system"],"words":["the competent judicial authority","or","an independent administrative authority","whose decision","be","bind","shall","grant","the authorisation","only","where","it","be","satisfied","on","the basis","of","objective evidence","or","clear","indication","present","to","it","that","the use","of","the","real","time","remote","biometric","identification","system","concern","be","necessary","for","and","proportionate","to","achieve","of","the","objective","specify","in","paragraph","first","subparagraph","point","h","as","identify","in","the request","and","in","particular","remain","limited","to","what","be","strictly","necessary","concern","the period","of","time","as","well","as","the geographic and personal scope","in","decide","on","the request","that authority","shall","take","into","account","the","element","refer","to","in","paragraph","no decision","that","produce","an adverse legal effect","on","a","person","may","be","take","base","solely","on","the output","of","the","real","time","remote","biometric","identification","system"],"unmatched_count":47,"match_length":64,"cut_length":111},{"key":"273","text_words":[["4","X",""],null,["without","ADP","without"],["prejudice","NOUN",""],["to","ADP",""],["paragraph","NOUN",""],null,["3","NUM",""],null,["each","DET",""],["use","NOUN",""],["of","ADP",""],["a","DET",""],null,["‘","PUNCT","'"],["real","ADJ",""],null,["time","NOUN",""],["’","PUNCT","'"],["remote","ADJ",""],["biometric","ADJ",""],["identification","NOUN",""],["system","NOUN",""],["in","ADP",""],["publicly","ADV",""],["accessible","ADJ",""],["spaces","NOUN","space"],["for","ADP",""],["law","NOUN",""],["enforcement","NOUN",""],["purposes","NOUN","purpose"],["shall","AUX",""],["be","AUX",""],["notified","VERB","notify"],["to","ADP",""],["the","DET",""],["relevant","ADJ",""],["market","NOUN",""],["surveillance","NOUN",""],["authority","NOUN",""],["and","CCONJ",""],["the","DET",""],["national","ADJ",""],["data","PROPN",""],["protection","NOUN",""],["authority","NOUN",""],["in","ADP",""],["accordance","NOUN",""],["with","ADP",""],["the","DET",""],["national","ADJ",""],["rules","NOUN","rule"],["referred","VERB","refer"],["to","ADP",""],["in","ADP",""],["paragraph","NOUN",""],null,["5","NUM",""],null,["the","DET","the"],["notification","NOUN",""],["shall","AUX",""],null,["as","ADP",""],["a","DET",""],null,["minimum","NOUN",""],null,["contain","VERB",""],["the","DET",""],["information","NOUN",""],["specified","VERB","specify"],["under","ADP",""],["paragraph","NOUN",""],null,["6","NUM",""],["and","CCONJ",""],["shall","AUX",""],["not","PART",""],["include","VERB",""],["sensitive","ADJ",""],["operational","ADJ",""],["data","NOUN","datum"],null],"text":"4.Without prejudice to paragraph 3, each use of a ‘real-time’ remote biometric identification system in publicly accessible spaces for law enforcement purposes shall be notified to the relevant market surveillance authority and the national data protection authority in accordance with the national rules referred to in paragraph 5.The notification shall, as a minimum, contain the information specified under paragraph 6 and shall not include sensitive operational data.","idx":272,"match_words":["prejudice","paragraph","each use","real","time","remote","biometric","identification","system","publicly","accessible","space","law","enforcement","purpose","notify","the relevant market surveillance authority","the national data protection authority","accordance","national","rule","refer","paragraph","the notification","minimum","contain","the information","specify","paragraph","include","sensitive","operational","datum"],"words":["without","prejudice","to","paragraph","each use","of","a","real","time","remote","biometric","identification","system","in","publicly","accessible","space","for","law","enforcement","purpose","shall","be","notify","to","the relevant market surveillance authority","and","the national data protection authority","in","accordance","with","the","national","rule","refer","to","in","paragraph","the notification","shall","as","a","minimum","contain","the information","specify","under","paragraph","and","shall","not","include","sensitive","operational","datum"],"unmatched_count":22,"match_length":3