e 71, they shall not use that system and shall inform the provider or the distributor.","idx":399,"match_words":["deployer","high","risk","system","public","authority","union","institution","body","office","agency","comply","registration","obligation","refer","article","such","deployer","find","high","risk","system","envisage","use","have","register","the eu database","refer","article","use","that system","inform","the provider","the distributor"],"words":["deployer","of","high","risk","ai","system","that","be","public","authority","or","union","institution","body","office","or","agency","shall","comply","with","the","registration","obligation","refer","to","in","article","when","such","deployer","find","that","the","high","risk","ai","system","that","they","envisage","use","have","not","be","register","in","the eu database","refer","to","in","article","they","shall","not","use","that system","and","shall","inform","the provider","or","the distributor"],"unmatched_count":28,"match_length":34,"cut_length":62},{"key":"405","text_words":[["9","X",""],null,["where","SCONJ","where"],["applicable","ADJ",""],null,["deployers","NOUN","deployer"],["of","ADP",""],["high","ADJ",""],null,["risk","NOUN",""],["ai","PROPN",""],["systems","NOUN","system"],["shall","AUX",""],["use","VERB",""],["the","DET",""],["information","NOUN",""],["provided","VERB","provide"],["under","ADP",""],["article","NOUN","article"],null,["13","NUM",""],["of","ADP",""],["this","DET",""],["regulation","PROPN",""],["to","PART",""],["comply","VERB",""],["with","ADP",""],["their","PRON",""],["obligation","NOUN",""],["to","PART",""],["carry","VERB",""],["out","ADP",""],["a","DET",""],null,["data","NOUN",""],["protection","NOUN",""],["impact","NOUN",""],["assessment","NOUN",""],["under","ADP",""],["article","NOUN","article"],null,["35","NUM",""],["of","ADP",""],["regulation","PROPN",""],null,["eu","PROPN",""],null,["2016/679","NUM",""],["or","CCONJ",""],["article","NOUN","article"],null,["27","NUM",""],["of","ADP",""],["directive","PROPN",""],null,["eu","PROPN",""],null,["2016/680","NOUN",""],null],"text":"9. Where applicable, deployers of high-risk AI systems shall use the information provided under Article 13 of this Regulation to comply with their obligation to carry out a data protection impact assessment under Article 35 of Regulation (EU) 2016/679 or Article 27 of Directive (EU) 2016/680.","idx":400,"match_words":["applicable","deployer","high","risk","system","use","the information","provide","article","this regulation","comply","their obligation","carry","out","data","protection","impact","assessment","article","regulation","article","directive","2016/680"],"words":["where","applicable","deployer","of","high","risk","ai","system","shall","use","the information","provide","under","article","of","this regulation","to","comply","with","their obligation","to","carry","out","a","data","protection","impact","assessment","under","article","of","regulation","eu","or","article","of","directive","eu","2016/680"],"unmatched_count":16,"match_length":23,"cut_length":39},{"key":"406","text_words":[["10","NUM",""],null,["without","ADP","without"],["prejudice","NOUN",""],["to","ADP",""],["directive","PROPN",""],null,["eu","PROPN",""],null,["2016/680","NOUN",""],null,["in","ADP",""],["the","DET",""],["framework","NOUN",""],["of","ADP",""],["an","DET",""],["investigation","NOUN",""],["for","ADP",""],["the","DET",""],["targeted","VERB","target"],["search","NOUN",""],["of","ADP",""],["a","DET",""],null,["person","NOUN",""],["suspected","VERB","suspect"],["or","CCONJ",""],["convicted","VERB","convict"],["of","ADP",""],["having","AUX",""],["committed","VERB","commit"],["a","DET",""],null,["criminal","ADJ",""],["offence","NOUN",""],null,["the","DET",""],["deployer","NOUN",""],["of","ADP",""],["a","DET",""],null,["high","ADJ",""],null,["risk","NOUN",""],["ai","PROPN",""],["system","NOUN",""],["for","ADP",""],["post","ADJ",""],null,["remote","ADJ",""],["biometric","ADJ",""],["identificat