should","be","take","on","the basis","of","an overall assessment","of","the","criterion","for","the designation","of","a","general","purpose","ai","model","with","systemic","risk","set","out","in","an annex","to","this regulation","such","as","quality","or","size","of","the","training","datum","set","number","of","business","and","end","user","its input","and","output","modality","its level","of","autonomy","and","scalability","or","the","tool","it","have","access","to","upon","a","reason","request","of","a","provider","whose model","have","be","designate","as","a","general","purpose","ai","model","with","systemic","risk","the commission","should","take","the request","into","account","and","may","decide","to","reassess","whether","the","general","purpose","ai","model","can","still","be","consider","to","present","systemic","risk"],"unmatched_count":201,"match_length":256,"cut_length":457},{"key":"111","text_words":[null,["112","NUM",""],null,["it","PRON","it"],["is","AUX","be"],["also","ADV",""],["necessary","ADJ",""],["to","PART",""],["clarify","VERB",""],["a","DET",""],null,["procedure","NOUN",""],["for","ADP",""],["the","DET",""],["classification","NOUN",""],["of","ADP",""],["a","DET",""],null,["general","ADJ",""],null,["purpose","NOUN",""],["ai","PROPN",""],["model","NOUN",""],["with","ADP",""],["systemic","ADJ",""],["risks","NOUN","risk"],null,["a","DET","a"],null,["general","ADJ",""],null,["purpose","NOUN",""],["ai","PROPN",""],["model","NOUN",""],["that","PRON",""],["meets","VERB","meet"],["the","DET",""],["applicable","ADJ",""],["threshold","NOUN",""],["for","ADP",""],["high","ADJ",""],null,["impact","NOUN",""],["capabilities","NOUN","capability"],["should","AUX",""],["be","AUX",""],["presumed","VERB","presume"],["to","PART",""],["be","AUX",""],["a","DET",""],null,["general","ADJ",""],null,["purpose","NOUN",""],["ai","PROPN",""],["models","NOUN","model"],["with","ADP",""],["systemic","ADJ",""],["risk","NOUN",""],null,["the","DET","the"],["provider","NOUN","