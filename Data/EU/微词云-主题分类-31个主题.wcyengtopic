"],null,["providers","NOUN","provider"],["and","CCONJ",""],["prospective","ADJ",""],["providers","NOUN","provider"],["in","ADP",""],["the","DET",""],["ai","PROPN",""],["regulatory","ADJ",""],["sandbox","NOUN",""],["should","AUX",""],["ensure","VERB",""],["appropriate","ADJ",""],["safeguards","NOUN","safeguard"],["and","CCONJ",""],["cooperate","VERB",""],["with","ADP",""],["the","DET",""],["competent","ADJ",""],["authorities","NOUN","authority"],null,["including","VERB","include"],["by","ADP",""],["following","VERB","follow"],["their","PRON",""],["guidance","NOUN",""],["and","CCONJ",""],["acting","VERB","act"],["expeditiously","ADV",""],["and","CCONJ",""],["in","ADP",""],["good","ADJ",""],["faith","NOUN",""],["to","PART",""],["adequately","ADV",""],["mitigate","VERB",""],["any","DET",""],["identified","VERB","identify"],["significant","ADJ",""],["risks","NOUN","risk"],["to","ADP",""],["safety","NOUN",""],null,["health","NOUN",""],null,["and","CCONJ",""],["fundamental","ADJ",""],["rights","NOUN","right"],["that","PRON",""],["may","AUX",""],["arise","VERB",""],["during","ADP",""],["the","DET",""],["development","NOUN",""],null,["testing","NOUN",""],["and","CCONJ",""],["experimentation","NOUN",""],["in","ADP",""],["that","DET",""],["sandbox","NOUN",""],null],"text":"(140) This Regulation should provide the legal basis for the providers and prospective providers in the AI regulatory sandbox to use personal data collected for other purposes for developing certain AI systems in the public interest within the AI regulatory sandbox, only under specified conditions, in accordance with Article 6(4) and Article 9(2), point (g), of Regulation (EU) 2016/679, and Articles 5, 6 and 10 of Regulation (EU) 2018/1725, and without prejudice to Article 4(2) and Article 10 of Directive (EU) 2016/680.All other obligations of data controllers and rights of data subjects under Regulations (EU) 2016/679 and (EU) 2018/1725 and Directive (EU) 2016/680 remain applicable.In particular, this Regulation should not provide a legal basis in the meaning of Article 22(2), point (b) of Regulation (EU) 2016/679 and Article 24(2), point (b) of Regulation (EU) 2018/1725.Providers and prospective providers in the AI regulatory sandbox should ensure appropriate safeguards and cooperate with the competent authorities, including by following their guidance and acting expeditiously and in good faith to adequately mitigate any identified significant risks to safety, health, and fundamental rights that may arise during the development, testing and experimentation in that sandbox.","idx":139,"match_words":["this regulation","provide","the legal basis","provider","prospective","provider","the ai regulatory sandbox","use","personal","datum","collect","other","purpose","develop","certain","system","the public interest","the ai regulatory sandbox","only","condition","accordance","article","article","9(2","point","regulation","2016/679","articles","regulation","prejudice","article","article","directive","2016/680","all","other","obligation","datum","controller","right","datum","subject","regulations","2016/679","directive","2016/680","remain","applicable","particular","this regulation","provide","legal","basis","the meaning","article","point","regulation","2016/679","article","point","regulation","provider","prospective","provider","the ai regulatory sandbox","ensure","appropriate","safeguard","cooperate","competent","authority","include","follow","their guidance","act","good faith","mitigate","identify","significant","risk","safety","health","fundamental","right","may","arise","the development","testing","experimentation","that sandbox"],"words":["this regulation","should","provide","the legal basis","for","the","provider","and","prospective","provider","in","the ai regulatory sandbox","to","use","personal","datum","collect","for","other","purpose","for","develop","certain","ai","system","in","the public interest","within","the ai regulatory sandbox","only","under","specified","