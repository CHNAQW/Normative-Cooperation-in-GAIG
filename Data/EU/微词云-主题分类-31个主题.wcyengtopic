,"",["conj","practice"]],""],"neg=0.021,neu=0.706,pos=0.12,compound=0.4311"],[["neg=0.0,neu=0.784,pos=0.216,compound=0.7906,span=(28) Aside from the many beneficial uses of AI, it can also be misused and provide novel and powerful tools for manipulative, exploitative and social control practices.","neg=0.091,neu=0.739,pos=0.171,compound=0.7128,span=Such practices are particularly harmful and abusive and should be prohibited because they contradict Union values of respect for human dignity, freedom, equality, democracy and the rule of law and fundamental rights enshrined in the Charter, including the right to non-discrimination, to data protection and to privacy and the rights of the child."],["the many beneficial uses","AI","it","novel","powerful tools","manipulative, exploitative and social control practices","Such practices","they","Union values","respect","human dignity","freedom","equality","democracy","the rule","law","fundamental rights","the Charter","the right","-","discrimination","data protection","privacy","the rights","the child"],["",["28","NUM","","CARDINAL",["meta","misuse"]],"",["Aside","ADV","aside","",["advmod","misuse"]],["from","ADP","","",["prep","aside"]],["the","DET","","",["det","use"]],["many","ADJ","","",["amod","use"]],["beneficial","ADJ","","",["amod","use"],[1.9,""]],["uses","NOUN","use","",["pobj","from"]],["of","ADP","","",["prep","use"]],["AI","PROPN","","ORG",["pobj","of"]],"",["it","PRON","","",["nsubjpass","misuse"]],["can","AUX","","",["aux","misuse"]],["also","ADV","","",["advmod","misuse"]],["be","AUX","","",["auxpass","misuse"]],["misused","VERB","misuse","",["ROOT","misuse"]],["and","CCONJ","","",["cc","misuse"]],["provide","VERB","","",["conj","misuse"]],["novel","NOUN","","",["dobj","provide"],[1.3,""]],["and","CCONJ","","",["cc","novel"]],["powerful","ADJ","","",["amod","tool"],[1.8,""]],["tools","NOUN","tool","",["conj","novel"]],["for","ADP","","",["prep","provide"]],["manipulative","ADJ","","",["amod","practice"]],"",["exploitative","ADJ","","",["conj","manipulative"]],["and","CCONJ","","",["cc","exploitative"]],["social","ADJ","","",["conj","exploitative"]],["control","NOUN","","",["conj","exploitative"]],["practices","NOUN","practice","",["pobj","for"]],"",["Such","ADJ","such","",["amod","practice"]],["practices","NOUN","practice","",["nsubj","be"]],["are","AUX","be","",["ROOT","be"]],["particularly","ADV","","",["advmod","harmful"]],["harmful","ADJ","","",["acomp","be"]],["and","CCONJ","","",["cc","harmful"]],["abusive","ADJ","","",["conj","harmful"],[-3.4637000000000002,"particularly harmful and abusive"]],["and","CCONJ","","",["cc","be"]],["should","AUX","","",["aux","prohibit"]],["be","AUX","","",["auxpass","prohibit"]],["prohibited","VERB","prohibit","",["conj","be"]],["because","SCONJ","","",["mark","contradict"]],["they","PRON","","",["nsubj","contradict"]],["contradict","VERB","","",["advcl","prohibit"],[-1.3,""]],["Union","PROPN","","",["compound","value"]],["values","NOUN","value","",["dobj","contradict"],[1.7,""]],["of","ADP","","",["prep","value"]],["respect","NOUN","","",["pobj","of"],[2.1,""]],["for","ADP","","",["prep","respect"]],["human","ADJ","","",["amod","dignity"]],["dignity","NOUN","","",["pobj","for"],[1.7,""]],"",["freedom","NOUN","","",["conj","dignity"],[3.2,""]],"",["equality","NOUN","","",["conj","freedom"]],"",["democracy","NOUN","","",["conj","equality"]],["and","CCONJ","","",["cc","democracy"]],["the","DET","","",["det","rule"]],["rule","NOUN","","",["conj","democracy"]],["of","ADP","","",["prep","rule"]],["law","NOUN","","",["pobj","of"]],["and","CCONJ","","",["cc","law"]],["fundamental","ADJ","","",["amod","right"]],["rights","NOUN","right","",["conj","law"]],["enshrined","VERB","enshrine","",["acl","rule"]],["in","ADP","","",["prep","enshrine"]],["the","DET","","",["det","Charter"]],["Charter","PROPN","","",["pobj","in"]],"",["including","VERB","include","",["prep","value"]],["the","DET","","",["det","right"]],["right","NOUN","","",["pobj","include"]],["to","ADP","","",["prep","right"]],["non","ADJ","","",["pobj","to"]],"",["discrimination","NOUN","","",["pobj","to"]],"",["to","ADP","","",["prep","right"]],["data","NOUN","","",["compound","protection"]],["protection","NOUN","","",["pobj","to"]],["and","CCONJ","","",["cc","to"]],["to","ADP","","",["conj","to"]],["privacy","NOUN","","",["pobj","to"]],["and","CCONJ","","",["cc","privacy"]],["the","DET","","",["det","right"]],["rights","NOUN","right","",["conj","privacy"]],["of","ADP","","",["prep","right"]],["the","DET","","",["det","child"]],["child","NOUN","","",["pobj","of"]],""],"neg=0.045,neu=0.761,pos=0.193,compound=0.7517"],[["neg=0.086,neu=0.807,pos=0.107,compound=0.2732,span=(29) AI-enabled manipulative techniques can be used to persuade persons to engage in unwanted behaviours, or to deceive them by nudging them into decisions in a way that subverts and impairs their autonomy, decision-making and free choices.","neg=0.151,neu=0.744,pos=0.104,compound=-0.6697,span=The placing on the market, the putting into service or the use of certain AI systems with the objective to or the effect of materially distorting human behaviour, whereby significant harms, in particular having sufficiently important adverse impacts on physical, psychological health or financial interests are likely to occur, are particularly dangerous and should therefore be prohibited.","neg=0.034,neu=0.928,pos=0.038,compound=0.1027,span=Such AI systems deploy subliminal components such as audio, image, video stimuli that persons cannot perceive, as those stimuli are beyond human perception, or other manipulative or deceptive techniques that subvert or impair person’s autonomy, decision-making or free choice in ways that people are not consciously aware of those techniques or, where they are aware of them, can still be deceived or are not able to control or resist them.","neg=0.045,neu=0.918,pos=0.037,compound=-0.1027,span=This could be facilitated, for example, by machine-brain interfaces or virtual reality as they allow for a higher degree of control of what stimuli are presented to persons, insofar as they may materially distort their behaviour in a significantly harmful manner.","neg=0.104,neu=0.896,pos=0.0,compound=-0.7774,span=In addition, AI systems may also otherwise exploit the vulnerabilities of a person or a specific group of persons due to their age, disability within the meaning of Directive (EU) 2019/882 of the European Parliament and of the Council , or a specific social or economic situation that is likely to make those persons more vulnerable to exploitation such as persons living in extreme poverty, ethnic or religious minorities.","neg=0.115,neu=0.862,pos=0.023,compound=-0.7906,span=Such AI systems can be placed on the market, put into service or used with the objective to or the effect of materially distorting the behaviour of a person and in a manner that causes or is reasonably likely to cause significant harm to that or another person or groups of persons, including harms that may be accumulated over time and should therefore be prohibited.","neg=0.036,neu=0.964,pos=0.0,compound=-0.3182,span=It may not be possible to assume that there is an intention to distort behaviour where the distortion results from factors external to the AI system which are outside the control of the provider or the deployer, namely factors that may not be reasonably foreseeable and therefore not possible for the provider or the deployer of the AI system to mitigate.","neg=0.16,neu=0.799,pos=0.041,compound=-0.7351,span=In any case, it is not necessary for the provider or the deployer to have the intention to cause significant harm, provided that such harm results from the manipulative or exploitative AI-enabled practices.","neg=0.098,neu=0.902,pos=0.0,compound=-0.743,span=The prohibitions for such AI practices are complementary to the provisions contained in Directive 2005/29/EC of the European Parliament and of the Council , in particular unfair commercial practices leading to economic or financial harms to consumers are prohibited under all circumstances, irrespective of whether they are put in place through AI systems or otherwise.","neg=0.0,neu=0.946,pos=0.054,compound=0.34,span=The prohibitions of manipulative and exploitative practices in this Regulation should not affect lawful practices in the context of medical treatment such as psychological treatment of a mental disease or physical rehabilitation, when those practices are carried out in accordance with the applicable law and medical standards, for example explicit consent of the individuals or their legal representatives.","neg=0.0,neu=0.0,pos=0.0,compound=0.0,span=In addition, common and legitimate commercial practices, for example in the field of advertising, that comply with the applicable law should not, in themselves, be regarded as constituting harmful manipulative AI-enabled practices."],["(29) AI-enabled manipulative techniques","persons","unwanted behaviours","them","them","decisions","a way","that","their autonomy","decision-making and free choices","The placing","the market","the putting","service","the use","certain AI systems","the objective","the effect","materially distorting human behaviour","significant harms","sufficiently important adverse impacts","physical, psychological health","financial interests","Such AI systems","subliminal components","image","video stimuli","persons","those stimuli","human perception","other manipulative or deceptive techniques","that","ways","people","those techniques","they","them","them","This","example","machine-brain interfaces","virtual reality","they","a higher degree","control","what","stimuli","persons","they","their behaviour","a significantly harmful manner","addition","AI systems","the vulnerabilities","a person","a specific group","persons","their age","disability","the meaning","Directive","EU","the European Parliament","the Council","a specific social or economic situation","that","those person