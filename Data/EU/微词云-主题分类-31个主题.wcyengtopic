","NOUN",""],["of","ADP",""],["market","NOUN",""],["surveillance","NOUN",""],["authorities","NOUN","authority"],null,["at","ADP",""],["their","PRON",""],["request","NOUN",""],[";","PUNCT",""],["supporting","VERB","support"],["cross","ADJ",""],null,["border","ADJ",""],["market","NOUN",""],["surveillance","NOUN",""],["activities","NOUN","activity"],["as","SCONJ",""],["referred","VERB","refer"],["to","ADP",""],["in","ADP",""],["article","PROPN",""],null,["74(11","NUM",""],null,null,["without","ADP",""],["prejudice","NOUN",""],["to","ADP",""],["the","DET",""],["powers","NOUN","power"],["of","ADP",""],["market","NOUN",""],["surveillance","NOUN",""],["authorities","NOUN","authority"],[";","PUNCT",""],["supporting","VERB","support"],["the","DET",""],["ai","PROPN",""],["office","PROPN",""],["in","ADP",""],["carrying","VERB","carry"],["out","ADP",""],["its","PRON",""],["duties","NOUN","duty"],["in","ADP",""],["the","DET",""],["context","NOUN",""],["of","ADP",""],["the","DET",""],["union","PROPN",""],["safeguard","NOUN",""],["procedure","NOUN",""],["pursuant","NOUN",""],["to","ADP",""],["article","NOUN","article"],null,["81","NUM",""],null],"text":"3. The scientific panel shall advise and support the AI Office, in particular with regard to the following tasks: supporting the implementation and enforcement of this Regulation as regards general-purpose AI models and systems, in particular by: alerting the AI Office of possible systemic risks at Union level of general-purpose AI models, in accordance with Article 90; contributing to the development of tools and methodologies for evaluating capabilities of general-purpose AI models and systems, including through benchmarks; providing advice on the classification of general-purpose AI models with systemic risk; providing advice on the classification of various general-purpose AI models and systems; contributing to the development of tools and templates; supporting the work of market surveillance authorities, at their request; supporting cross-border market surveillance activities as referred to in Article 74(11), without prejudice to the powers of market surveillance authorities; supporting the AI Office in carrying out its duties in the context of the Union safeguard procedure pursuant to Article 81.","idx":682,"match_words":["the scientific panel","advise","support","the ai office","particular","regard","follow","task","support","the implementation","enforcement","this regulation","regard","general","purpose","model","system","particular","alert","the ai office","possible","systemic risk","union level","general","purpose","model","accordance","article","contribute","the development","tool","methodology","evaluate","capability","general","purpose","model","system","include","benchmark","provide","advice","the classification","general","purpose","model","systemic","risk","provide","advice","the classification","various","general","purpose","model","system","contribute","the development","tool","template","support","the work","market","surveillance","authority","their request","support","cross","border","market","surveillance","activity","refer","article","prejudice","power","market","surveillance","authority","support","the ai office","carry","out","duty","the context","the union safeguard procedure pursuant","article"],"words":["the scientific panel","shall","advise","and","support","the ai office","in","particular","with","regard","to","the","follow","task","support","the implementation","and","enforcement","of","this regulation","as","regard","general","purpose","ai","model","and","system","in","particular","by","alert","the ai office","of","possible","systemic risk","at","union level","of","general","purpose","ai","model","in","accordance","with","article","contribute","to","the development","of","tool","and","methodology","for","evaluate","capability","of","general","purpose","ai","model","and","system","include","through","benchmark","provide","advice","on","the classification","of","g