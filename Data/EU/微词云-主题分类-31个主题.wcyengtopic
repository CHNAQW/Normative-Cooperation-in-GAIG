stem to be fulfilled in this simplified manner by microenterprises.","idx":145,"match_words":["moreover","light","the very small size","operator","order","ensure","proportionality","regard","cost","innovation","appropriate","allow","microenterprise","fulfil","most","obligation","namely","establish","quality","management","system","simplify","manner","reduce","the administrative burden","cost","enterprise","affect","the level","protection","the need","compliance","requirement","high","risk","system","the commission","develop","guideline","specify","element","the quality management system","fulfil","this simplified manner","microenterprise"],"words":["moreover","in","light","of","the very small size","of","some","operator","and","in","order","to","ensure","proportionality","regard","cost","of","innovation","it","be","appropriate","to","allow","microenterprise","to","fulfil","of","the","most","costly","obligation","namely","to","establish","a","quality","management","system","in","a","simplify","manner","which","would","reduce","the administrative burden","and","the","cost","for","those","enterprise","without","affect","the level","of","protection","and","the need","for","compliance","with","the","requirement","for","high","risk","ai","system","the commission","should","develop","guideline","to","specify","the","element","of","the quality management system","to","be","fulfil","in","this simplified manner","by","microenterprise"],"unmatched_count":41,"match_length":45,"cut_length":86},{"key":"146","text_words":[null,["147","NUM",""],null,["it","PRON","it"],["is","AUX","be"],["appropriate","ADJ",""],["that","SCONJ",""],["the","DET",""],["commission","PROPN",""],["facilitates","VERB","facilitate"],null,["to","ADP",""],["the","DET",""],["extent","NOUN",""],["possible","ADJ",""],null,["access","NOUN",""],["to","ADP",""],["testing","NOUN",""],["and","CCONJ",""],["experimentation","NOUN",""],["facilities","NOUN","facility"],["to","ADP",""],["bodies","NOUN","body"],null,["grou