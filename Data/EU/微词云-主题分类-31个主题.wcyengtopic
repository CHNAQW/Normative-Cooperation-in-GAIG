historical","ADJ",""],["patterns","NOUN","pattern"],["of","ADP",""],["discrimination","NOUN",""],null,["for","ADP",""],["example","NOUN",""],["against","ADP",""],["women","NOUN","woman"],null,["certain","ADJ",""],["age","NOUN",""],["groups","NOUN","group"],null,["persons","NOUN","person"],["with","ADP",""],["disabilities","NOUN","disability"],null,["or","CCONJ",""],["persons","NOUN","person"],["of","ADP",""],["certain","ADJ",""],["racial","ADJ",""],["or","CCONJ",""],["ethnic","ADJ",""],["origins","NOUN","origin"],["or","CCONJ",""],["sexual","ADJ",""],["orientation","NOUN",""],null,["ai","PROPN",""],["systems","NOUN","system"],["used","VERB","use"],["to","PART",""],["monitor","VERB",""],["the","DET",""],["performance","NOUN",""],["and","CCONJ",""],["behaviour","NOUN",""],["of","ADP",""],["such","ADJ",""],["persons","NOUN","person"],["may","AUX",""],["also","ADV",""],["undermine","VERB",""],["their","PRON",""],["fundamental","ADJ",""],["rights","NOUN","right"],["to","ADP",""],["data","NOUN",""],["protection","NOUN",""],["and","CCONJ",""],["privacy","NOUN",""],null],"text":"(57) AI systems used in employment, workers management and access to self-employment, in particular for the recruitment and selection of persons, for making decisions affecting terms of the work-related relationship, promotion and termination of work-related contractual relationships, for allocating tasks on the basis of individual behaviour, personal traits or characteristics and for monitoring or evaluation of persons in work-related contractual relationships, should also be classified as high-risk, since those systems may have an appreciable impact on future career prospects, livelihoods of those persons and workers’ rights.Relevant work-related contractual relationships should, in a meaningful manner, involve employees and persons providing services through platforms as referred to in the Commission Work Programme 2021.Throughout the recruitment process and in the evaluation, promotion, or retention of persons in work-related contractual relationships, such systems may perpetuate historical patterns of discrimination, for example against women, certain age groups, persons with disabilities, or persons of certain racial or ethnic origins or sexual orientation.AI systems used to monitor the performance and behaviour of such persons may also undermine their fundamental rights to data protection and privacy.","idx":56,"match_words":["system","use","employment","worker","management","access","self","employment","particular","the recruitment","selection","person","make","decision","affect","term","work","relate","relationship","promotion","termination","work","relate","contractual","relationship","allocate","task","the basis","individual behaviour","personal","trait","characteristic","monitoring","evaluation","person","work","relate","contractual","relationship","also","classify","high","risk","system","may","have","an appreciable impact","future","livelihood","person","worker","right","relevant","work","relate","contractual","relationship","meaningful","manner","involve","person","provide","service","platform","refer","the commission work programme","the recruitment process","the evaluation","promotion","retention","person","work","relate","contractual","relationship","such","system","may","perpetuate","historical","pattern","discrimination","example","certain","age","group","person","disability","person","certain","racial","ethnic","origin","sexual orientation","system","use","monitor","the performance","behaviour","such","person","may","also","undermine","fundamental","right","data protection","privacy"],"words":["ai","system","use","in","employment","worker","management","and","access","to","self","employment","in","particular","for","the recruitment","and","selection","of","person","for","make","decision","affect","term","of","the","work","relate","relationship","promotion","and","termination","of","work","relate","contractual","relationship","for","allocat