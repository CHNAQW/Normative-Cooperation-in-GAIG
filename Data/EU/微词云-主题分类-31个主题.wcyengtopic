to","ADP",""],["the","DET",""],["obligation","NOUN",""],["in","ADP",""],["article","PROPN",""],null,["16(6","NUM",""],null,["of","ADP",""],["regulation","PROPN",""],null,["eu","PROPN",""],null,null,["2022/2065","NUM",""],["for","ADP",""],["providers","NOUN","provider"],["of","ADP",""],["hosting","VERB","host"],["services","NOUN","service"],["to","PART",""],["process","VERB",""],["notices","NOUN","notice"],["on","ADP",""],["illegal","ADJ",""],["content","NOUN",""],["received","VERB","receive"],["pursuant","NOUN",""],["to","ADP",""],["article","NOUN","article"],null,["16(1","NUM",""],null,["of","ADP",""],["that","DET",""],["regulation","PROPN",""],["and","CCONJ",""],["should","AUX",""],["not","PART",""],["influence","VERB",""],["the","DET",""],["assessment","NOUN",""],["and","CCONJ",""],["the","DET",""],["decision","NOUN",""],["on","ADP",""],["the","DET",""],["illegality","NOUN",""],["of","ADP",""],["the","DET",""],["specific","ADJ",""],["content","NOUN",""],null,["that","DET","that"],["assessment","NOUN",""],["should","AUX",""],["be","AUX",""],["performed","VERB","perform"],["solely","ADV",""],["with","ADP",""],["reference","NOUN",""],["to","ADP",""],["the","DET",""],["rules","NOUN","rule"],["governing","VERB","govern"],["the","DET",""],["legality","NOUN",""],["of","ADP",""],["the","DET",""],["content","NOUN",""],null],"text":"(136) The obligations placed on providers and deployers of certain AI systems in this Regulation to enable the detection and disclosure that the outputs of those systems are artificially generated or manipulated are particularly relevant to facilitate the effective implementation of Regulation (EU) 2022/2065.This applies in particular as regards the obligations of providers of very large online platforms or very large online search engines to identify and mitigate systemic risks that may arise from the dissemination of content that has been artificially generated or manipulated, in particular the risk of the actual or foreseeable negative effects on democratic processes, civic discourse and electoral processes, including through disinformation.The requirement to label content generated by AI systems under this Regulation is without prejudice to the obligation in Article 16(6) of Regulation (EU) 2022/2065 for providers of hosting services to process notices on illegal content received pursuant to Article 16(1) of that Regulation and should not influence the assessment and the decision on the illegality of the specific content.That assessment should be performed solely with reference to the rules governing the legality of the content.","idx":135,"match_words":["the obligation","place","provider","deployer","certain","system","this regulation","enable","the detection","disclosure","output","system","artificially","generate","manipulate","particularly","relevant","facilitate","the effective implementation","regulation","apply","particular","regard","obligation","provider","very","large","online","platform","very","large","online","search","engine","identify","mitigate","systemic","risk","may","arise","the dissemination","content","have","artificially","generate","manipulate","in particular the risk","actual","foreseeable","negative","effect","democratic","process","civic discourse","process","include","disinformation","the requirement","label content","generate","system","this regulation","prejudice","obligation","article","regulation","provider","service","process","notice","illegal content","receive","pursuant","article","that regulation","influence","the assessment","decision","the illegality","the specific content","that assessment","perform","solely","reference","rule","govern","the legality","the content"],"words":["the obligation","place","on","provider","and","deployer","of","certain","ai","system","in","this regulation","to","enable","the detection","and","disclosure","that","the","output","of","those","system","be","artificially","generate","or","manipulate","be","particularly","relevant","to","facilitate","the effective implementation","of","regulation","eu","this","apply","in","particular","as","regard","the","obligation","of","provider","of","very","large","online","platform","or","very","large","online","search","engine","to","identify","and","mitigate","systemic","risk","that","may","arise","from","the dissemination","of","content","that","have","be","artificially","generate","or","manipulate","in particular the risk","of","the","actual","or","foreseeable","negative","effect","on","democratic","process","civic discourse","and","electoral","process","include","through","disinformation","the requirement","to","label content","generate","by","ai","system","under","this regulation","be","without","prejudice","to","the","obligation","in","article","of","regulation","eu","for","provider","of","host","service","to","process","notice","on","illegal content","receive","pursuant","to","article","of","that regulation","and","should","not","influence","the assessment","and","the","decision","on","the illegality","of","the specific content","that assessment","should","be","perform","solely","with","reference","to","the","rule","govern","the legality","of","the content"],"unmatched_count":70,"match_length":88,"cut_length":158},{"key":"136","text_words":[null,["137","NUM",""],null,["compliance","NOUN","compliance"],["with","ADP",""],["the","DET",""],["transparency","NOUN",""],["obligations","NOUN","obligation"],["for","ADP",""],["the","DET",""],["ai","PROPN",""],["systems","NOUN","system"],["covered","VERB","cover"],["by","ADP",""],["this","DET",""],["regulation","PROPN",""],["should","AUX",""],["not","PART",""],["be","AUX",""],["interpreted","VERB","interpret"],["as","ADP",""],["indicating","VERB","indicate"],["that","SCONJ",""],["the","DET",""],["use","NOUN",""],["of","ADP",""],["the","DET",""],["ai","PROPN",""],["system","NOUN",""],["or","CCONJ",""],["its","PRON",""],["output","NOUN",""],["is","AUX","be"],["lawful","ADJ",""],["under","ADP",""],["this","DET",""],["reg