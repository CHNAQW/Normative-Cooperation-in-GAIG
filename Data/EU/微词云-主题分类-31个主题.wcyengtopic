RB","use"],["to","PART",""],["provide","VERB",""],["online","ADJ",""],["search","NOUN",""],["engines","NOUN","engine"],null,["in","ADP",""],["particular","ADJ",""],null,["to","ADP",""],["the","DET",""],["extent","NOUN",""],["that","SCONJ",""],["an","DET",""],["ai","PROPN",""],["system","NOUN",""],["such","ADJ",""],["as","ADP",""],["an","DET",""],["online","ADJ",""],["chatbot","NOUN",""],["performs","VERB","perform"],["searches","NOUN","search"],["of","ADP",""],null,["in","ADP",""],["principle","NOUN",""],null,["all","DET",""],["websites","NOUN","website"],null,["then","ADV",""],["incorporates","VERB","incorporate"],["the","DET",""],["results","NOUN","result"],["into","ADP",""],["its","PRON",""],["existing","VERB","exist"],["knowledge","NOUN",""],["and","CCONJ",""],["uses","VERB","use"],["the","DET",""],["updated","VERB","update"],["knowledge","NOUN",""],["to","PART",""],["generate","VERB",""],["a","DET",""],null,["single","ADJ",""],["output","NOUN",""],["that","PRON",""],["combines","VERB","combine"],["different","ADJ",""],["sources","NOUN","source"],["of","ADP",""],["information","NOUN",""],null],"text":"(119) Considering the quick pace of innovation and the technological evolution of digital services in scope of different instruments of Union law in particular having in mind the usage and the perception of their recipients, the AI systems subject to this Regulation may be provided as intermediary services or parts thereof within the meaning of Regulation (EU) 2022/2065, which should be interpreted in a technology-neutral manner.For example, AI systems may be used to provide online search engines, in particular, to the extent that an AI system such as an online chatbot performs searches of, in principle, all websites, then incorporates the results into its existing knowledge and uses the updated knowledge to generate a single output that combines different sources of information.","idx":118,"match_words":["consider","the quick pace","innovation","the technological evolution","digital","service","scope","different","instrument","union law","particular","have","the usage","the perception","system","subject","this regulation","may","provide","intermediary","service","part","thereof","the meaning","regulation","interpret","technology","manner","example","system","may","use","provide","online","search","engine","particular","the extent","an ai system","such","an online chatbot","perform","search","principle","all","incorporate","result","exist","knowledge","use","update","knowledge","generate","single","output","combine","different","source","information"],"words":["consider","the quick pace","of","innovation","and","the technological evolution","of","digital","service","in","scope","of","different","instrument","of","union law","in","particular","have","in","mind","the usage","and","the perception","of","their","recipient","the","ai","system","subject","to","this regulation","may","be","provide","as","intermediary","service","or","part","thereof","within","the meaning","of","regulation","eu","which","should","be","interpret","in","a","technology","neutral","manner","for","example","ai","system","may","be","use","to","provide","online","search","engine","in","particular","to","the extent","that","an ai system","such","as","an online chatbot","perform","search","of","in","principle","all","website","then","incorporate","the","result","into","its","exist","knowledge","and","use","the","update","knowledge","to","generate","a","single","output","that","combine","different","source","of","information"],"unmatched_count":49,"match_length":59,"cut_length":108},{"key":"119","text_words":[null,["120","NUM",""],null,["furthermore","ADV","furthermore"],null,["obligations","NOUN","obligation"],["placed","VERB","place"],["on","ADP",""],["providers","NOUN","provider"],["and","CCONJ",""],["deployers","NOUN","deployer"],["of","ADP",""],["certain","ADJ",""],["ai","PROPN",""],["systems","NOUN","system"],["in","ADP",""],["this","DET",""],["regulatio