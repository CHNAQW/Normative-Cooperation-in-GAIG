UN",""],["of","ADP",""],["the","DET",""],["relevant","ADJ",""],["systems","NOUN","system"],null],"text":"3. Codes of conduct may be drawn up by individual providers or deployers of AI systems or by organisations representing them or by both, including with the involvement of any interested stakeholders and their representative organisations, including civil society organisations and academia.Codes of conduct may cover one or more AI systems taking into account the similarity of the intended purpose of the relevant systems.","idx":842,"match_words":["code","conduct","may","draw","individual","provider","deployer","system","organisation","represent","include","the involvement","interested","stakeholder","representative","organisation","include","civil","society","organisation","academia","code","conduct","may","cover","more","system","take","account","the similarity","intend","purpose","relevant","system"],"words":["code","of","conduct","may","be","draw","up","by","individual","provider","or","deployer","of","ai","system","or","by","organisation","represent","they","or","by","both","include","with","the involvement","of","any","interested","stakeholder","and","their","representative","organisation","include","civil","society","organisation","and","academia","code","of","conduct","may","cover","or","more","ai","system","take","into","account","the similarity","of","the","intend","purpose","of","the","relevant","system"],"unmatched_count":27,"match_length":34,"cut_length":61},{"key":"858","text_words":[["4","X",""],null,["the","DET","the"],["ai","PROPN",""],["office","PROPN",""],["and","CCONJ",""],["the","DET",""],["member","PROPN",""],["states","PROPN",""],["shall","AUX",""],["take","VERB",""],["into","ADP",""],["account","NOUN",""],["the","DET",""],["specific","ADJ",""],["interests","NOUN","interest"],["and","CCONJ",""],["needs","NOUN","need"],["of","ADP",""],["smes","NOUN","sme"],null,["including","VERB","include"],["start","NOUN",""],null,["ups","NOUN","up"],null,["