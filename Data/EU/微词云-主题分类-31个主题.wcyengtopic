nsibility for the publication of the content.","idx":555,"match_words":["deployer","an ai system","generate","manipulate","text","publish","the purpose","inform","the public","matter","public interest","disclose","the text","have","artificially","generate","manipulate","this obligation","apply","the use","authorise","law","detect","prevent","investigate","prosecute","criminal","offence","generate","content","have","undergo","process","human review","editorial control","natural","legal","person","hold","editorial responsibility","the publication","the content"],"words":["deployer","of","an ai system","that","generate","or","manipulate","text","which","be","publish","with","the purpose","of","inform","the public","on","matter","of","public interest","shall","disclose","that","the text","have","be","artificially","generate","or","manipulate","this obligation","shall","not","apply","where","the use","be","authorise","by","law","to","detect","prevent","investigate","or","prosecute","criminal","offence","or","where","the","ai","generate","content","have","undergo","a","process","of","human review","or","editorial control","and","where","a","natural","or","legal","person","hold","editorial responsibility","for","the publication","of","the content"],"unmatched_count":33,"match_length":42,"cut_length":75},{"key":"566","text_words":[["5","X",""],null,["the","DET","the"],["information","NOUN",""],["referred","VERB","refer"],["to","ADP",""],["in","ADP",""],["paragraphs","NOUN","paragraph"],null,["1","NUM",""],["to","PART",""],["4","NUM",""],["shall","AUX",""],["be","AUX",""],["provided","VERB","provide"],["to","ADP",""],["the","DET",""],["natural","ADJ",""],["persons","NOUN","person"],["concerned","VERB","concern"],["in","ADP",""],["a","DET",""],null,["clear","ADJ",""],["and","CCONJ",""],["distinguishable","ADJ",""],["manner","NOUN",""],["at","ADP",""],["the","DET",""],["latest","ADJ","late"],["at","ADP",""],["the","DET",""],["time","NOUN",""],["of","ADP",""],["the","DET",""],[