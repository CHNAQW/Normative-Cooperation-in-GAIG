ils","NOUN","detail"],["of","ADP",""],["the","DET",""],["provider","NOUN",""],["that","PRON",""],["appointed","VERB","appoint"],["the","DET",""],["authorised","ADJ",""],["representative","NOUN",""],[";","PUNCT",""],["provide","VERB",""],["the","DET",""],["ai","PROPN",""],["office","PROPN",""],null,["upon","SCONJ",""],["a","DET",""],null,["reasoned","VERB","reason"],["request","NOUN",""],null,["with","ADP",""],["all","DET",""],["the","DET",""],["information","NOUN",""],["and","CCONJ",""],["documentation","NOUN",""],null,["including","VERB","include"],["that","PRON",""],["referred","VERB","refer"],["to","ADP",""],["in","ADP",""],["point","NOUN",""],null,["b","PROPN",""],null,null,["necessary","ADJ",""],["to","PART",""],["demonstrate","VERB",""],["compliance","NOUN",""],["with","ADP",""],["the","DET",""],["obligations","NOUN","obligation"],["in","ADP",""],["this","DET",""],["chapter","NOUN","chapter"],[";","PUNCT",""],["cooperate","VERB",""],["with","ADP",""],["the","DET",""],["ai","PROPN",""],["office","PROPN",""],["and","CCONJ",""],["competent","ADJ",""],["authorities","NOUN","authority"],null,["upon","SCONJ",""],["a","DET",""],null,["reasoned","VERB","reason"],["request","NOUN",""],null,["in","ADP",""],["any","DET",""],["action","NOUN",""],["they","PRON",""],["take","VERB",""],["in","ADP",""],["relation","NOUN",""],["to","ADP",""],["the","DET",""],["general","ADJ",""],null,["purpose","NOUN",""],["ai","PROPN",""],["model","NOUN",""],null,["including","VERB","include"],["when","SCONJ",""],["the","DET",""],["model","NOUN",""],["is","AUX","be"],["integrated","VERB","integrate"],["into","ADP",""],["ai","PROPN",""],["systems","NOUN","system"],["placed","VERB","place"],["on","ADP",""],["the","DET",""],["market","NOUN",""],["or","CCONJ",""],["put","VERB",""],["into","ADP",""],["service","NOUN",""],["in","ADP",""],["the","DET",""],null,["union","PROPN",""],null],"text":"3. The authorised representative shall perform the tasks specified in the mandate received from the provider.It shall provide a copy of the mandate to the AI Office upon request, in one of the official languages of the institutions of the Union.For the purposes of this Regulation, the mandate shall empower the authorised representative to carry out the following tasks: verify that the technical documentation specified in Annex XI has been drawn up and all obligations referred to in Article 53 and, where applicable, Article 55 have been fulfilled by the provider; keep a copy of the technical documentation specified in Annex XI at the disposal of the AI Office and national competent authorities, for a period of 10 years after the general-purpose AI model has been placed on the market, and the contact details of the provider that appointed the authorised representative; provide the AI Office, upon a reasoned request, with all the information and documentation, including that referred to in point (b), necessary to demonstrate compliance with the obligations in this Chapter; cooperate with the AI Office and competent authorities, upon a reasoned request, in any action they take in relation to the general-purpose AI model, including when the model is integrated into AI systems placed on the market or put into service in the Union.","idx":581,"match_words":["the authorised representative","perform","task","specify","the mandate","receive","the provider","provide","copy","the mandate","the ai office","request","official","language","institution","the union","purpose","this regulation","the mandate","empower","the authorised representative","carry","out","follow","task","verify","the technical documentation","specify","annex","have","draw","all","obligation","refer","article","applicable","article","have","fulfil","the provider","keep","copy","the technical documentation","specify","annex","the disposal","the ai office","national","competent","authority","period","year","general","purpose","model","have","place","the market","contact","detail","the provider","appoint","the autho