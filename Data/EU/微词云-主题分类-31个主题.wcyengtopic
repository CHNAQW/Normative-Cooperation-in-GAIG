as","well","as","the right","of","defence","and","the presumption","of","innocence","could","be","hamper","in","particular","where","such","ai","system","be","not","sufficiently","transparent","explainable","and","document","it","be","therefore","appropriate","to","classify","as","high","risk","insofar","as","their use","be","permit","under","relevant union","and","national law","a","number","of","ai","system","intend","to","be","use","in","the law enforcement context","where","accuracy","reliability","and","transparency","be","particularly","important","to","avoid","adverse","impact","retain","public trust","and","ensure","accountability and effective redress","in","view","of","the nature","of","the","activity","and","the risk","relate","thereto","those","high","risk","ai","system","should","include","in","particular","ai","system","intend","to","be","use","by","or","on","behalf","of","law","enforcement","authority","or","by","union","institution","body","office","or","agency","in","support","of","law","enforcement","authority","for","assess","the risk","of","a","natural","person","to","become","a","victim","of","criminal","offence","as","polygraphs","and","similar","tool","for","the evaluation","of","the reliability","of","evidence","in","in","the course","of","investigation","or","prosecution","of","criminal","offence","and","insofar","as","not","prohibit","under","this regulation","for","assess","the","risk","of","a","natural","person","offend","or","reoffende","not","solely","on","the basis","of","the profiling","of","natural","person","or","the assessment","of","personality","trait","and","characteristic","or","the past criminal behaviour","of","natural","person","or","group","for","profiling","in","the course","of","detection","investigation","or","prosecution","of","criminal","offence","ai","system","specifically","intend","to","be","use","for","administrative","proceeding","by","tax","and","custom","authority","as","well","as","by","financial","intelligence","unit","carry","out","administrative","task","analyse","information","pursuant","to","union","anti","money","laundering","law","should","not","be","classify","as","high","risk","ai","system","use","by","law","enforcement","authority","for","the purpose","of","prevention","detection","investigation","and","prosecution","of","criminal","offence","the use","of","ai","tool","by","law","enforcement","and","other","relevant","authority","should","not","become","a","factor","of","inequality","or","exclusion","the impact","of","the use","of","ai","tool","on","the","defence","right","of","suspect","should","not","be","ignore","in","particular","the","difficulty","in","obtain","meaningful information","on","the functioning","of","those","system","and","the","result","difficulty","in","challenge","their","result","in","court","in","particular","by","natural","person","under","investigation"],"unmatched_count":210,"match_length":241,"cut_length":451},{"key":"59","text_words":[null,["60","NUM",""],null,["ai","PROPN",""],["systems","NOUN","system"],["used","VERB","use"],["in","ADP",""],["migration","NOUN",""],null,["asylum","NOUN",""],["and","CCONJ",""],["border","NOUN",""],["control","NOUN",""],["management","NOUN",""],["affect","VERB",""],["persons","NOUN","person"],["who","PRON",""],["are","AUX","be"],["often","ADV",""],["in","ADP",""],["particularly","ADV",""],["vulnerable","ADJ",""],["position","NOUN",""],["and","CCONJ",""],["who","PRON",""],["are","AUX","be"],["dependent","ADJ",""],["on","ADP",""],["the","DET",""],["outcome","NOUN",""],["of","ADP",""],["the","DET",""],["actions","NOUN","action"],["of","ADP",""],["the","DET",""],["competent","ADJ",""],["public","ADJ",""],["authorities","NOUN","authority"],null,["the","DET","the"],["accuracy","NOUN",""],null,["non","ADJ",""],null,["discriminatory","ADJ",""],["nature","NOUN",""],["and","CCONJ",""],["transparency","NOUN",""],["of","ADP",""],["the","DET",""],["ai","PROPN",""],["systems","NOUN","system"],["used","VERB","use"],[