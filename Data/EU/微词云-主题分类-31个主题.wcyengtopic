nt","ADJ",""],["indicators","NOUN","indicator"],null],"text":"2. The specific interests and needs of the SME providers, including start-ups, shall be taken into account when setting the fees for conformity assessment under Article 43, reducing those fees proportionately to their size, market size and other relevant indicators.","idx":648,"match_words":["specific","interest","need","sme","provider","include","start","take","account","set","fee","conformity assessment","article","reduce","fee","their size","market size","other","relevant","indicator"],"words":["the","specific","interest","and","need","of","the","sme","provider","include","start","up","shall","be","take","into","account","when","set","the","fee","for","conformity assessment","under","article","reduce","those","fee","proportionately","to","their size","market size","and","other","relevant","indicator"],"unmatched_count":16,"match_length":20,"cut_length":36},{"key":"660","text_words":[["3","X",""],null,["the","DET","the"],["ai","PROPN",""],["office","PROPN",""],["shall","AUX",""],["undertake","VERB",""],["the","DET",""],["following","VERB","follow"],["actions","NOUN","action"],[":","PUNCT",""],["provide","VERB",""],["standardised","ADJ",""],["templates","NOUN","template"],["for","ADP",""],["areas","NOUN","area"],["covered","VERB","cover"],["by","ADP",""],["this","DET",""],["regulation","PROPN",""],null,["as","SCONJ",""],["specified","VERB","specify"],["by","ADP",""],["the","DET",""],["board","PROPN",""],["in","ADP",""],["its","PRON",""],["request","NOUN",""],[";","PUNCT",""],["develop","VERB",""],["and","CCONJ",""],["maintain","VERB",""],["a","DET",""],null,["single","ADJ",""],["information","NOUN",""],["platform","NOUN",""],["providing","VERB","provide"],["easy","ADV",""],["to","PART",""],["use","VERB",""],["information","NOUN",""],["in","ADP",""],["relation","NOUN",""],["to","ADP",""],["this","DET",""],["regulation","PROPN",""],["for","ADP",""],["all","DET",""],["operators","NOUN","operator"],["across"