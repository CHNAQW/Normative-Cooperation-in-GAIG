","NOUN",""],["for","ADP",""],["those","DET",""],["systems","NOUN","system"],["so","SCONJ",""],["that","SCONJ",""],["no","DET",""],["action","NOUN",""],["or","CCONJ",""],["decision","NOUN",""],["may","AUX",""],["be","AUX",""],["taken","VERB","take"],["by","ADP",""],["the","DET",""],["deployer","NOUN",""],["on","ADP",""],["the","DET",""],["basis","NOUN",""],["of","ADP",""],["the","DET",""],["identification","NOUN",""],["resulting","VERB","result"],["from","ADP",""],["the","DET",""],["system","NOUN",""],["unless","SCONJ",""],["this","PRON",""],["has","AUX","have"],["been","AUX","be"],["separately","ADV",""],["verified","VERB","verify"],["and","CCONJ",""],["confirmed","VERB","confirm"],["by","ADP",""],["at","ADV",""],["least","ADV",""],["two","NUM",""],["natural","ADJ",""],["persons","NOUN","person"],null,["those","DET","those"],["persons","NOUN","person"],["could","AUX",""],["be","AUX",""],["from","ADP",""],["one","NUM",""],["or","CCONJ",""],["more","ADJ",""],["entities","NOUN","entity"],["and","CCONJ",""],["include","VERB",""],["the","DET",""],["person","NOUN",""],["operating","VERB","operate"],["or","CCONJ",""],["using","VERB","use"],["the","DET",""],["system","NOUN",""],null,["this","DET","this"],["requirement","NOUN",""],["should","AUX",""],["not","PART",""],["pose","VERB",""],["unnecessary","ADJ",""],["burden","NOUN",""],["or","CCONJ",""],["delays","NOUN","delay"],["and","CCONJ",""],["it","PRON",""],["could","AUX",""],["be","AUX",""],["sufficient","ADJ",""],["that","SCONJ",""],["the","DET",""],["separate","ADJ",""],["verifications","NOUN","verification"],["by","ADP",""],["the","DET",""],["different","ADJ",""],["persons","NOUN","person"],["are","AUX","be"],["automatically","ADV",""],["recorded","VERB","record"],["in","ADP",""],["the","DET",""],["logs","NOUN","log"],["generated","VERB","generate"],["by","ADP",""],["the","DET",""],["system","NOUN",""],null,["given","VERB","give"],["the","DET",""],["specificities","NOUN","specificity"],["of","ADP",""],["the","DET",""],["areas","NOUN","area"],["of","ADP",""],["law","NOUN",""],["enforcement","NOUN",""],null,["migration","NOUN",""],null,["border","NOUN",""],["control","NOUN",""],["and","CCONJ",""],["asylum","NOUN",""],null,["this","DET",""],["requirement","NOUN",""],["should","AUX",""],["not","PART",""],["apply","VERB",""],["where","SCONJ",""],["union","PROPN",""],["or","CCONJ",""],["national","ADJ",""],["law","NOUN",""],["considers","VERB","consider"],["the","DET",""],["application","NOUN",""],["of","ADP",""],["that","DET",""],["requirement","NOUN",""],["to","PART",""],["be","AUX",""],["disproportionate","ADJ",""],null],"text":"(73) High-risk AI systems should be designed and developed in such a way that natural persons can oversee their functioning, ensure that they are used as intended and that their impacts are addressed over the system’s lifecycle.To that end, appropriate human oversight measures should be identified by the provider of the system before its placing on the market or putting into service.In particular, where appropriate, such measures should guarantee that the system is subject to in-built operational constraints that cannot be overridden by the system itself and is responsive to the human operator, and that the natural persons to whom human oversight has been assigned have the necessary competence, training and authority to carry out that role.It is also essential, as appropriate, to ensure that high-risk AI systems include mechanisms to guide and inform a natural person to whom human oversight has been assigned to make informed decisions if, when and how to intervene in order to avoid negative consequences or risks, or stop the system if it does not perform as intended.Considering the significant consequences for persons in the case of an incorrect match by certain biometric identification systems, it is appropriate to provide for an enhanced human oversight requirement for those systems so that no action or decision may be taken by the deployer on the basis of the identification resulting from the system unless this has been separately verified and confirmed by at least two natural persons.Those persons could be from one or more entities and include the person operating or using the system.This requirement should not pose unnecessary burden or delays and it could be sufficient that the separate verifications by the different persons are automatically recorded in the logs generated by the system.Given the specificities of the areas of law enforcement, migration, border control and asylum, this requirement should not apply where Union or national law considers the application of that requirement to be disproportionate.","idx":72,"match_words":["high","risk","system","design","develop","such","way","natural","person","oversee","their functioning","ensure","use","intend","impact","address","over","the system","lifecycle","that end","appropriate","human oversight","measure","identify","the provider","the system","before","its placing","the market","put","service","particular","appropriate","such","measure","guarantee","the system","subject","build","operational","the system","the human operator","natural","person","human oversight","have","assign","have","the necessary competence","training","authority","carry","out","that role","also","essential","appropriate","ensure","high","risk","system","include","mechanism","guide","inform","natural","person","human","oversight","have","assign","make","informed","decision","order","avoid","negative","consequence","risk","stop","the system","perform","intend","consider","significant","consequence","person","the case","an incorrect match","certain","biometric","identification","system","appropriate","provide","enhance","human","oversight","requirement","system","no action","decision","may","take","the deployer","the basis","the identification","result","the system","have","verify","confirm","least","natural","person","person","more","entity","include","the person","operate","use","the 