 to gross violations of fundamental rights, including the right to privacy.","idx":42,"match_words":["placing","the market","putting","service","that specific purpose","the use","system","create","facial recognition","database","the untargeted scraping","facial","image","the internet","cctv footage","prohibit","that practice","add","the feeling","mass surveillance","lead","violation","fundamental","right","include","the right","privacy"],"words":["the","placing","on","the market","the","putting","into","service","for","that specific purpose","or","the use","of","ai","system","that","create","or","expand","facial recognition","database","through","the untargeted scraping","of","facial","image","from","the internet","or","cctv footage","should","be","prohibit","because","that practice","add","to","the feeling","of","mass surveillance","and","can","lead","to","gross","violation","of","fundamental","right","include","the right","to","privacy"],"unmatched_count":26,"match_length":27,"cut_length":53},{"key":"43","text_words":[null,["44","NUM",""],null,["there","PRON","there"],["are","VERB","be"],["serious","ADJ",""],["concerns","NOUN","concern"],["about","ADP",""],["the","DET",""],["scientific","ADJ",""],["basis","NOUN",""],["of","ADP",""],["ai","PROPN",""],["systems","NOUN","system"],["aiming","VERB","aim"],["to","PART",""],["identify","VERB",""],["or","CCONJ",""],["infer","VERB",""],["emotions","NOUN","emotion"],null,["particularly","ADV",""],["as","ADP",""],["expression","NOUN",""],["of","ADP",""],["emotions","NOUN","emotion"],["vary","VERB",""],["considerably","ADV",""],["across","ADP",""],["cultures","NOUN","culture"],["and","CCONJ",""],["situations","NOUN","situation"],null,["and","CCONJ",""],["even","ADV",""],["within","ADP",""],["a","DET",""],null,["single","ADJ",""],["individual","NOUN",""],null,["among","ADP","among"],["the","DET",""],["key","ADJ",""],["shortcomings","NOUN","shortcoming"],["of","ADP",""],["such","ADJ",""],["systems","NOUN","system"],["are","AUX"