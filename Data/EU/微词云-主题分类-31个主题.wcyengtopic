chnology"],null,["including","VERB","include"],["persons","NOUN","person"],["with","ADP",""],["disabilities","NOUN","disability"],null,["in","ADP",""],["a","DET",""],null,["way","NOUN",""],["that","PRON",""],["takes","VERB","take"],["full","ADJ",""],["account","NOUN",""],["of","ADP",""],["their","PRON",""],["inherent","ADJ",""],["dignity","NOUN",""],["and","CCONJ",""],["diversity","NOUN",""],null,["it","PRON","it"],["is","AUX","be"],["therefore","ADV",""],["essential","ADJ",""],["that","SCONJ",""],["providers","NOUN","provider"],["ensure","VERB",""],["full","ADJ",""],["compliance","NOUN",""],["with","ADP",""],["accessibility","NOUN",""],["requirements","NOUN","requirement"],null,["including","VERB","include"],["directive","PROPN",""],null,["eu","PROPN",""],null,["2016/2102","NUM",""],["of","ADP",""],["the","DET",""],["european","PROPN",""],["parliament","PROPN",""],["and","CCONJ",""],["of","ADP",""],["the","DET",""],["council","PROPN",""],null,null,["38","NUM",""],null,null,["and","CCONJ",""],["directive","PROPN",""],null,["eu","PROPN",""],null,["2019/882","NOUN",""],null,["providers","NOUN","provider"],["should","AUX",""],["ensure","VERB",""],["compliance","NOUN",""],["with","ADP",""],["these","DET",""],["requirements","NOUN","requirement"],["by","ADP",""],["design","NOUN",""],null,["therefore","ADV","therefore"],null,["the","DET",""],["necessary","ADJ",""],["measures","NOUN","measure"],["should","AUX",""],["be","AUX",""],["integrated","VERB","integrate"],["as","ADV",""],["much","ADV",""],["as","ADP",""],["possible","ADJ",""],["into","ADP",""],["the","DET",""],["design","NOUN",""],["of","ADP",""],["the","DET",""],["high","ADJ",""],null,["risk","NOUN",""],["ai","PROPN",""],["system","NOUN",""],null],"text":"(80) As signatories to the United Nations Convention on the Rights of Persons with Disabilities, the Union and the Member States are legally obliged to protect persons with disabilities from discrimination and promote their equality, to ensure that persons with disabilities have access, on an equal basis with others, to information and communications technologies and systems, and to ensure respect for privacy for persons with disabilities.Given the growing importance and use of AI systems, the application of universal design principles to all new technologies and services should ensure full and equal access for everyone potentially affected by or using AI technologies, including persons with disabilities, in a way that takes full account of their inherent dignity and diversity.It is therefore essential that providers ensure full compliance with accessibility requirements, including Directive (EU) 2016/2102 of the European Parliament and of the Council (38) and Directive (EU) 2019/882.Providers should ensure compliance with these requirements by design.Therefore, the necessary measures should be integrated as much as possible into the design of the high-risk AI system.","idx":79,"match_words":["the united nations convention","the rights","the union","the member states","legally","oblige","protect","person","disability","discrimination","promote","their equality","ensure","person","disability","have","access","an equal basis","other","information","communication","technology","system","ensure","respect","privacy","person","disability","give","importance","use","system","the application","design","principle","all","new","technology","service","ensure","full and equal access","potentially","affect","use","technology","include","person","disability","way","take","full account","their inherent dignity","diversity","therefore","essential","provider","ensure","full compliance","accessibility","requirement","include","directive","the european parliament","the council","directive","2019/882","provider","ensure","compliance","requirement","design","therefore","necessary","measure","integrate","possible","the design","high","risk","system"],"words":["as","signatory","to","the united nations convention","on","the rights","of","persons",