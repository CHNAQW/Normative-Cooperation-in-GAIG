irements set out in this Section.","idx":301,"match_words":["high","risk","system","test","the purpose","identify","most","appropriate","target","risk","management","measure","testing","ensure","high","risk","system","perform","consistently","intend","purpose","compliance","requirement","set","out","this section"],"words":["high","risk","ai","system","shall","be","test","for","the purpose","of","identify","the","most","appropriate","and","target","risk","management","measure","testing","shall","ensure","that","high","risk","ai","system","perform","consistently","for","their","intend","purpose","and","that","they","be","in","compliance","with","the","requirement","set","out","in","this section"],"unmatched_count":20,"match_length":26,"cut_length":46},{"key":"304","text_words":[["7","X",""],null,["testing","NOUN","testing"],["procedures","NOUN","procedure"],["may","AUX",""],["include","VERB",""],["testing","VERB","test"],["in","ADP",""],["real","ADJ",""],null,["world","NOUN",""],["conditions","NOUN","condition"],["in","ADP",""],["accordance","NOUN",""],["with","ADP",""],null,["article","PROPN",""],null,["60","NUM",""],null],"text":"7. Testing procedures may include testing in real-world conditions in accordance with Article 60.","idx":302,"match_words":["testing","procedure","may","include","test","real","world","condition","accordance","article"],"words":["testing","procedure","may","include","test","in","real","world","condition","in","accordance","with","article"],"unmatched_count":3,"match_length":10,"cut_length":13},{"key":"305","text_words":[["8","X",""],null,["the","DET","the"],["testing","NOUN",""],["of","ADP",""],["high","ADJ",""],null,["risk","NOUN",""],["ai","PROPN",""],["systems","NOUN","system"],["shall","AUX",""],["be","AUX",""],["performed","VERB","perform"],null,["as","ADP",""],["appropriate","ADJ",""],null,["at","ADP",""],["any","DET",""],["time","NOUN",""],["throughout","ADP",""],["the","DET",""],["development","NOUN",""],["process","NOUN",""],null,[