it","the","final","decision","making","must","remain","a","human","drive","activity","the classification","of","ai","system","as","high","risk","should","not","however","extend","to","ai","system","intend","for","purely","ancillary","administrative","activity","that","do","not","affect","the actual administration","of","justice","in","individual","case","such","as","anonymisation","or","pseudonymisation","of","judicial","decision","document","or","datum","communication","between","personnel","administrative","task"],"unmatched_count":93,"match_length":111,"cut_length":204},{"key":"61","text_words":[null,["62","NUM",""],null,["without","ADP","without"],["prejudice","NOUN",""],["to","ADP",""],["the","DET",""],["rules","NOUN","rule"],["provided","VERB","provide"],["for","ADP",""],["in","ADP",""],["regulation","PROPN",""],null,["eu","PROPN",""],null,["2024/900","NUM",""],["of","ADP",""],["the","DET",""],["european","PROPN",""],["parliament","PROPN",""],["and","CCONJ",""],["of","ADP",""],["the","DET",""],["council","PROPN",""],null,null,["and","CCONJ",""],["in","ADP",""],["order","NOUN",""],["to","PART",""],["address","VERB",""],["the","DET",""],["risks","NOUN","risk"],["of","ADP",""],["undue","ADJ",""],["external","ADJ",""],["interference","NOUN",""],["with","ADP",""],["the","DET",""],["right","NOUN",""],["to","PART",""],["vote","VERB",""],["enshrined","VERB","enshrine"],["in","ADP",""],["article","PROPN",""],null,["39","NUM",""],["of","ADP",""],["the","DET",""],["charter","PROPN",""],null,["and","CCONJ",""],["of","ADP",""],["adverse","ADJ",""],["effects","NOUN","effect"],["on","ADP",""],["democracy","NOUN",""],["and","CCONJ",""],["the","DET",""],["rule","NOUN",""],["of","ADP",""],["law","NOUN",""],null,["ai","PROPN",""],["systems","NOUN","system"],["intended","VERB","intend"],["to","PART",""],["be","AUX",""],["used","VERB","use"],["to","PART",""],["influence","VERB",""],["the","DET",""],["outcome","NOUN",""],["of","ADP",""],["an","DET",""],["election","NOUN",""],["or","CCONJ",""],["referendum","NOUN",""],["or","CCONJ",""],["the","DET",""],["voting","NOUN",""],["behaviour","NOUN",""],["of","ADP",""],["natural","ADJ",""],["persons","NOUN","person"],["in","ADP",""],["the","DET",""],["exercise","NOUN",""],["of","ADP",""],["their","PRON",""],["vote","NOUN",""],["in","ADP",""],["elections","NOUN","election"],["or","CCONJ",""],["referenda","PROPN",""],["should","AUX",""],["be","AUX",""],["classified","VERB","classify"],["as","ADP",""],["high","ADJ",""],null,["risk","NOUN",""],["ai","PROPN",""],["systems","NOUN","system"],["with","ADP",""],["the","DET",""],["exception","NOUN",""],["of","ADP",""],["ai","PROPN",""],["systems","NOUN","system"],["whose","DET",""],["output","NOUN",""],["natural","ADJ",""],["persons","NOUN","person"],["are","AUX","be"],["not","PART",""],["directly","ADV",""],["exposed","VERB","expose"],["to","ADP",""],null,["such","ADJ",""],["as","ADP",""],["tools","NOUN","tool"],["used","VERB","use"],["to","PART",""],["organise","VERB",""],null,["optimise","ADJ",""],["and","CCONJ",""],["structure","NOUN",""],["political","ADJ",""],["campaigns","NOUN","campaign"],["from","ADP",""],["an","DET",""],["administrative","ADJ",""],["and","CCONJ",""],["logistical","ADJ",""],["point","NOUN",""],["of","ADP",""],["view","NOUN",""],null],"text":"(62) Without prejudice to the rules provided for in Regulation (EU) 2024/900 of the European Parliament and of the Council , and in order to address the risks of undue external interference with the right to vote enshrined in Article 39 of the Charter, and of adverse effects on democracy and the rule of law, AI systems intended to be used to influence the outcome of an election or referendum or the voting behaviour of natural persons in the exercise of their vote in elections or referenda should be classified as high-risk AI systems with the exception of AI systems whose output natural persons are not directly exposed to, such as tools used to organise, optimise and structure political campaigns from an administrative and logistical point of view.","idx":61,"match_words":["prejudice","the rule","provide","regulation","the european parliament","the council","order","address","risk","undue external interference","the right","vote","enshrine","article","the charter","adverse","effect","democracy","rule","law","system","intend","use","influence","the outcome","an election","the voting behaviour","natural","person","the exercise","their vote","election","classify","high","risk","system","the exception","system","output","natural","person","directly","expose","such","tool","use","organise","optimise","structure","political","campaign","an administrative and logistical point","view"],"words":["without","prejudice","to","the rule","provide","for","in","regulation","eu","of","the european parliament","and","of","the council","and","in","order","to","address","the","risk","of","undue external interference","with","the right","to","vote","enshrine","in","article","of","the charter","and","of","adverse","effect","on","democracy","and","the","rule","of","law","ai","system","intend","to","be","use","to","influence","the outcome","of","an election","or","referendum","or","the voting behaviour","of","natural","person","in","the exercise","of","their vote","in","election","or","referenda","should","be","classify","as","high","risk","ai","system","with","the exception","of","ai","system","whose","output","natural","person","be","not","directly","expose","to","such","as","tool","use","to","organise","optimise","and","structure","political","campaign","from","an administrative and logistical point","of","view"],"unmatched_count":53,"match_length":53,"cut_length":106},{"key":"62","text_words":[null,["63","NUM",""],null,["the","DET","the"],["fact","NOUN",""],["that","SCONJ",""],["an","DET",""],["ai","PROPN",""],["system","NOUN",""],["is","AUX","be"],["classified","VERB","classify"],["as","ADP",""],["a","DET",""],null,["high","ADJ",""],null,["risk","NOUN",""],["ai","PROPN",""],["s