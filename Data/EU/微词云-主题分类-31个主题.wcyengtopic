ext to the extent it is published with the purpose of informing the public on matters of public interest unless the AI-generated content has undergone a process of human review or editorial control and a natural or legal person holds editorial responsibility for the publication of the content."],["the technical solutions","the providers","the AI system","deployers","who","an AI system","image","video","content","that","existing persons","objects","places","entities","events","a person","authentic or truthful (deep fakes","the content","the AI output","its artificial origin","Compliance","this transparency obligation","the use","the AI system","its output","the right","freedom","expression","the right","freedom","the arts","sciences","the Charter","the content","part","an evidently creative, satirical, artistic, fictional or analogous work","programme","appropriate safeguards","the rights","freedoms","third parties","those cases","the transparency obligation","deep fakes","this Regulation","disclosure","the existence","such generated or manipulated content","an appropriate manner","that","the display","enjoyment","the work","its normal exploitation","use","the utility","quality","the work","addition","it","a similar disclosure obligation","relation","AI-generated or manipulated text","the extent","it","the purpose","the public","matters","public interest","the AI-generated content","a process","human review","editorial control","a natural or legal person","editorial responsibility","the publication","the content"],["",["134","NUM","","CARDINAL",["meta","disclose"]],"",["Further","ADV","far","",["advmod","disclose"]],["to","ADP","","",["prep","far"]],["the","DET","","",["det","solution"]],["technical","ADJ","","",["amod","solution"]],["solutions","NOUN","solution","",["pobj","to"],[0.7,""]],["employed","VERB","employ","",["acl","solution"]],["by","ADP","","",["agent","employ"]],["the","DET","","",["det","provider"]],["providers","NOUN","provider","",["pobj","by"]],["o