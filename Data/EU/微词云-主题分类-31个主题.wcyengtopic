nd 3 shall not affect the rights or obligations of the Commission, Member States and their relevant authorities, as well as those of notified bodies, with regard to the exchange of information and the dissemination of warnings, including in the context of cross-border cooperation, nor shall they affect the obligations of the parties concerned to provide information under criminal law of the Member States.","idx":762,"match_words":["paragraph","affect","right","obligation","the commission","member","states","relevant","authority","well","notify","body","regard","the exchange","information","the dissemination","include","the context","cross","border","cooperation","affect","obligation","party","concerned","provide","information","criminal law","the member states"],"words":["paragraph","and","shall","not","affect","the","right","or","obligation","of","the commission","member","states","and","their","relevant","authority","as","well","as","those","of","notify","body","with","regard","to","the exchange","of","information","and","the dissemination","of","warning","include","in","the context","of","cross","border","cooperation","nor","shall","they","affect","the","obligation","of","the","party","concerned","to","provide","information","under","criminal law","of","the member states"],"unmatched_count":29,"match_length":29,"cut_length":58},{"key":"777","text_words":[["5","X",""],null,["the","DET","the"],["commission","PROPN",""],["and","CCONJ",""],["member","PROPN",""],["states","PROPN",""],["may","AUX",""],["exchange","VERB",""],null,["where","SCONJ",""],["necessary","ADJ",""],["and","CCONJ",""],["in","ADP",""],["accordance","NOUN",""],["with","ADP",""],["relevant","ADJ",""],["provisions","NOUN","provision"],["of","ADP",""],["international","ADJ",""],["and","CCONJ",""],["trade","NOUN",""],["agreements","NOUN","agreement"],null,["confidential","ADJ",""],["information","NOUN",""],["with","ADP",""],["regulatory","ADJ",""],["authorities","NOUN","authority"],["of","ADP",""],["th