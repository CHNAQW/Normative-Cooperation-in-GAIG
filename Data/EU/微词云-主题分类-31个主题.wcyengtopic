 level of cybersecurity.","idx":693,"match_words":["national","competent","authority","take","appropriate","measure","ensure","an adequate level","cybersecurity"],"words":["national","competent","authority","shall","take","appropriate","measure","to","ensure","an adequate level","of","cybersecurity"],"unmatched_count":3,"match_length":9,"cut_length":12},{"key":"707","text_words":[["5","X",""],null,["when","SCONJ","when"],["performing","VERB","perform"],["their","PRON",""],["tasks","NOUN","task"],null,["the","DET",""],["national","ADJ",""],["competent","ADJ",""],["authorities","NOUN","authority"],["shall","AUX",""],["act","VERB",""],["in","ADP",""],["accordance","NOUN",""],["with","ADP",""],["the","DET",""],["confidentiality","NOUN",""],["obligations","NOUN","obligation"],["set","VERB",""],["out","ADP",""],["in","ADP",""],["article","NOUN","article"],null,["78","NUM",""],null],"text":"5.When performing their tasks, the national competent authorities shall act in accordance with the confidentiality obligations set out in Article 78.","idx":694,"match_words":["perform","task","national","competent","authority","act","accordance","confidentiality","obligation","set","out","article"],"words":["when","perform","their","task","the","national","competent","authority","shall","act","in","accordance","with","the","confidentiality","obligation","set","out","in","article"],"unmatched_count":8,"match_length":12,"cut_length":20},{"key":"708","text_words":[["6","X",""],null,["by","ADP","by"],["2","NUM",""],null,["august","PROPN",""],["2025","NUM",""],null,["and","CCONJ",""],["once","ADV",""],["every","DET",""],["two","NUM",""],["years","NOUN","year"],["thereafter","ADV",""],null,["member","PROPN",""],["states","PROPN",""],["shall","AUX",""],["report","VERB",""],["to","ADP",""],["the","DET",""],["commission","PROPN",""],["on","ADP",""],["the","DET",""],["status","NOUN",""],["of","ADP",""],["the","DET",""],["financial","ADJ",""],["and","CCONJ",""],["human","ADJ",""],["resources","NO