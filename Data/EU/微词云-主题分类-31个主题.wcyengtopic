oms authorities, for example on the basis of known trafficking routes."],["line","the presumption","innocence","natural persons","the Union","their actual behaviour","Natural persons","AI-predicted behaviour","their profiling","personality traits","characteristics","nationality","place","birth","place","residence","children","debt","type","car","a reasonable suspicion","that person","a criminal activity","objective verifiable facts","human assessment","risk assessments","regard","natural persons","order","the likelihood","their offending","the occurrence","an actual or potential criminal offence","them","their personality traits","characteristics","any case","that prohibition","risk analytics","that","the profiling","individuals","the personality traits","characteristics","individuals","AI systems","risk analytics","the likelihood","financial fraud","undertakings","the basis","suspicious transactions","risk","analytic tools","the likelihood","the localisation","narcotics","illicit goods","customs authorities","example","the basis","known trafficking routes"],["",["42","NUM","","CARDINAL",["ROOT","42"]],"",["In","ADP","in","",["prep","judge"]],["line","NOUN","","",["pobj","in"]],["with","ADP","","",["prep","line"]],["the","DET","","",["det","presumption"]],["presumption","NOUN","","",["pobj","with"]],["of","ADP","","",["prep","presumption"]],["innocence","NOUN","","",["pobj","of"],[1.6,""]],"",["natural","ADJ","","",["amod","person"],[1.5,""]],["persons","NOUN","person","",["nsubjpass","judge"]],["in","ADP","","",["prep","person"]],["the","DET","","",["det","Union"]],["Union","PROPN","","",["pobj","in"]],["should","AUX","","",["aux","judge"]],["always","ADV","","",["advmod","judge"]],["be","AUX","","",["auxpass","judge"]],["judged","VERB","judge","",["ROOT","judge"]],["on","ADP","","",["prep","judge"]],["their","PRON","","",["poss","behaviour"]],["actual","ADJ","","",["amod","behaviour"]],["behaviour","NOUN","","",["pobj","on"]],"",["Natural","ADJ","natural","",["amo