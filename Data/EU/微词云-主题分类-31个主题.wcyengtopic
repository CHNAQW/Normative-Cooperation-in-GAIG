,"identify","and","comply","with","include","through","state","of","the","art","technology","a","reservation","of","right","express","pursuant","to","article","of","directive","eu","2019/790","draw","up","and","make","publicly","available","a","sufficiently","detailed","summary","about","the content","use","for","training","of","the","general","purpose","ai","model","accord","to","a","template","provide","by","the ai office"],"unmatched_count":100,"match_length":116,"cut_length":216},{"key":"583","text_words":[["2","X",""],null,["the","DET","the"],["obligations","NOUN","obligation"],["set","VERB",""],["out","ADP",""],["in","ADP",""],["paragraph","NOUN",""],null,["1","NUM",""],null,["points","NOUN","point"],null,["a","X",""],null,["and","CCONJ",""],null,["b","PROPN",""],null,null,["shall","AUX",""],["not","PART",""],["apply","VERB",""],["to","ADP",""],["providers","NOUN","provider"],["of","ADP",""],["ai","PROPN",""],["models","NOUN","model"],["that","PRON",""],["are","AUX","be"],["released","VERB","release"],["under","ADP",""],["a","DET",""],null,["free","ADJ",""],["and","CCONJ",""],["open","ADJ",""],null,["source","NOUN",""],["licence","NOUN",""],["that","PRON",""],["allows","VERB","allow"],["for","ADP",""],["the","DET",""],["access","NOUN",""],null,["usage","NOUN",""],null,["modification","NOUN",""],null,["and","CCONJ",""],["distribution","NOUN",""],["of","ADP",""],["the","DET",""],["model","NOUN",""],null,["and","CCONJ",""],["whose","DET",""],["parameters","NOUN","parameter"],null,["including","VERB","include"],["the","DET",""],["weights","NOUN","weight"],null,["the","DET",""],["information","NOUN",""],["on","ADP",""],["the","DET",""],["model","NOUN",""],["architecture","NOUN",""],null,["and","CCONJ",""],["the","DET",""],["information","NOUN",""],["on","ADP",""],["model","NOUN",""],["usage","NOUN",""],null,["are","AUX","be"],["made","VERB","make"],["publicly","ADV",""],["available","ADJ",""],null,["this","DET","this"],["exception","NOUN",""],["shall","AUX",""],["not","PART",""],["apply","VERB",""],["to","ADP",""],["general","ADJ",""],null,["purpose","NOUN",""],["ai","PROPN",""],["models","NOUN","model"],["with","ADP",""],["systemic","ADJ",""],["risks","NOUN","risk"],null],"text":"2. The obligations set out in paragraph 1, points (a) and (b), shall not apply to providers of AI models that are released under a free and open-source licence that allows for the access, usage, modification, and distribution of the model, and whose parameters, including the weights, the information on the model architecture, and the information on model usage, are made publicly available.This exception shall not apply to general-purpose AI models with systemic risks.","idx":572,"match_words":["obligation","set","out","paragraph","point","apply","provider","model","release","free","open","source","licence","allow","the access","usage","modification","distribution","the model","parameter","include","weight","the information","the model architecture","the information","model usage","make","publicly","available","this exception","apply","general","purpose","model","systemic","risk"],"words":["the","obligation","set","out","in","paragraph","point","and","b","shall","not","apply","to","provider","of","ai","model","that","be","release","under","a","free","and","open","source","licence","that","allow","for","the access","usage","modification","and","distribution","of","the model","and","whose","parameter","include","the","weight","the information","on","the model architecture","and","the information","on","model usage","be","make","publicly","available","this exception","shall","not","apply","to","general","purpose","ai","model","with","systemic","risk"],"unmatched_count":30,"match_length":36,"cut_length":66},{"key":"584","text_words":[["3","X",""],null,["providers","NOUN","provider"],["of","ADP",""],["general","ADJ",""],null,["purpose","NOUN",""],["ai","PROPN",""],["models","NOUN","model"],["shall","AUX",""],["cooperate","VERB",""],["as","ADV",""],["neces