","the obligations","providers","general-purpose AI models","this Regulation","The AI Office","possible infringements","accordance","the powers","this Regulation","documentation","information","evaluations","measures","providers","general-purpose AI models","evaluations","order","use","independent expertise","the AI Office","independent experts","the evaluations","its behalf","Compliance","the obligations","requests","appropriate measures","risk mitigation measures","the case","identified systemic risks","the making","the market","the model","a safeguard","the procedural rights","this Regulation","providers","general-purpose AI models","the procedural rights","Article","Regulation","EU","which","mutatis mutandis","prejudice","more specific procedural rights","this Regulation"],["",["164","NUM","","CARDINAL",["meta","be"]],"",["The","DET","the","",["det","Office"]],["AI","PROPN","","ORG",["compound","Office"]],["Office","PROPN","","ORG",["nsubj","be"]],["should","AUX","","",["aux","be"]],["be","AUX","","",["ROOT","be"]],["able","ADJ","","",["acomp","be"]],["to","PART","","",["aux","take"]],["take","VERB","","",["xcomp","able"]],["the","DET","","",["det","action"]],["necessary","ADJ","","",["amod","action"]],["actions","NOUN","action","",["dobj","take"]],["to","PART","","",["aux","monitor"]],["monitor","VERB","","",["acl","action"]],["the","DET","","",["det","implementation"]],["effective","ADJ","","",["amod","implementation"],[2.1,""]],["implementation","NOUN","","",["dobj","monitor"]],["of","ADP","","",["prep","implementation"]],["and","CCONJ","","",["cc","implementation"]],["compliance","NOUN","","",["conj","implementation"]],["with","ADP","","",["prep","compliance"]],["the","DET","","",["det","obligation"]],["obligations","NOUN","obligation","",["pobj","with"]],["for","ADP","","",["prep","obligation"]],["providers","NOUN","provider","",["pobj","for"]],["of","ADP","","",["prep","provider"]],["general","ADJ","","",["amod","purpose"]],"",["purpose","NOUN","","",["com