-risk AI system to the extent such logs are under their control, for a period appropriate to the intended purpose of the high-risk AI system, of at least six months, unless provided otherwise in applicable Union or national law, in particular in Union law on the protection of personal data.","idx":396,"match_words":["deployer","high","risk","system","keep","log","automatically","generate","high","risk","system","the extent","such","log","their control","period","appropriate","intend","purpose","high","risk","system","least","month","provide","otherwise","applicable union","national law","particular","union law","the protection","personal","datum"],"words":["deployer","of","high","risk","ai","system","shall","keep","the","log","automatically","generate","by","that","high","risk","ai","system","to","the extent","such","log","be","under","their control","for","a","period","appropriate","to","the","intend","purpose","of","the","high","risk","ai","system","of","at","least","month","unless","provide","otherwise","in","applicable union","or","national law","in","particular","in","union law","on","the protection","of","personal","datum"],"unmatched_count":26,"match_length":33,"cut_length":59},{"key":"402","text_words":[["deployers","NOUN","deployer"],["that","PRON",""],["are","AUX","be"],["financial","ADJ",""],["institutions","NOUN","institution"],["subject","ADJ",""],["to","ADP",""],["requirements","NOUN","requirement"],["regarding","VERB","regard"],["their","PRON",""],["internal","ADJ",""],["governance","NOUN",""],null,["arrangements","NOUN","arrangement"],["or","CCONJ",""],["processes","NOUN","process"],["under","ADP",""],["union","PROPN",""],["financial","ADJ",""],["services","NOUN","service"],["law","NOUN",""],["shall","AUX",""],["maintain","VERB",""],["the","DET",""],["logs","NOUN","log"],["as","ADP",""],["part","NOUN",""],["of","ADP",""],["the","DET",""],["documentation","NOUN",""],["kept","VERB","keep"],["pursuant","ADJ",""],["to","ADP",""],["the","DET",""],["releva