ribute","to","improve","work","condition","and","ultimately","sustain","the consolidation","and","innovation path","of","trustworthy ai","in","the union","the european artificial intelligence board","the","board","should","support","the commission","to","promote","ai","literacy","tool","public awareness","and","understanding","of","the","benefit","risk","safeguard","right","and","obligation","in","relation","to","the use","of","ai","system","in","cooperation","with","the","relevant","stakeholder","the commission","and","the member states","should","facilitate","the drawing","up","of","voluntary","code","of","conduct","to","advance","ai","literacy","among","person","deal","with","the development","operation","and","use","of","ai"],"unmatched_count":95,"match_length":119,"cut_length":214},{"key":"20","text_words":[null,["21","NUM",""],null,["in","ADP","in"],["order","NOUN",""],["to","PART",""],["ensure","VERB",""],["a","DET",""],null,["level","NOUN",""],["playing","NOUN",""],["field","NOUN",""],["and","CCONJ",""],["an","DET",""],["effective","ADJ",""],["protection","NOUN",""],["of","ADP",""],["rights","NOUN","right"],["and","CCONJ",""],["freedoms","NOUN","freedom"],["of","ADP",""],["individuals","NOUN","individual"],["across","ADP",""],["the","DET",""],["union","PROPN",""],null,["the","DET",""],["rules","NOUN","rule"],["established","VERB","establish"],["by","ADP",""],["this","DET",""],["regulation","PROPN",""],["should","AUX",""],["apply","VERB",""],["to","ADP",""],["providers","NOUN","provider"],["of","ADP",""],["ai","PROPN",""],["systems","NOUN","system"],["in","ADP",""],["a","DET",""],null,["non","ADJ",""],null,["discriminatory","ADJ",""],["manner","NOUN",""],null,["irrespective","ADV",""],["of","ADP",""],["whether","SCONJ",""],["they","PRON",""],["are","AUX","be"],["established","VERB","establish"],["within","ADP",""],["the","DET",""],["union","PROPN",""],["or","CCONJ",""],["in","ADP",""],["a","DET",""],null,["third","ADJ",""],["country","NOUN",""],null,["and","C