ssessment.","neg=0.036,neu=0.863,pos=0.101,compound=0.4333,span=In duly justified situations, as provided for in this Regulation, law enforcement authorities or civil protection authorities may put a specific high-risk AI system into service without the authorisation of the market surveillance authority, provided that such authorisation is requested during or after the use without undue delay."],["certain conditions","rapid availability","innovative technologies","health","safety","persons","the environment","change","society","a whole","It","exceptional reasons","public security","protection","life","health","natural persons","key industrial and infrastructural assets","market surveillance authorities","the placing","the market","the putting","service","AI systems","which","a conformity assessment","duly justified situations","this Regulation","law enforcement authorities","civil protection authorities","a specific high-risk AI system","service","the authorisation","the market surveillance authority","such authorisation","the use","undue delay"],["",["130","NUM","","CARDINAL",["dep","be"]],"",["Under","ADP","under","",["prep","be"]],["certain","ADJ","","",["amod","condition"],[1.1,""]],["conditions","NOUN","condition","",["pobj","under"]],"",["rapid","ADJ","","",["amod","availability"]],["availability","NOUN","","",["nsubj","be"]],["of","ADP","","",["prep","availability"]],["innovative","ADJ","","",["amod","technology"],[1.9,""]],["technologies","NOUN","technology","",["pobj","of"]],["may","AUX","","",["aux","be"]],["be","AUX","","",["ROOT","be"]],["crucial","ADJ","","",["acomp","be"]],["for","ADP","","",["prep","crucial"]],["health","NOUN","","",["pobj","for"]],["and","CCONJ","","",["cc","health"]],["safety","NOUN","","",["conj","health"],[1.8,""]],["of","ADP","","",["prep","health"]],["persons","NOUN","person","",["pobj","of"]],"",["the","DET","","",["det","protection"]],["protection","NOUN","","",["npadvmod","be"]],["of","ADP","","",["prep","protection"]],["the"