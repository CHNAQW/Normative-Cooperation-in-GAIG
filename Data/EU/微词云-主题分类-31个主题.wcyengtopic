o","envisage","additional","safeguard","to","ensure","that","the","prediction","recommendation","or","decision","of","the ai system","can","be","effectively","reverse","and","disregarded","and","that","personal","datum","be","protect","and","be","delete","when","the","subject","have","withdraw","their consent","to","participate","in","the testing","without","prejudice","to","their","right","as","datum","subject","under","the","union","datum","protection","law","as","regard","transfer","of","datum","it","be","also","appropriate","to","envisage","that","datum","collect","and","process","for","the purpose","of","testing","in","real","world","condition","should","be","transfer","to","third","country","only","where","appropriate","and","applicable","safeguard","under","union law","be","implement","in","particular","in","accordance","with","basis","for","transfer","of","personal","datum","under","union law","on","datum","protection","while","for","non","personal","datum","appropriate","safeguard","be","put","in","place","in","accordance","with","union law","such","as","regulations","eu","and","eu","of","the european parliament","and","of","the council"],"unmatched_count":162,"match_length":212,"cut_length":374},{"key":"141","text_words":[null,["142","NUM",""],null,["to","PART","to"],["ensure","VERB",""],["that","SCONJ",""],["ai","PROPN",""],["leads","VERB","lead"],["to","ADP",""],["socially","ADV",""],["and","CCONJ",""],["environmentally","ADV",""],["beneficial","ADJ",""],["outcomes","NOUN","outcome"],null,["member","PROPN",""],null,["states","PROPN",""],["are","AUX","be"],["encouraged","VERB","encourage"],["to","PART",""],["support","VERB",""],["and","CCONJ",""],["promote","VERB",""],["research","NOUN",""],["and","CCONJ",""],["development","NOUN",""],["of","ADP",""],["ai","PROPN",""],["solutions","NOUN","solution"],["in","ADP",""],["support","NOUN",""],["of","ADP",""],["socially","ADV",""],["and","CCONJ",""],["environmentally","ADV",""],["beneficial","ADJ",""],["outcomes","NOUN","outcome"],null,["such","ADJ",""],["as","ADP",""],["ai","PROPN",""],null,["based","VERB","base"],["solutions","NOUN","solution"],["to","PART",""],["increase","VERB",""],["accessibility","NOUN",""],["for","ADP",""],["persons","NOUN","person"],["with","ADP",""],["disabilities","NOUN","disability"],null,["tackle","PROPN",""],["socio","PROPN",""],null,["economic","PROPN",""],["inequalities","NOUN","inequality"],null,["or","CCONJ",""],["meet","VERB",""],["environmental","ADJ",""],["targets","NOUN","target"],null,["by","ADP",""],["allocating","VERB","allocate"],["sufficient","ADJ",""],["resources","NOUN","resource"],null,["including","VERB","include"],["public","ADJ",""],["and","CCONJ",""],["union","PROPN",""],["funding","NOUN",""],null,["and","CCONJ",""],null,["where","SCONJ",""],["appropriate","ADJ",""],["and","CCONJ",""],["provided","VERB","provide"],["that","SCONJ",""],["the","DET",""],["eligibility","NOUN",""],["and","CCONJ",""],["selection","NOUN",""],["criteria","NOUN","criterion"],["are","AUX","be"],["fulfilled","VERB","fulfil"],null,["considering","VERB","consider"],["in","ADP",""],["particular","ADJ",""],["projects","NOUN","project"],["which","PRON",""],["pursue","VERB",""],["such","ADJ",""],["objectives","NOUN","objective"],null,["such","ADJ","such"],["projects","NOUN","project"],["should","AUX",""],["be","AUX",""],["based","VERB","base"],["on","ADP",""],["the","DET",""],["principle","NOUN",""],["of","ADP",""],["interdisciplinary","ADJ",""],["cooperation","NOUN",""],["between","ADP",""],["ai","PROPN",""],["developers","NOUN","developer"],null,["experts","NOUN","expert"],["on","ADP",""],["inequality","NOUN",""],["and","CCONJ",""],["non","NOUN",""],null,["discrimination","NOUN",""],null,["accessibility","NOUN",""],null,["consumer","NOUN",""],null,["environmental","ADJ",""],null,["and","CCONJ",""],["digital","ADJ",""],["rights","NOUN","right"],null,["as","ADV",""],["well","ADV",""],["as","ADP",""],["academics","NOUN","academic"],null],"text":"(142) To ensure that AI leads to socially and environmentally beneficial outcomes, Member States are encouraged to support and promote research and development of AI solutions in support of socially and environmentally beneficial outcomes, such as AI-based solutions to increase accessibility for persons with disabilities, tackle socio-economic inequalities, or meet environmental targets, by allocating sufficient resources, including public and Union funding, and, where appropriate and provided that the eligibility and selection criteria are fulfilled, considering in particular projects which pursue such objectives.Such projects should be based on the principle of interdisciplinary cooperation between AI developers, experts on inequality and non-discrimination, accessibility, consumer, environmental, and digital rights, as well as academics.","idx":141,"match_words":["ensure","lead","socially","environmentally","beneficial","outcome","member","states","encourage","support","promote","research","development","solution","support","socially","environmentally","beneficial","outcome","such","base","solution","increase","accessibility","person","disability","economic","inequality","meet","environmental","target","allocate","sufficient","resource","include","public and union funding","appropriate","provide","the eligibility","selection","criterion","fulfil","consider","particular","project","pursue","such","objective","such","project","base","the principle","interdisciplinary cooperation","expert","inequality","non","discrimination","accessibility","consumer","environmental","digital","right","well"],"words":["to","ensure","that","ai","lead","to","socially","and","environmentally","beneficial","outcome","member","states","be","encourage","to","support","and","promote","research","and","development","of","ai","solution","in","support","of","socially","and","environmentally","beneficial","outcome","such","as","ai","base","solution","to","increase","accessibility","for","person","with","d