,["should","AUX",""],["apply","VERB",""],["from","ADP",""],["2","NUM",""],null,["august","PROPN",""],["2025","NUM",""],null,["given","VERB","give"],["the","DET",""],["rapid","ADJ",""],["pace","NOUN",""],["of","ADP",""],["technological","ADJ",""],["advancements","NOUN","advancement"],["and","CCONJ",""],["adoption","NOUN",""],["of","ADP",""],["general","ADJ",""],null,["purpose","NOUN",""],["ai","PROPN",""],["models","NOUN","model"],null,["obligations","NOUN","obligation"],["for","ADP",""],["providers","NOUN","provider"],["of","ADP",""],["general","ADJ",""],null,["purpose","NOUN",""],["ai","PROPN",""],["models","NOUN","model"],["should","AUX",""],["apply","VERB",""],["from","ADP",""],["2","NUM",""],null,["august","PROPN",""],["2025","NUM",""],null,["codes","NOUN","code"],["of","ADP",""],["practice","NOUN",""],["should","AUX",""],["be","AUX",""],["ready","ADJ",""],["by","ADP",""],["2","NUM",""],null,["may","PROPN",""],["2025","NUM",""],["in","ADP",""],["view","NOUN",""],["of","ADP",""],["enabling","VERB","enable"],["providers","NOUN","provider"],["to","PART",""],["demonstrate","VERB",""],["compliance","NOUN",""],["on","ADP",""],["time","NOUN",""],null,["the","DET","the"],["ai","PROPN",""],["office","PROPN",""],["should","AUX",""],["ensure","VERB",""],["that","SCONJ",""],["classification","NOUN",""],["rules","NOUN","rule"],["and","CCONJ",""],["procedures","NOUN","procedure"],["are","AUX","be"],["up","ADP",""],["to","ADP",""],["date","NOUN",""],["in","ADP",""],["light","NOUN",""],["of","ADP",""],["technological","ADJ",""],["developments","NOUN","development"],null,["in","ADP","in"],["addition","NOUN",""],null,["member","PROPN",""],["states","PROPN",""],["should","AUX",""],["lay","VERB",""],["down","ADP",""],["and","CCONJ",""],["notify","VERB",""],["to","ADP",""],["the","DET",""],["commission","PROPN",""],["the","DET",""],["rules","NOUN","rule"],["on","ADP",""],["penalties","NOUN","penalty"],null,["including","VERB","include"],["administrative","ADJ",""],["fines","NOUN","fine"],null,["and","CCONJ",""],["ensure","VERB",""],["that","SCONJ",""],["they","PRON",""],["are","AUX","be"],["properly","ADV",""],["and","CCONJ",""],["effectively","ADV",""],["implemented","VERB","implement"],["by","ADP",""],["the","DET",""],["date","NOUN",""],["of","ADP",""],["application","NOUN",""],["of","ADP",""],["this","DET",""],["regulation","PROPN",""],null,["therefore","ADV","therefore"],["the","DET",""],["provisions","NOUN","provision"],["on","ADP",""],["penalties","NOUN","penalty"],["should","AUX",""],["apply","VERB",""],["from","ADP",""],["2","NUM",""],null,["august","PROPN",""],["2025","NUM",""],null],"text":"(179)This Regulation should apply from 2 August 2026.However, taking into account the unacceptable risk associated with the use of AI in certain ways, the prohibitions as well as the general provisions of this Regulation should already apply from 2 February 2025.While the full effect of those prohibitions follows with the establishment of the governance and enforcement of this Regulation, anticipating the application of the prohibitions is important to take account of unacceptable risks and to have an effect on other procedures, such as in civil law.Moreover, the infrastructure related to the governance and the conformity assessment system should be operational before 2 August 2026, therefore the provisions on notified bodies and governance structure should apply from 2 August 2025.Given the rapid pace of technological advancements and adoption of general-purpose AI models, obligations for providers of general-purpose AI models should apply from 2 August 2025.Codes of practice should be ready by 2 May 2025 in view of enabling providers to demonstrate compliance on time.The AI Office should ensure that classification rules and procedures are up to date in light of technological developments.In addition, Member States should lay down and notify to the Commission the rules on penalties, including administrative fines, and ensure that they are properly and effectively implemented by the date of application of this Regulation.Therefore the provisions on penalties should apply from 2 August 2025.","idx":178,"match_words":["this regulation","apply","august","however","take","account","the unacceptable risk","associate","the use","certain","way","prohibition","well","general","provision","this regulation","already","apply","february","the full effect","prohibition","follow","the establishment","the governance","enforcement","this regulation","the application","prohibition","important","take","account","unacceptable","risk","have","an effect","other","procedure","such","civil law","moreover","the infrastructure","relate","the governance","the conformity assessment system","operational","before","august","therefore","provision","notify","body","governance structure","apply","august","give","the rapid pace","technological","adoption","general","purpose","model","obligation","provider","general","purpose","model","apply","august","code","practice","may","view","enable","provider","demonstrate","compliance","time","the ai office","ensure","classification","rule","procedure","date","light","technological","development","addition","member states","lay","down","notify","the commission","rule","penalty","include","administrative","fine","ensure","properly","effectively","implement","the date","application","this regulation","therefore","provision","penalty","apply","august"],"words":["this regulation","should","apply","from","august","however","take","into","account","the unacceptable risk","associate","with","the use","of","ai","in","certain","way","the","prohibition","as","well","as","the","general","provision","of","this regulation","should","already","apply","from","february","while","the full effect","of","those","prohibition","follow","with","the establishment","of","the governance","and","enforcement","of","this regulation","anticipate","the application","of","the","prohibition","be","important","to","take","account",