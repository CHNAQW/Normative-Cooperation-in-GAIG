eded, and ensure that the combination of support activities carried out by Union AI testing support pursuant to Article 84 and experts pursuant to this Article is efficiently organised and provides the best possible added value.","idx":688,"match_words":["the commission","facilitate","timely access","expert","the member states","need","ensure","the combination","support","activity","carry","out","union ai testing support","pursuant","article","expert","pursuant","this article","efficiently","organise","provide","good","possible","add","value"],"words":["the commission","shall","facilitate","timely access","to","the","expert","by","the member states","as","need","and","ensure","that","the combination","of","support","activity","carry","out","by","union ai testing support","pursuant","to","article","and","expert","pursuant","to","this article","be","efficiently","organise","and","provide","the","good","possible","add","value"],"unmatched_count":15,"match_length":25,"cut_length":40},{"key":"702","text_words":[["designation","NOUN","designation"],["of","ADP",""],["national","ADJ",""],["competent","ADJ",""],["authorities","NOUN","authority"],["and","CCONJ",""],["single","ADJ",""],["points","NOUN","point"],["of","ADP",""],["contact","NOUN",""]],"text":"Designation of national competent authorities and single points of contact","idx":689,"match_words":["designation","national","competent","authority","single","point","contact"],"words":["designation","of","national","competent","authority","and","single","point","of","contact"],"unmatched_count":3,"match_length":7,"cut_length":10},{"key":"703","text_words":[["1","X",""],null,["each","DET","each"],["member","PROPN",""],["state","PROPN",""],["shall","AUX",""],["establish","VERB",""],["or","CCONJ",""],["designate","ADJ",""],["as","ADP",""],["national","ADJ",""],["competent","ADJ",""],["authorities","NOUN","authority"],["at","ADV",""],["least","ADV",""],["one","NUM",""],["notifying","NOUN",""],["authority","NOUN",""],["and","C