e","ADJ",""],["when","SCONJ",""],["personal","ADJ",""],["data","NOUN","datum"],["are","AUX","be"],["processed","VERB","process"],null,["measures","NOUN","measure"],["taken","VERB","take"],["by","ADP",""],["providers","NOUN","provider"],["to","PART",""],["ensure","VERB",""],["compliance","NOUN",""],["with","ADP",""],["those","DET",""],["principles","NOUN","principle"],["may","AUX",""],["include","VERB",""],["not","PART",""],["only","ADV",""],["anonymisation","NOUN",""],["and","CCONJ",""],["encryption","NOUN",""],null,["but","CCONJ",""],["also","ADV",""],["the","DET",""],["use","NOUN",""],["of","ADP",""],["technology","NOUN",""],["that","PRON",""],["permits","VERB","permit"],["algorithms","NOUN","algorithm"],["to","PART",""],["be","AUX",""],["brought","VERB","bring"],["to","ADP",""],["the","DET",""],["data","NOUN","datum"],["and","CCONJ",""],["allows","VERB","allow"],["training","NOUN",""],["of","ADP",""],["ai","PROPN",""],["systems","NOUN","system"],["without","ADP",""],["the","DET",""],["transmission","NOUN",""],["between","ADP",""],["parties","NOUN","party"],["or","CCONJ",""],["copying","NOUN",""],["of","ADP",""],["the","DET",""],["raw","ADJ",""],["or","CCONJ",""],["structured","ADJ",""],["data","NOUN","datum"],["themselves","PRON",""],null,["without","ADP",""],["prejudice","NOUN",""],["to","ADP",""],["the","DET",""],["requirements","NOUN","requirement"],["on","ADP",""],["data","NOUN",""],["governance","NOUN",""],["provided","VERB","provide"],["for","ADP",""],["in","ADP",""],["this","DET",""],["regulation","PROPN",""],null],"text":"(69)The right to privacy and to protection of personal data must be guaranteed throughout the entire lifecycle of the AI system.In this regard, the principles of data minimisation and data protection by design and by default, as set out in Union data protection law, are applicable when personal data are processed.Measures taken by providers to ensure compliance with those principles may include not only anonymisation and encryption, but 