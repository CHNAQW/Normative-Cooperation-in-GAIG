"],["they","PRON",""],["can","AUX",""],["be","AUX",""],["used","VERB","use"],["only","ADV",""],["in","ADP",""],["relation","NOUN",""],["to","ADP",""],["the","DET",""],["principal","ADJ",""],["service","NOUN",""],["which","PRON",""],["consists","VERB","consist"],["in","ADP",""],["selling","VERB","sell"],["a","DET",""],null,["product","NOUN",""],["by","ADP",""],["allowing","VERB","allow"],["the","DET",""],["consumer","NOUN",""],["to","PART",""],["preview","VERB",""],["the","DET",""],["display","NOUN",""],["of","ADP",""],["the","DET",""],["product","NOUN",""],["on","ADP",""],["him","PRON","he"],["or","CCONJ",""],["herself","PRON",""],["and","CCONJ",""],["help","VERB",""],["the","DET",""],["consumer","NOUN",""],["to","PART",""],["make","VERB",""],["a","DET",""],null,["purchase","NOUN",""],["decision","NOUN",""],null,["filters","NOUN","filter"],["used","VERB","use"],["on","ADP",""],["online","ADJ",""],["social","ADJ",""],["network","NOUN",""],["services","NOUN","service"],["which","PRON",""],["categorise","VERB",""],["facial","ADJ",""],["or","CCONJ",""],["body","NOUN",""],["features","NOUN","feature"],["to","PART",""],["allow","VERB",""],["users","NOUN","user"],["to","PART",""],["add","VERB",""],["or","CCONJ",""],["modify","VERB",""],["pictures","NOUN","picture"],["or","CCONJ",""],["videos","NOUN","video"],["could","AUX",""],["also","ADV",""],["be","AUX",""],["considered","VERB","consider"],["to","PART",""],["be","AUX",""],["ancillary","ADJ",""],["feature","NOUN",""],["as","SCONJ",""],["such","ADJ",""],["filter","NOUN",""],["can","AUX",""],["not","PART",""],["be","AUX",""],["used","VERB","use"],["without","ADP",""],["the","DET",""],["principal","ADJ",""],["service","NOUN",""],["of","ADP",""],["the","DET",""],["social","ADJ",""],["network","NOUN",""],["services","NOUN","service"],["consisting","VERB","consist"],["in","ADP",""],["the","DET",""],["sharing","NOUN",""],["of","ADP",""],["content","NOUN",""],["online","NOUN",""],null],"text":"(16) The notion of ‘biometric categorisation’ referred to in this Regulation should be defined as assigning natural persons to specific categories on the basis of their biometric data.Such specific categories can relate to aspects such as sex, age, hair colour, eye colour, tattoos, behavioural or personality traits, language, religion, membership of a national minority, sexual or political orientation.This does not include biometric categorisation systems that are a purely ancillary feature intrinsically linked to another commercial service, meaning that the feature cannot, for objective technical reasons, be used without the principal service, and the integration of that feature or functionality is not a means to circumvent the applicability of the rules of this Regulation.For example, filters categorising facial or body features used on online marketplaces could constitute such an ancillary feature as they can be used only in relation to the principal service which consists in selling a product by allowing the consumer to preview the display of the product on him or herself and help the consumer to make a purchase decision.Filters used on online social network services which categorise facial or body features to allow users to add or modify pictures or videos could also be considered to be ancillary feature as such filter cannot be used without the principal service of the social network services consisting in the sharing of content online.","idx":15,"match_words":["the notion","biometric","categorisation","refer","this regulation","define","assign","natural","person","specific","category","the basis","biometric","datum","such","specific","category","relate","aspect","such","sex","age","hair colour","eye colour","behavioural","personality","trait","language","membership","national","sexual or political orientation","include","biometric","categorisation","system","purely","ancillary feature","link","another commercial service","mean","the feature","objective","technical","reason","use","the principa