te or public databases or data archives, and by providing a narrative explanation about other data sources used.","neg=0.0,neu=0.872,pos=0.128,compound=0.6124,span=It is appropriate for the AI Office to provide a template for the summary, which should be simple, effective, and allow the provider to provide the required summary in narrative form."],["order","transparency","the data","that","-","general-purpose AI models","text","data","copyright law","it","providers","such models","a sufficiently detailed summary","the content","the general-purpose AI model","due account","the need","trade secrets","confidential business information","this summary","its scope","parties","legitimate interests","copyright holders","their rights","Union law","example","the main data collections","sets","that","the model","large private or public databases","data archives","a narrative explanation","other data sources","It","the AI Office","a template","the summary","which","the provider","the required summary","narrative form"],["",["107","NUM","","CARDINAL",["dep","be"]],"",["In","ADP","in","",["prep","be"]],["order","NOUN","","",["pobj","in"]],["to","PART","","",["aux","increase"]],["increase","VERB","","",["acl","order"],[1.3,""]],["transparency","NOUN","","",["dobj","increase"]],["on","ADP","","",["prep","transparency"]],["the","DET","","",["det","datum"]],["data","NOUN","datum","",["pobj","on"]],["that","PRON","","",["nsubjpass","use"]],["is","AUX","be","",["auxpass","use"]],["used","VERB","use","",["relcl","datum"]],["in","ADP","","",["prep","use"]],["the","DET","","",["det","pre"]],["pre","ADJ","","",["pobj","in"]],"",["training","NOUN","","",["nmod","-"]],["and","CCONJ","","",["cc","training"]],["training","NOUN","","",["conj","training"]],["of","ADP","","",["prep","training"]],["general","ADJ","","",["amod","purpose"]],"",["purpose","NOUN","","",["compound","model"]],["AI","PROPN","","ORG",["compound","model"]],["models","NOUN","model","",["pobj","of"]],"",["including","VERB","