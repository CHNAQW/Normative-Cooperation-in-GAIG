,"NOUN",""],["to","PART",""],["be","AUX",""],["disproportionate","ADJ",""],null],"text":"The requirement for a separate verification by at least two natural persons shall not apply to high-risk AI systems used for the purposes of law enforcement, migration, border control or asylum, where Union or national law considers the application of this requirement to be disproportionate.","idx":330,"match_words":["the requirement","separate","verification","least","natural","person","apply","high","risk","system","use","purpose","law enforcement","migration","border control","asylum","union","national law","consider","the application","this requirement","disproportionate"],"words":["the requirement","for","a","separate","verification","by","at","least","natural","person","shall","not","apply","to","high","risk","ai","system","use","for","the","purpose","of","law enforcement","migration","border control","or","asylum","where","union","or","national law","consider","the application","of","this requirement","to","be","disproportionate"],"unmatched_count":17,"match_length":22,"cut_length":39},{"key":"335","text_words":[["accuracy","PROPN",""],null,["robustness","NOUN",""],["and","CCONJ",""],["cybersecurity","NOUN",""]],"text":"Accuracy, robustness and cybersecurity","idx":331,"match_words":["accuracy","robustness","cybersecurity"],"words":["accuracy","robustness","and","cybersecurity"],"unmatched_count":1,"match_length":3,"cut_length":4},{"key":"336","text_words":[["1","X",""],null,["high","ADJ","high"],null,["risk","NOUN",""],["ai","PROPN",""],["systems","NOUN","system"],["shall","AUX",""],["be","AUX",""],["designed","VERB","design"],["and","CCONJ",""],["developed","VERB","develop"],["in","ADP",""],["such","DET",""],["a","DET",""],null,["way","NOUN",""],["that","PRON",""],["they","PRON",""],["achieve","VERB",""],["an","DET",""],["appropriate","ADJ",""],["level","NOUN",""],["of","ADP",""],["accuracy","NOUN",""],null,["robustness","NOUN",""],null,["and","CCONJ",""],["cybersecurit