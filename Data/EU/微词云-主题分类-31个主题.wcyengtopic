l"],["generating","VERB","generate"],["content","NOUN",""],null,["thereby","ADV",""],["facilitating","VERB","facilitate"],["fulfilment","NOUN",""],["of","ADP",""],["this","DET",""],["obligation","NOUN",""],["by","ADP",""],["the","DET",""],["downstream","ADJ",""],["provider","NOUN",""],["of","ADP",""],["the","DET",""],["ai","PROPN",""],["system","NOUN",""],null,["to","PART","to"],["remain","VERB",""],["proportionate","ADJ",""],null,["it","PRON",""],["is","AUX","be"],["appropriate","ADJ",""],["to","PART",""],["envisage","VERB",""],["that","SCONJ",""],["this","DET",""],["marking","VERB","mark"],["obligation","NOUN",""],["should","AUX",""],["not","PART",""],["cover","VERB",""],["ai","PROPN",""],["systems","NOUN","system"],["performing","VERB","perform"],["primarily","ADV",""],["an","DET",""],["assistive","ADJ",""],["function","NOUN",""],["for","ADP",""],["standard","ADJ",""],["editing","NOUN",""],["or","CCONJ",""],["ai","PROPN",""],["systems","NOUN","system"],["not","PART",""],["substantially","ADV",""],["altering","VERB","alter"],["the","DET",""],["input","NOUN",""],["data","NOUN","datum"],["provided","VERB","provide"],["by","ADP",""],["the","DET",""],["deployer","NOUN",""],["or","CCONJ",""],["the","DET",""],["semantics","NOUN","semantic"],["thereof","ADV",""],null],"text":"(133) A variety of AI systems can generate large quantities of synthetic content that becomes increasingly hard for humans to distinguish from human-generated and authentic content.The wide availability and increasing capabilities of those systems have a significant impact on the integrity and trust in the information ecosystem, raising new risks of misinformation and manipulation at scale, fraud, impersonation and consumer deception.In light of those impacts, the fast technological pace and the need for new methods and techniques to trace origin of information, it is appropriate to require providers of those systems to embed technical solutions that enable marking in a machine readable format and detection that the output has been generated or manipulated by an AI system and not a human.Such techniques and methods should be sufficiently reliable, interoperable, effective and robust as far as this is technically feasible, taking into account available techniques or a combination of such techniques, such as watermarks, metadata identifications, cryptographic methods for proving provenance and authenticity of content, logging methods, fingerprints or other techniques, as may be appropriate.When implementing this obligation, providers should also take into account the specificities and the limitations of the different types of content and the relevant technological and market developments in the field, as reflected in the generally acknowledged state of the art.Such techniques and methods can be implemented at the level of the AI system or at the level of the AI model, including general-purpose AI models generating content, thereby facilitating fulfilment of this obligation by the downstream provider of the AI system.To remain proportionate, it is appropriate to envisage that this marking obligation should not cover AI systems performing primarily an assistive function for standard editing or AI systems not substantially altering the input data provided by the deployer or the semantics thereof.","idx":132,"match_words":["a variety","system","generate","large","synthetic content","become","increasingly","human","distinguish","human","generate","authentic","content","the wide availability","increase","capability","system","have","significant","impact","the integrity","trust","the information ecosystem","raise","new","risk","scale","fraud","consumer deception","light","impact","technological","pace","need","new","method","technique","origin","information","appropriate","require","provider","system","embed","technical","solution","enable","mark","machine","readable","format","detection","the output","have","generate","manipulate","an ai system","human","such","technique","method","sufficiently","reliable","effective","robust","far","technically","feasible","take","account","available","technique","combination","such","technique","such","identification","method","prove","provenance","content","log","method","other","technique","may","appropriate","implement","this obligation","provider","also","take","account","specificity","limitation","different","type","content","relevant","technological","market","development","the field","reflect","generally","acknowledge","state","the art","such","technique","method","implement","the level","the ai system","the level","the ai model","include","general","purpose","model","generate","content","thereby","facilitate","fulfilment","this obligation","the downstream provider","the ai system","remain","proportionate","appropriate","envisage","mark","obligation","cover","system","perform","primarily an assistive function","standard editing","system","substantially","alter","input","datum","provide","the deployer","semantic","thereof"],"words":["a variety","of","ai","system","can","generate","large","quantity","of","synthetic content","that","become","increasingly","hard","for","human","to","distinguish","from","human","generate","and","authentic","content","the wide availability","and","increase","capability","of","those","system","have","a","significant","impact","on","the integrity","and","trust","in","the information ecosystem","raise","new","risk","of","misinformation","and","manipulation","at","scale","fraud","impersonation","and","consumer deception","in","light","of","those","impact","the","fast","technological","pace","and","the","need","for","new","method","and","technique","to","trace","origin","of","information","it","be","appropriate","to","require","provider","of","those","system","to","embed","technical","solution","that","enable","mark","in","a","machine","readable","format","and","detection","that","the output","have","be","generate","or","manipulate","by","an ai system","and","not","a","human","such","technique","and","method","should","be","sufficiently","reliable","interoperable","effective","and","robust","as","far","as","this","be","technically","feasible","take","into","account","available","technique","or","a","combination","of","such","technique","such","as","watermark","metadata","identification","cryptographic","method","for","prove","provenance","and","authenticity","of","content","log","method","fingerprint","or","other","technique","as","may","be","appropriate","when","implement","this obligation","provider","should","also","take","into","account","the","specificity","and","the","limitation","of","the","different","type","of","content","and","the","relevant","technological","and","market","development","in","the field","as","reflect","in","the","generally","acknowledge","state","of","the art","such","technique","and","method","can","be","implement","at","the level","of","the ai system","or","at","the level","of","the ai model","include","general","purpose","ai","model","generate","content","thereby","facilitate","fulfilment","of","this obligation","by","the downstream provider","of","the ai system","to","remain","proportionate","it","be","appropriate","to","envisage","that","this","mark","obligation","should","not","cover","ai","system","perform","primarily an assistive function","for","standard editing","or","ai","system","not","substantially","alter","the","input","datum","provide","by","the deployer","or","the","semantic","thereof"],"unmatched_count":125,"match_length":148,"cut_length":273},{"key":"133","text_words":[null,["134","NUM",""],null,["further","ADV","far"],["to","ADP",""],["the","DET",""],["technical","ADJ",""],["solutions","NOUN","solution"],["employed","VERB","employ"],["by","ADP",""],["the","DET",""],["providers","NOUN","provider"],["of","ADP",""],["the","DET",""],["ai","PROPN",""],["system","NOUN",""],null,["deployers","NOUN","deployer"],["who","PRON",""],["use","VERB",""],["an","DET",""],["ai","PROPN",""],["syst