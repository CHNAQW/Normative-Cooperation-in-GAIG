e","AUX",""],["a","DET",""],null,["new","ADJ",""],["ai","PROPN",""],["system","NOUN",""],["which","PRON",""],["should","AUX",""],["undergo","VERB",""],["a","DET",""],null,["new","ADJ",""],["conformity","NOUN",""],["assessment","NOUN",""],null,["however","ADV","however"],null,["changes","NOUN","change"],["occurring","VERB","occur"],["to","ADP",""],["the","DET",""],["algorithm","NOUN",""],["and","CCONJ",""],["the","DET",""],["performance","NOUN",""],["of","ADP",""],["ai","PROPN",""],["systems","NOUN","system"],["which","PRON",""],["continue","VERB",""],["to","PART",""],["‘","PUNCT","'"],["learn","VERB",""],["’","PUNCT","'"],["after","ADP",""],["being","AUX","be"],["placed","VERB","place"],["on","ADP",""],["the","DET",""],["market","NOUN",""],["or","CCONJ",""],["put","VERB",""],["into","ADP",""],["service","NOUN",""],null,["namely","ADV",""],["automatically","ADV",""],["adapting","VERB","adapt"],["how","SCONJ",""],["functions","NOUN","function"],["are","AUX","be"],["carried","VERB","carry"],["out","ADP",""],null,["should","AUX",""],["not","PART",""],["constitute","VERB",""],["a","DET",""],null,["substantial","ADJ",""],["modification","NOUN",""],null,["provided","VERB","provide"],["that","SCONJ",""],["those","DET",""],["changes","NOUN","change"],["have","AUX",""],["been","AUX","be"],["pre","VERB",""],null,["determined","ADJ",""],["by","ADP",""],["the","DET",""],["provider","NOUN",""],["and","CCONJ",""],["assessed","VERB","assess"],["at","ADP",""],["the","DET",""],["moment","NOUN",""],["of","ADP",""],["the","DET",""],["conformity","NOUN",""],["assessment","NOUN",""],null],"text":"(128) In line with the commonly established notion of substantial modification for products regulated by Union harmonisation legislation, it is appropriate that whenever a change occurs which may affect the compliance of a high-risk AI system with this Regulation (e.g. change of operating system or software architecture), or when the intended purpose of the system changes, that AI system should be considered to be a new AI system which should undergo a new conformity assessment.However, changes occurring to the algorithm and the performance of AI systems which continue to ‘learn’ after being placed on the market or put into service, namely automatically adapting how functions are carried out, should not constitute a substantial modification, provided that those changes have been pre-determined by the provider and assessed at the moment of the conformity assessment.","idx":127,"match_words":["line","establish","notion","substantial modification","product","regulate","union harmonisation legislation","appropriate","change","occur","may","affect","the compliance","high","risk","ai system","this regulation","change","operate","system","software architecture","intend","purpose","system","change","system","consider","new","system","undergo","new","conformity","assessment","however","change","occur","the algorithm","the performance","system","continue","learn","place","the market","put","service","namely","automatically","adapt","function","carry","out","constitute","substantial","modification","provide","change","have","pre","determined","the provider","assess","the moment","the conformity assessment"],"words":["in","line","with","the","commonly","establish","notion","of","substantial modification","for","product","regulate","by","union harmonisation legislation","it","be","appropriate","that","whenever","a","change","occur","which","may","affect","the compliance","of","a","high","risk","ai system","with","this regulation","change","of","operate","system","or","software architecture","or","when","the","intend","purpose","of","the","system","change","that","ai","system","should","be","consider","to","be","a","new","ai","system","which","should","undergo","a","new","conformity","assessment","however","change","occur","to","the algorithm","and","the performance","of","ai","system","which","continue","to","learn","after","be","place","on","the market","or","put","in