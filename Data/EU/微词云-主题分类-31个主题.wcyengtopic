,"include","the","measure","to","facilitate","the interpretation","of","the","output","of","the ai system","by","the","deployer","transparency","include","the","accompany","instruction","for","use","should","assist","deployer","in","the use","of","the system","and","support","informed decision","make","by","they","deployer","should","inter","alia","be","in","a","well","position","to","make","the correct choice","of","the system","that","they","intend","to","use","in","light","of","the","obligation","applicable","to","they","be","educate","about","the","intend","and","precluded","use","and","use","the ai system","correctly","and","as","appropriate","in","order","to","enhance","legibility","and","accessibility","of","the information","include","in","the","instruction","of","use","where","appropriate","illustrative","example","for","instance","on","the","limitation","and","on","the","intended","and","precluded","use","of","the ai system","should","be","include","provider","should","ensure","that","all documentation","include","the","instruction","for","use","contain","meaningful","comprehensive","accessible","and","understandable","information","take","into","account","the","need","and","foreseeable knowledge","of","the","target","deployer","instruction","for","use","should","be","make","available","in","a","language","which","can","be","easily","understand","by","target","deployer","as","determine","by","the member state","concern"],"unmatched_count":151,"match_length":167,"cut_length":318},{"key":"72","text_words":[null,["73","NUM",""],null,["high","ADJ","high"],null,["risk","NOUN",""],["ai","PROPN",""],["systems","NOUN","system"],["should","AUX",""],["be","AUX",""],["designed","VERB","design"],["and","CCONJ",""],["developed","VERB","develop"],["in","ADP",""],["such","DET",""],["a","DET",""],null,["way","NOUN",""],["that","SCONJ",""],["natural","ADJ",""],["persons","NOUN","person"],["can","AUX",""],["oversee","VERB",""],["their","PRON",""],["functioning","NOUN",""],n