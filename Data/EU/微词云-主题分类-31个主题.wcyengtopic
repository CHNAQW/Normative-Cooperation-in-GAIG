","paragraph","an ai system","refer","annex","iii","consider","high","risk","pose","significant","risk","harm","the health","safety","fundamental","right","natural","person","include","materially","influence","the outcome","decision making"],"words":["by","derogation","from","paragraph","an ai system","refer","to","in","annex","iii","shall","not","be","consider","to","be","high","risk","where","it","do","not","pose","a","significant","risk","of","harm","to","the health","safety","or","fundamental","right","of","natural","person","include","by","not","materially","influence","the outcome","of","decision making"],"unmatched_count":21,"match_length":24,"cut_length":45},{"key":"282","text_words":[["the","DET","the"],["first","ADJ",""],["subparagraph","NOUN",""],["shall","AUX",""],["apply","VERB",""],["where","SCONJ",""],["any","PRON",""],["of","ADP",""],["the","DET",""],["following","VERB","follow"],["conditions","NOUN","condition"],["is","AUX","be"],["fulfilled","VERB","fulfil"],[":","PUNCT",""],["the","DET",""],["ai","PROPN",""],["system","NOUN",""],["is","AUX","be"],["intended","VERB","intend"],["to","PART",""],["perform","VERB",""],["a","DET",""],null,["narrow","ADJ",""],["procedural","ADJ",""],["task","NOUN",""],[";","PUNCT",""],["the","DET",""],["ai","PROPN",""],["system","NOUN",""],["is","AUX","be"],["intended","VERB","intend"],["to","PART",""],["improve","VERB",""],["the","DET",""],["result","NOUN",""],["of","ADP",""],["a","DET",""],null,["previously","ADV",""],["completed","VERB","complete"],["human","ADJ",""],["activity","NOUN",""],[";","PUNCT",""],["the","DET",""],["ai","PROPN",""],["system","NOUN",""],["is","AUX","be"],["intended","VERB","intend"],["to","PART",""],["detect","VERB",""],["decision","NOUN",""],null,["making","VERB","make"],["patterns","NOUN","pattern"],["or","CCONJ",""],["deviations","NOUN","deviation"],["from","ADP",""],["prior","ADJ",""],["decision","NOUN",""],null,["making","VERB","make"],["patterns","NOUN","pattern"],["and","CCONJ",""],["is