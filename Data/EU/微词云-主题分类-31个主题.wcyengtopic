pound=-0.2263,span=It is therefore necessary to exclude from its scope AI systems and models specifically developed and put into service for the sole purpose of scientific research and development.","neg=0.0,neu=0.931,pos=0.069,compound=0.3818,span=Moreover, it is necessary to ensure that this Regulation does not otherwise affect scientific research and development activity on AI systems or models prior to being placed on the market or put into service.","neg=0.0,neu=0.0,pos=0.0,compound=0.0,span=As regards product-oriented research, testing and development activity regarding AI systems or models, the provisions of this Regulation should also not apply prior to those systems and models being put into service or placed on the market.","neg=0.06,neu=0.898,pos=0.043,compound=-0.0253,span=That exclusion is without prejudice to the obligation to comply with this Regulation where an AI system falling into the scope of this Regulation is placed on the market or put into service as a result of such research and development activity and to the application of provisions on AI regulatory sandboxes and testing in real world conditions.","neg=0.039,neu=0.912,pos=0.048,compound=0.1285,span=Furthermore, without prejudice to the exclusion of AI systems specifically developed and put into service for the sole purpose of scientific research and development, any other AI system that may be used for the conduct of any research and development activity should remain subject to the provisions of this Regulation.","neg=0.0,neu=0.912,pos=0.088,compound=0.5106,span=In any event, any research and development activity should be carried out in accordance with recognised ethical and professional standards for scientific research and should be conducted in accordance with applicable Union law."],["This Regulation","innovation","freedom","science","research and development activity","It","its scope AI systems","models","service","the sole purpose","scientific research","development","it","this Regulation","scientific research and development activity","AI systems","models","the market","service","product-oriented research, testing and development activity","AI systems","models","the provisions","this Regulation","those systems","models","service","the market","That exclusion","prejudice","the obligation","this Regulation","an AI system","the scope","this Regulation","the market","service","a result","such research and development activity","the application","provisions","AI regulatory sandboxes","testing","real world conditions","prejudice","the exclusion","AI systems","service","the sole purpose","scientific research","development","any other AI system","that","the conduct","any research and development activity","the provisions","this Regulation","any event","any research and development activity","accordance","recognised ethical and professional standards","scientific research","accordance","applicable Union law"],["",["25","NUM","","CARDINAL",["meta","support"]],"",["This","DET","this","",["det","Regulation"]],["Regulation","PROPN","","",["nsubj","support"]],["should","AUX","","",["aux","support"]],["support","VERB","","",["ROOT","support"],[1.7,""]],["innovation","NOUN","","",["dobj","support"],[1.6,""]],"",["should","AUX","","",["aux","respect"]],["respect","VERB","","",["conj","support"],[2.1,""]],["freedom","NOUN","","",["dobj","respect"],[3.2,""]],["of","ADP","","",["prep","freedom"]],["science","NOUN","","",["pobj","of"]],"",["and","CCONJ","","",["cc","respect"]],["should","AUX","","",["aux","undermine"]],["not","PART","","",["neg","undermine"]],["undermine","VERB","","",["conj","respect"],[0.888,"not undermine"]],["research","NOUN","","",["nmod","activity"]],["and","CCONJ","","",["cc","research"]],["development","NOUN","","",["conj","research"]],["activity","NOUN","","",["dobj","undermine"]],"",["It","PRON","it","",["nsubj","be"]],["is","AUX","be","",["ROOT","be"]],["therefore","ADV","","",["advmod","be"]],["necessary","ADJ","","",["acomp","be"]]