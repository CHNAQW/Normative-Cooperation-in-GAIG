","",["dobj","take"]],["of","ADP","","",["prep","severity"]],["the","DET","","",["det","harm"]],["possible","ADJ","","",["amod","harm"]],["harm","NOUN","","",["pobj","of"],[-2.5,""]],["and","CCONJ","","",["cc","harm"]],["its","PRON","","",["poss","probability"]],["probability","NOUN","","",["conj","harm"]],["of","ADP","","",["prep","probability"]],["occurrence","NOUN","","",["pobj","of"]],["and","CCONJ","","",["cc","pose"]],["they","PRON","","",["nsubjpass","use"]],["are","AUX","be","",["auxpass","use"]],["used","VERB","use","",["conj","pose"]],["in","ADP","","",["prep","use"]],["a","DET","","",["det","number"]],"",["number","NOUN","","",["pobj","in"],[0.3,""]],["of","ADP","","",["prep","number"]],["specifically","ADV","","",["advmod","area"]],["pre","ADJ","","",["amod","area"]],"",["defined","VERB","define","",["amod","area"]],["areas","NOUN","area","",["pobj","of"]],["specified","VERB","specify","",["acl","area"]],["in","ADP","","",["prep","specify"]],["this","DET","","",["det","Regulation"]],["Regulation","PROPN","","",["pobj","in"]],"",["The","DET","the","",["det","identification"]],["identification","NOUN","","",["nsubjpass","base"]],["of","ADP","","",["prep","identification"]],["those","DET","","",["det","system"]],["systems","NOUN","system","",["pobj","of"]],["is","AUX","be","",["auxpass","base"]],["based","VERB","base","",["ROOT","base"]],["on","ADP","","",["prep","base"]],["the","DET","","",["det","methodology"]],["same","ADJ","","",["amod","methodology"]],["methodology","NOUN","","",["pobj","on"]],["and","CCONJ","","",["cc","methodology"]],["criteria","NOUN","criterion","",["conj","methodology"]],["envisaged","VERB","envisage","",["acl","methodology"]],["also","ADV","","",["advmod","envisage"]],["for","ADP","","",["prep","envisage"]],["any","DET","","",["det","amendment"]],["future","ADJ","","",["amod","amendment"]],["amendments","NOUN","amendment","",["pobj","for"]],["of","ADP","","",["prep","amendment"]],["the","DET","","",["det","list"]],["list","NOUN","","",["pobj","of"]],["of","ADP","","",["prep","list"]],["high","ADJ","","",["amod","risk"]],"",["risk","NOUN","","",["compound","system"],[-1.1,""]],["AI","PROPN","","ORG",["compound","system"]],["systems","NOUN","system","",["pobj","of"]],["that","PRON","","",["dobj","adopt"]],["the","DET","","",["det","Commission"]],["Commission","PROPN","","ORG",["nsubjpass","empower"]],["should","AUX","","",["aux","empower"]],["be","AUX","","",["auxpass","empower"]],["empowered","VERB","empower","",["relcl","amendment"]],["to","PART","","",["aux","adopt"]],["adopt","VERB","","",["xcomp","empower"],[0.7,""]],"",["via","ADP","","",["prep","base"]],["delegated","VERB","delegate","",["amod","act"]],["acts","NOUN","act","",["pobj","via"]],"",["to","PART","","",["aux","take"]],["take","VERB","","",["advcl","base"]],["into","ADP","","",["prep","take"]],["account","NOUN","","",["pobj","into"]],["the","DET","","",["det","pace"]],["rapid","ADJ","","",["amod","pace"]],["pace","NOUN","","",["dobj","take"]],["of","ADP","","",["prep","pace"]],["technological","ADJ","","",["amod","development"]],["development","NOUN","","",["pobj","of"]],"",["as","ADV","","",["advmod","as"]],["well","ADV","","",["advmod","as"],[1.1,""]],["as","ADP","","",["cc","pace"]],["the","DET","","",["det","change"]],["potential","ADJ","","",["amod","change"]],["changes","NOUN","change","",["conj","pace"]],["in","ADP","","",["prep","change"]],["the","DET","","",["det","use"]],["use","NOUN","","",["pobj","in"]],["of","ADP","","",["prep","use"]],["AI","PROPN","","ORG",["compound","system"]],["systems","NOUN","system","",["pobj","of"]],""],"neg=0.08,neu=0.863,pos=0.057,compound=-0.3174"],[["neg=0.095,neu=0.738,pos=0.166,compound=0.5439,span=(53) It is also important to clarify that there may be specific cases in which AI systems referred to in pre-defined areas specified in this Regulation do not lead to a significant risk of harm to the legal interests protected under those areas because they do not materially influence the decision-making or do not harm those interests substantially.","neg=0.0,neu=0.0,pos=0.0,compound=0.0,span=For the purposes of this Regulation, an AI system that does not materially influence the outcome of decision-making should be understood to be an AI system that does not have an impact on the substance, and thereby the outcome, of decision-making, whether human or automated.","neg=0.0,neu=0.909,pos=0.091,compound=0.4215,span=An AI system that does not materially influence the outcome of decision-making could include situations in which one or more of the following conditions are fulfilled.","neg=0.0,neu=0.978,pos=0.022,compound=0.0772,span=The first such condition should be that the AI system is intended to perform a narrow procedural task, such as an AI system that transforms unstructured data into structured data, an AI system that classifies incoming documents into categories or an AI system that is used to detect duplicates among a large number of applications.","neg=0.189,neu=0.811,pos=0.0,compound=-0.7791,span=Those tasks are of such narrow and limited nature that they pose only limited risks which are not increased through the use of an AI system in a context that is listed as a high-risk use in an annex to this Regulation.","neg=0.042,neu=0.9,pos=0.058,compound=0.2023,span=The second condition should be that the task performed by the AI system is intended to improve the result of a previously completed human activity that may be relevant for the purposes of the high-risk uses listed in an annex to this Regulation.","neg=0.153,neu=0.847,pos=0.0,compound=-0.3818,span=Considering those characteristics, the AI system provides only an additional layer to a human activity with consequently lowered risk.","neg=0.0,neu=0.9,pos=0.1,compound=0.6124,span=That condition would, for example, apply to AI systems that are intended to improve the language used in previously drafted documents, for example in relation to professional tone, academic style of language or by aligning text to a certain brand messaging.","neg=0.0,neu=0.0,pos=0.0,compound=0.0,span=The third condition should be that the AI system is intended to detect decision-making patterns or deviations from prior decision-making patterns.","neg=0.101,neu=0.899,pos=0.0,compound=-0.3818,span=The risk would be lowered because the use of the AI system follows a previously completed human assessment which it is not meant to replace or influence, without proper human review.","neg=0.0,neu=0.957,pos=0.043,compound=0.2732,span=Such AI systems include for instance those that, given a certain grading pattern of a teacher, can be used to check ex post whether the teacher may have deviated from the grading pattern so as to flag potential inconsistencies or anomalies.","neg=0.067,neu=0.933,pos=0.0,compound=-0.5413,span=The fourth condition should be that the AI system is intended to perform a task that is only preparatory to an assessment relevant for the purposes of the AI systems listed in an annex to this Regulation, thus making the possible impact of the output of the system very low in terms of representing a risk for the assessment to follow.","neg=0.0,neu=0.905,pos=0.095,compound=0.5267,span=That condition covers, inter alia, smart solutions for file handling, which include various functions from indexing, searching, text and speech processing or linking data to other data sources, or AI systems used for translation of initial documents.","neg=0.076,neu=0.879,pos=0.045,compound=-0.4767,span=In any case, AI systems used in high-risk use-cases listed in an annex to this Regulation should be considered to pose significant risks of harm to the health, safety or fundamental rights if the AI system implies profiling within the meaning of Article 4, point (4) of Regulation (EU) 2016/679 or Article 3, point (4) of Directive (EU) 2016/680 or Article 3, point (5) of Regulation (EU) 2018/1725.","neg=0.0,neu=0.895,pos=0.105,compound=0.6921,span=To ensure traceability and transparency, a provider who considers that an AI system is not high-risk on the basis of the conditions referred to above should draw up documentation of the assessment before that system is placed on the market or put into service and should provide that documentation to national competent authorities upon request.","neg=0.0,neu=0.0,pos=0.0,compound=0.0,span=Such a provider should be obliged to register the AI system in the EU database established under this Regulation.","neg=0.049,neu=0.928,pos=0.023,compound=-0.296,span=With a view to providing further guidance for the practical implementation of the conditions under which the AI systems listed in an annex to this Regulation are, on an exceptional basis, non-high-risk, the Commission should, after consulting the Board, provide guidelines specifying that practical implementation, completed by a comprehensive list of practical examples of use cases of AI systems that are high-risk and use cases that are not."],["It","specific cases","which","AI systems","pre-defined areas","this Regulation","a significant risk","harm","the legal interests","those areas","they","the decision-making","those interests","the purposes","this Regulation","an AI system","that","the outcome","decision-making","an AI system","that","an impact","the substance","thereby the outcome","decision-making","An AI system","that","the outcome","decision-making","situations","which","the following conditions","The first such condition","the AI system","a narrow procedural task","an AI system","that","unstructured data","structured data","an AI system","that","documents","categories","an AI system","that","duplicates","a large number","applications","Those tasks","such narrow and limited nature","they","only limited risks","which","the use","an AI system","a context","that","a high-risk use","an annex","this Regulation","The second condition","the task","the AI system","the result","a previously completed human activity","that","the purposes","the high-risk uses","