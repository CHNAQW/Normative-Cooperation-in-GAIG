m","NOUN",""],["in","ADP",""],["publicly","ADV",""],["accessible","ADJ",""],["spaces","NOUN","space"],["shall","AUX",""],["be","AUX",""],["authorised","VERB","authorise"],["only","ADV",""],["if","SCONJ",""],["the","DET",""],["law","NOUN",""],["enforcement","NOUN",""],["authority","NOUN",""],["has","AUX","have"],["completed","VERB","complete"],["a","DET",""],null,["fundamental","ADJ",""],["rights","NOUN","right"],["impact","NOUN",""],["assessment","NOUN",""],["as","SCONJ",""],["provided","VERB","provide"],["for","ADP",""],["in","ADP",""],["article","PROPN",""],null,["27","NUM",""],["and","CCONJ",""],["has","AUX","have"],["registered","VERB","register"],["the","DET",""],["system","NOUN",""],["in","ADP",""],["the","DET",""],["eu","PROPN",""],["database","NOUN",""],["according","VERB","accord"],["to","ADP",""],["article","PROPN",""],null,["49","NUM",""],null,["however","ADV","however"],null,["in","ADP",""],["duly","ADV",""],["justified","VERB","justify"],["cases","NOUN","case"],["of","ADP",""],["urgency","NOUN",""],null,["the","DET",""],["use","NOUN",""],["of","ADP",""],["such","ADJ",""],["systems","NOUN","system"],["may","AUX",""],["be","AUX",""],["commenced","VERB","commence"],["without","ADP",""],["the","DET",""],["registration","NOUN",""],["in","ADP",""],["the","DET",""],["eu","PROPN",""],["database","NOUN",""],null,["provided","VERB","provide"],["that","SCONJ",""],["such","ADJ",""],["registration","NOUN",""],["is","AUX","be"],["completed","VERB","complete"],["without","ADP",""],["undue","ADJ",""],["delay","NOUN",""],null],"text":"In addition, the use of ‘real-time’ remote biometric identification systems in publicly accessible spaces for the purposes of law enforcement for any of the objectives referred to in paragraph 1, first subparagraph, point (h), of this Article shall comply with necessary and proportionate safeguards and conditions in relation to the use in accordance with the national law authorising the use thereof, in particular as regards the temporal, geographic and personal limitations.The use of the ‘real-time’ remote biometric identification system in publicly accessible spaces shall be authorised only if the law enforcement authority has completed a fundamental rights impact assessment as provided for in Article 27 and has registered the system in the EU database according to Article 49.However, in duly justified cases of urgency, the use of such systems may be commenced without the registration in the EU database, provided that such registration is completed without undue delay.","idx":269,"match_words":["addition","the use","real","time","remote","biometric","identification","system","publicly","accessible","space","purpose","law enforcement","objective","refer","paragraph","first subparagraph","point","this article","comply","necessary","proportionate","safeguard","condition","relation","the use","accordance","the national law","authorise","the use","thereof","particular","regard","temporal","geographic","personal","limitation","the use","real","time","remote","biometric","identification","system","publicly","accessible","space","authorise","only","the law enforcement authority","have","complete","fundamental","right","impact","assessment","provide","article","have","register","the system","the eu database","accord","article","however","duly","justify","case","urgency","the use","such","system","may","commence","the registration","the eu database","provide","such registration","complete","undue delay"],"words":["in","addition","the use","of","real","time","remote","biometric","identification","system","in","publicly","accessible","space","for","the","purpose","of","law enforcement","for","any","of","the","objective","refer","to","in","paragraph","first subparagraph","point","h","of","this article","shall","comply","with","necessary","and","proportionate","safeguard","and","condition","in","relation","to","the use","in","accordance","with","the national law","authorise","the use","thereof","in","particular",