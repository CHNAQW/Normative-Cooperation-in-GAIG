,compound=0.3818,span=Deployers should in particular take appropriate technical and organisational measures to ensure they use high-risk AI systems in accordance with the instructions of use and certain other obligations should be provided for with regard to monitoring of the functioning of the AI systems and with regard to record-keeping, as appropriate.","neg=0.0,neu=0.884,pos=0.116,compound=0.5859,span=Furthermore, deployers should ensure that the persons assigned to implement the instructions for use and human oversight as set out in this Regulation have the necessary competence, in particular an adequate level of AI literacy, training and authority to properly fulfil those tasks.","neg=0.078,neu=0.821,pos=0.101,compound=0.1536,span=Those obligations should be without prejudice to other deployer obligations in relation to high-risk AI systems under Union or national law."],["the nature","AI systems","the risks","safety and fundamental rights","their use","the need","proper monitoring","the performance","an AI system","a real-life setting","it","specific responsibilities","deployers","Deployers","appropriate technical and organisational measures","they","high-risk AI systems","accordance","the instructions","use","certain other obligations","regard","monitoring","the functioning","the AI systems","regard","record-keeping","deployers","the persons","the instructions","use","human oversight","this Regulation","the necessary competence","in particular an adequate level","AI literacy","training","authority","those tasks","Those obligations","prejudice","other deployer obligations","relation","high-risk AI systems","Union","national law"],["",["91","NUM","","CARDINAL",["dep","be"]],"",["Given","VERB","give","",["prep","91"]],["the","DET","","",["det","nature"]],["nature","NOUN","","",["pobj","give"]],["of","ADP","","",["prep","nature"]],["AI","PROPN","","ORG",["compound","system"]],["systems","NOUN","system","",["pobj","of"]],["and","CCONJ","","",["cc","system"]],["th