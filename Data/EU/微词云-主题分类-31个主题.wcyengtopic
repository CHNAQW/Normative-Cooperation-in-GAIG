to public interests and fundamental rights that are protected by Union law.Such harm might be material or immaterial, including physical, psychological, societal or economic harm.","idx":4,"match_words":["the same time","depend","circumstance","regard","its specific application","use","level","technological development","may","generate","risk","cause","harm","public","interest","fundamental","right","protect","union law","such harm","material","include","physical","psychological","societal","economic","harm"],"words":["at","the same time","depend","on","the","circumstance","regard","its specific application","use","and","level","of","technological development","ai","may","generate","risk","and","cause","harm","to","public","interest","and","fundamental","right","that","be","protect","by","union law","such harm","might","be","material","or","immaterial","include","physical","psychological","societal","or","economic","harm"],"unmatched_count":17,"match_length":27,"cut_length":44},{"key":"5","text_words":[null,["6","NUM",""],null,["given","VERB","give"],["the","DET",""],["major","ADJ",""],["impact","NOUN",""],["that","PRON",""],["ai","PROPN",""],["can","AUX",""],["have","VERB",""],["on","ADP",""],["society","NOUN",""],["and","CCONJ",""],["the","DET",""],["need","NOUN",""],["to","PART",""],["build","VERB",""],["trust","NOUN",""],null,["it","PRON",""],["is","AUX","be"],["vital","ADJ",""],["for","ADP",""],["ai","PROPN",""],["and","CCONJ",""],["its","PRON",""],["regulatory","ADJ",""],["framework","NOUN",""],["to","PART",""],["be","AUX",""],["developed","VERB","develop"],["in","ADP",""],["accordance","NOUN",""],["with","ADP",""],["union","PROPN",""],["values","NOUN","value"],["as","SCONJ",""],["enshrined","VERB","enshrine"],["in","ADP",""],["article","NOUN","article"],null,["2","NUM",""],["of","ADP",""],["the","DET",""],["treaty","PROPN",""],["on","ADP",""],["european","PROPN",""],["union","PROPN",""],null,["teu","PROPN",""],null,null,["the","DET",""],["fundamental","ADJ","