,"satisfy"]],["satisfy","VERB","","",["xcomp","continue"],[2,""]],["the","DET","","",["det","requirement"]],["requirements","NOUN","requirement","",["dobj","satisfy"]],["referred","VERB","refer","",["acl","requirement"]],["to","ADP","","",["prep","refer"]],["in","ADP","","",["prep","refer"]],["point","NOUN","","",["pobj","in"]],["3.2","NUM","","CARDINAL",["nummod","point"]],["or","CCONJ","","",["cc","point"]],["whether","SCONJ","","",["mark","be"]],["a","DET","","",["det","reassessment"]],"",["reassessment","NOUN","","",["nsubj","be"]],["is","AUX","be","",["ccomp","decide"]],["necessary","ADJ","","",["acomp","be"]],""],"neg=0.0,neu=0.925,pos=0.075,compound=0.4588"],[["neg=0.0,neu=0.0,pos=0.0,compound=0.0,span=The notified body shall notify the provider of its decision.","neg=0.0,neu=0.0,pos=0.0,compound=0.0,span=The notification shall contain the conclusions of the examination of the changes and the reasoned assessment decision."],["The notified body","the provider","its decision","The notification","the conclusions","the examination","the changes","the reasoned assessment decision"],[["The","DET","the","",["det","body"]],["notified","VERB","notify","",["amod","body"]],["body","NOUN","","",["nsubj","notify"]],["shall","AUX","","",["aux","notify"]],["notify","VERB","","",["ROOT","notify"]],["the","DET","","",["det","provider"]],["provider","NOUN","","",["dobj","notify"]],["of","ADP","","",["prep","provider"]],["its","PRON","","",["poss","decision"]],["decision","NOUN","","",["pobj","of"]],"",["The","DET","the","",["det","notification"]],["notification","NOUN","","",["nsubj","contain"]],["shall","AUX","","",["aux","contain"]],["contain","VERB","","",["ROOT","contain"]],["the","DET","","",["det","conclusion"]],["conclusions","NOUN","conclusion","",["dobj","contain"]],["of","ADP","","",["prep","conclusion"]],["the","DET","","",["det","examination"]],["examination","NOUN","","",["pobj","of"]],["of","ADP","","",["prep","examination"]],["the","DET","","",["det","change"]],["changes","NOUN","change","",["pobj","of"]],["and","CCONJ","","",["cc","change"]],["the","DET","","",["det","decision"]],["reasoned","VERB","reason","",["amod","decision"]],["assessment","NOUN","","",["compound","decision"]],["decision","NOUN","","",["conj","change"]],""],"neg=0.0,neu=0.0,pos=0.0,compound=0.0"],[["neg=0.0,neu=0.0,pos=0.0,compound=0.0,span=4. Control of the technical documentation.","neg=0.0,neu=0.0,pos=0.0,compound=0.0,span=In addition to the application referred to in point 3, an application with a notified body of their choice shall be lodged by the provider for the assessment of the technical documentation relating to the AI system which the provider intends to place on the market or put into service and which is covered by the quality management system referred to under point 3.The application shall include: the name and address of the provider; a written declaration that the same application has not been lodged with any other notified body; the technical documentation referred to in Annex IV.","neg=0.0,neu=0.0,pos=0.0,compound=0.0,span=The technical documentation shall be examined by the notified body.","neg=0.031,neu=0.859,pos=0.11,compound=0.5994,span=Where relevant, and limited to what is necessary to fulfil its tasks, the notified body shall be granted full access to the training, validation, and testing data sets used, including, where appropriate and subject to security safeguards, through API or other relevant technical means and tools enabling remote access.","neg=0.0,neu=0.0,pos=0.0,compound=0.0,span=In examining the technical documentation, the notified body may require that the provider supply further evidence or carry out further tests so as to enable a proper assessment of the conformity of the AI system with the requirements set out in Chapter III, Section 2.","neg=0.072,neu=0.869,pos=0.059,compound=-0.1109,span=Where the notified body is not satisfied with the tests carried out by the provider, the notified body shall itself directly carry out adequate tests, as appropriate.","neg=0.058,neu=0.917,pos=0.025,compound=-0.3818,span=Where necessary to assess the conformity of the high-risk AI system with the requirements set out in Chapter III, Section 2, after all other reasonable means to verify conformity have been exhausted and have proven to be insufficient, and upon a reasoned request, the notified body shall also be granted access to the training and trained models of the AI system, including its relevant parameters.","neg=0.0,neu=0.845,pos=0.155,compound=0.5106,span=Such access shall be subject to existing Union law on the protection of intellectual property and trade secrets.","neg=0.0,neu=0.0,pos=0.0,compound=0.0,span=The decision of the notified body shall be notified to the provider or its authorised representative.","neg=0.0,neu=0.0,pos=0.0,compound=0.0,span=The notification shall contain the conclusions of the assessment of the technical documentation and the reasoned assessment decision.","neg=0.0,neu=0.0,pos=0.0,compound=0.0,span=Where the AI system is in conformity with the requirements set out in Chapter III, Section 2, the notified body shall issue a Union technical documentation assessment certificate.","neg=0.0,neu=0.0,pos=0.0,compound=0.0,span=The certificate shall indicate the name and address of the provider, the conclusions of the examination, the conditions (if any) for its validity and the data necessary for the identification of the AI system.","neg=0.0,neu=0.905,pos=0.095,compound=0.4215,span=The certificate and its annexes shall contain all relevant information to allow the conformity of the AI system to be evaluated, and to allow for control of the AI system while in use, where applicable.","neg=0.042,neu=0.913,pos=0.046,compound=0.0516,span=Where the AI system is not in conformity with the requirements set out in Chapter III, Section 2, the notified body shall refuse to issue a Union technical documentation assessment certificate and shall inform the applicant accordingly, giving detailed reasons for its refusal.","neg=0.0,neu=0.0,pos=0.0,compound=0.0,span=Where the AI system does not meet the requirement relating to the data used to train it, re-training of the AI system will be needed prior to the application for a new conformity assessment.","neg=0.057,neu=0.943,pos=0.0,compound=-0.4019,span=In this case, the reasoned assessment decision of the notified body refusing to issue the Union technical documentation assessment certificate shall contain specific considerations on the quality data used to train the AI system, in particular on the reasons for non-compliance.","neg=0.0,neu=0.0,pos=0.0,compound=0.0,span=Any change to the AI system that could affect the compliance of the AI system with the requirements or its intended purpose shall be assessed by the notified body which issued the Union technical documentation assessment certificate.","neg=0.0,neu=0.0,pos=0.0,compound=0.0,span=The provider shall inform such notified body of its intention to introduce any of the abovementioned changes, or if it otherwise becomes aware of the occurrence of such changes.","neg=0.0,neu=0.0,pos=0.0,compound=0.0,span=The intended changes shall be assessed by the notified body, which shall decide whether those changes require a new conformity assessment in accordance with Article 43(4) or whether they could be addressed by means of a supplement to the Union technical documentation assessment certificate.","neg=0.0,neu=0.936,pos=0.064,compound=0.4215,span=In the latter case, the notified body shall assess the changes, notify the provider of its decision and, where the changes are approved, issue to the provider a supplement to the Union technical documentation assessment certificate."],["4. Control","the technical documentation","addition","the application","point","an application","a notified body","their choice","the provider","the assessment","the technical documentation","the AI system","which","the provider","the market","service","whic