,["risk","NOUN",""],["and","CCONJ",""],["not","PART",""],["high","ADJ",""],null,["risk","NOUN",""],null],"text":"5.The Commission shall, after consulting the European Artificial Intelligence Board (the ‘Board’), and no later than 2 February 2026, provide guidelines specifying the practical implementation of this Article in line with Article 96 together with a comprehensive list of practical examples of use cases of AI systems that are high-risk and not high-risk.","idx":284,"match_words":["the commission","consult","the european artificial intelligence board","board","later","february","provide","guideline","specify","the practical implementation","this article","line","article","together","comprehensive","list","practical","example","use","case","system","high","risk","high","risk"],"words":["the commission","shall","after","consult","the european artificial intelligence board","the","board","and","no","later","than","february","provide","guideline","specify","the practical implementation","of","this article","in","line","with","article","together","with","a","comprehensive","list","of","practical","example","of","use","case","of","ai","system","that","be","high","risk","and","not","high","risk"],"unmatched_count":19,"match_length":25,"cut_length":44},{"key":"286","text_words":[["6","X",""],null,["the","DET","the"],["commission","PROPN",""],["is","AUX","be"],["empowered","VERB","empower"],["to","PART",""],["adopt","VERB",""],["delegated","VERB","delegate"],["acts","NOUN","act"],["in","ADP",""],["accordance","NOUN",""],["with","ADP",""],["article","PROPN",""],null,["97","NUM",""],["in","ADP",""],["order","NOUN",""],["to","PART",""],["amend","VERB",""],["paragraph","NOUN",""],null,["3","NUM",""],null,["second","ADJ",""],["subparagraph","NOUN",""],null,["of","ADP",""],["this","DET",""],["article","NOUN","article"],["by","ADP",""],["adding","VERB","add"],["new","ADJ",""],["conditions","NOUN","condition"],["to","ADP",""],["those","PRON",""],["laid","VERB","lay"],["down"