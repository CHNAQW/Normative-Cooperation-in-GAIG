in an appropriate manner that does not hamper the display or enjoyment of the work.","idx":554,"match_words":["deployer","an ai system","generate","manipulate","image","audio","video","content","constitute","deep","fake","disclose","the content","have","artificially","generate","manipulate","this obligation","apply","the use","authorise","law","detect","prevent","investigate","prosecute","criminal offence","the content","form","part","creative","work","programme","transparency","obligation","set","out","this paragraph","limit","disclosure","the existence","such","manipulate","content","an appropriate manner","hamper","the display","enjoyment","the work"],"words":["deployer","of","an ai system","that","generate","or","manipulate","image","audio","or","video","content","constitute","a","deep","fake","shall","disclose","that","the content","have","be","artificially","generate","or","manipulate","this obligation","shall","not","apply","where","the use","be","authorise","by","law","to","detect","prevent","investigate","or","prosecute","criminal offence","where","the content","form","part","of","an","evidently","artistic","creative","satirical","fictional","or","analogous","work","or","programme","the","transparency","obligation","set","out","in","this paragraph","be","limit","to","disclosure","of","the existence","of","such","generated","or","manipulate","content","in","an appropriate manner","that","do","not","hamper","the display","or","enjoyment","of","the work"],"unmatched_count":40,"match_length":49,"cut_length":89},{"key":"565","text_words":[["deployers","NOUN","deployer"],["of","ADP",""],["an","DET",""],["ai","PROPN",""],["system","NOUN",""],["that","PRON",""],["generates","VERB","generate"],["or","CCONJ",""],["manipulates","VERB","manipulate"],["text","NOUN",""],["which","PRON",""],["is","AUX","be"],["published","VERB","publish"],["with","ADP",""],["the","DET",""],["purpose","NOUN",""],["of","ADP",""],["informing","VERB","inform"],["the","DET",""],["public","NOUN