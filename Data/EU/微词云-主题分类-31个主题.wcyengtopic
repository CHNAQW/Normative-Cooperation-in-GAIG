["those","DET",""],["data","NOUN","datum"],["sets","NOUN","set"],null,["in","ADP",""],["a","DET",""],null,["privacy","NOUN",""],null,["preserving","ADJ",""],null,["secure","ADJ",""],null,["timely","ADJ",""],null,["transparent","ADJ",""],["and","CCONJ",""],["trustworthy","ADJ",""],["manner","NOUN",""],null,["and","CCONJ",""],["with","ADP",""],["an","DET",""],["appropriate","ADJ",""],["institutional","ADJ",""],["governance","NOUN",""],null,["relevant","ADJ","relevant"],["competent","ADJ",""],["authorities","NOUN","authority"],null,["including","VERB","include"],["sectoral","ADJ",""],["ones","NOUN","one"],null,["providing","VERB","provide"],["or","CCONJ",""],["supporting","VERB","support"],["the","DET",""],["access","NOUN",""],["to","ADP",""],["data","NOUN","datum"],["may","AUX",""],["also","ADV",""],["support","VERB",""],["the","DET",""],["provision","NOUN",""],["of","ADP",""],["high","ADJ",""],null,["quality","NOUN",""],["data","NOUN","datum"],["for","ADP",""],["the","DET",""],["training","NOUN",""],null,["validation","NOUN",""],["and","CCONJ",""],["testing","NOUN",""],["of","ADP",""],["ai","PROPN",""],["systems","NOUN","system"],null],"text":"(68) For the development and assessment of high-risk AI systems, certain actors, such as providers, notified bodies and other relevant entities, such as European Digital Innovation Hubs, testing experimentation facilities and researchers, should be able to access and use high-quality data sets within the fields of activities of those actors which are related to this Regulation.European common data spaces established by the Commission and the facilitation of data sharing between businesses and with government in the public interest will be instrumental to provide trustful, accountable and non-discriminatory access to high-quality data for the training, validation and testing of AI systems.For example, in health, the European health data space will facilitate non-discriminatory access to health data and the training of AI algorithms on those data sets, in a privacy-preserving, secure, timely, transparent and trustworthy manner, and with an appropriate institutional governance.Relevant competent authorities, including sectoral ones, providing or supporting the access to data may also support the provision of high-quality data for the training, validation and testing of AI systems.","idx":67,"match_words":["the development","assessment","high","risk","system","certain","actor","such","provider","notify","body","other","relevant","entity","such","european digital innovation hubs","testing","experimentation","facility","able","access","use","high","quality","data","set","field","activity","actor","relate","this regulation","european","common","datum","space","establish","the commission","the facilitation","datum","sharing","business","the public interest","will","provide","non","discriminatory","access","high","quality","datum","the training","validation","testing","system","example","health","european","health","datum","space","will","facilitate","non","discriminatory","access","health","datum","the training","algorithm","datum","set","privacy","secure","timely","transparent","trustworthy","manner","an appropriate institutional governance","relevant","competent","authority","include","sectoral","one","provide","support","the access","datum","may","also","support","the provision","high","quality","datum","the training","validation","testing","system"],"words":["for","the development","and","assessment","of","high","risk","ai","system","certain","actor","such","as","provider","notify","body","and","other","relevant","entity","such","as","european digital innovation hubs","testing","experimentation","facility","and","researcher","should","be","able","to","access","and","use","high","quality","data","set","within","the","field","of","activity","of","those","actor","which","be","relate","to","this regulation","european","common","datum","space","establish","by","the commission","and","the facilitat