"NOUN",""],["in","ADP",""],["the","DET",""],["field","NOUN",""],["of","ADP",""],["ai","PROPN",""],null],"text":"3. The Commission shall appoint the members of the advisory forum, in accordance with the criteria set out in paragraph 2, from amongst stakeholders with recognised expertise in the field of AI.","idx":670,"match_words":["the commission","appoint","member","the advisory forum","accordance","criterion","set","out","paragraph","stakeholder","recognise","expertise","the field"],"words":["the commission","shall","appoint","the","member","of","the advisory forum","in","accordance","with","the","criterion","set","out","in","paragraph","from","amongst","stakeholder","with","recognise","expertise","in","the field","of","ai"],"unmatched_count":13,"match_length":13,"cut_length":26},{"key":"684","text_words":[["4","X",""],null,["the","DET","the"],["term","NOUN",""],["of","ADP",""],["office","NOUN",""],["of","ADP",""],["the","DET",""],["members","NOUN","member"],["of","ADP",""],["the","DET",""],["advisory","ADJ",""],["forum","NOUN",""],["shall","AUX",""],["be","AUX",""],["two","NUM",""],["years","NOUN","year"],null,["which","PRON",""],["may","AUX",""],["be","AUX",""],["extended","VERB","extend"],["by","ADP",""],["up","ADP",""],["to","PART",""],["no","DET",""],["more","ADJ",""],["than","ADP",""],["four","NUM",""],["years","NOUN","year"],null],"text":"4. The term of office of the members of the advisory forum shall be two years, which may be extended by up to no more than four years.","idx":671,"match_words":["the term","office","member","the advisory forum","year","may","extend","more","year"],"words":["the term","of","office","of","the","member","of","the advisory forum","shall","be","year","which","may","be","extend","by","up","to","no","more","than","year"],"unmatched_count":13,"match_length":9,"cut_length":22},{"key":"685","text_words":[["5","X",""],null,["the","DET","the"],["fundamental","PROPN",""],["rights","PROPN",""],["agency","PROPN",""],null,["enisa","PROPN"