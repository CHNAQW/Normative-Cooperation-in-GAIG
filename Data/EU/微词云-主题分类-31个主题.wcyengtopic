ated","VERB","generate"],["or","CCONJ",""],["manipulated","VERB","manipulate"],null,["providers","NOUN","provider"],["shall","AUX",""],["ensure","VERB",""],["their","PRON",""],["technical","ADJ",""],["solutions","NOUN","solution"],["are","AUX","be"],["effective","ADJ",""],null,["interoperable","ADJ",""],null,["robust","ADJ",""],["and","CCONJ",""],["reliable","ADJ",""],["as","ADV",""],["far","ADV",""],["as","SCONJ",""],["this","PRON",""],["is","AUX","be"],["technically","ADV",""],["feasible","ADJ",""],null,["taking","VERB","take"],["into","ADP",""],["account","NOUN",""],["the","DET",""],["specificities","NOUN","specificity"],["and","CCONJ",""],["limitations","NOUN","limitation"],["of","ADP",""],["various","ADJ",""],["types","NOUN","type"],["of","ADP",""],["content","NOUN",""],null,["the","DET",""],["costs","NOUN","cost"],["of","ADP",""],["implementation","NOUN",""],["and","CCONJ",""],["the","DET",""],["generally","ADV",""],["acknowledged","VERB","acknowledge"],["state","NOUN",""],["of","ADP",""],["the","DET",""],["art","NOUN",""],null,["as","SCONJ",""],["may","AUX",""],["be","AUX",""],["reflected","VERB","reflect"],["in","ADP",""],["relevant","ADJ",""],["technical","ADJ",""],["standards","NOUN","standard"],null,["this","DET","this"],["obligation","NOUN",""],["shall","AUX",""],["not","PART",""],["apply","VERB",""],["to","ADP",""],["the","DET",""],["extent","NOUN",""],["the","DET",""],["ai","PROPN",""],["systems","NOUN","system"],["perform","VERB",""],["an","DET",""],["assistive","ADJ",""],["function","NOUN",""],["for","ADP",""],["standard","ADJ",""],["editing","NOUN",""],["or","CCONJ",""],["do","AUX",""],["not","PART",""],["substantially","ADV",""],["alter","VERB",""],["the","DET",""],["input","NOUN",""],["data","NOUN","datum"],["provided","VERB","provide"],["by","ADP",""],["the","DET",""],["deployer","NOUN",""],["or","CCONJ",""],["the","DET",""],["semantics","NOUN","semantic"],["thereof","ADV",""],null,["or","CCONJ",""],["where","SCONJ",""],["authorised","VERB","authorise"],["by","ADP",""],["law","NOUN",""],["to","PART",""],["detect","VERB",""],null,["prevent","NOUN",""],null,["investigate","VERB",""],["or","CCONJ",""],["prosecute","VERB",""],["criminal","ADJ",""],["offences","NOUN","offence"],null],"text":"2. Providers of AI systems, including general-purpose AI systems, generating synthetic audio, image, video or text content, shall ensure that the outputs of the AI system are marked in a machine-readable format and detectable as artificially generated or manipulated.Providers shall ensure their technical solutions are effective, interoperable, robust and reliable as far as this is technically feasible, taking into account the specificities and limitations of various types of content, the costs of implementation and the generally acknowledged state of the art, as may be reflected in relevant technical standards.This obligation shall not apply to the extent the AI systems perform an assistive function for standard editing or do not substantially alter the input data provided by the deployer or the semantics thereof, or where authorised by law to detect, prevent, investigate or prosecute criminal offences.","idx":552,"match_words":["system","include","general","purpose","system","generate","synthetic","audio","image","video","text content","ensure","output","the ai system","mark","machine","readable","format","artificially","generate","manipulate","provider","ensure","technical","solution","effective","robust","reliable","far","technically","feasible","take","account","specificity","limitation","various","type","content","cost","implementation","generally","acknowledge","state","the art","may","reflect","relevant","technical","standard","this obligation","apply","the extent","system","perform","an assistive function","standard editing","substantially","alter","input","datum","provide","the deployer","semantic","thereof","authorise","law","detect","prevent","investigate","prosecute","criminal","offence"],"words":["providers","of","ai","system","include","general","purpose","ai","system","generate","synthetic","audio","image","video","or","text content","shall","ensure","that","the","output","of","the ai system","be","mark","in","a","machine","readable","format","and","detectable","as","artificially","generate","or","manipulate","provider","shall","ensure","their","technical","solution","be","effective","interoperable","robust","and","reliable","as","far","as","this","be","technically","feasible","take","into","account","the","specificity","and","limitation","of","various","type","of","content","the","cost","of","implementation","and","the","generally","acknowledge","state","of","the art","as","may","be","reflect","in","relevant","technical","standard","this obligation","shall","not","apply","to","the extent","the","ai","system","perform","an assistive function","for","standard editing","or","do","not","substantially","alter","the","input","datum","provide","by","the deployer","or","the","semantic","thereof","or","where","authorise","by","law","to","detect","prevent","investigate","or","prosecute","criminal","offence"],"unmatched_count":56,"match_length":72,"cut_length":128},{"key":"563","text_words":[["3","X",""],null,["deployers","NOUN","deployer"],["of","ADP",""],["an","DET",""],["emotion","NOUN",""],["recognition","NOUN",""],["system","NOUN",""],["or","CCONJ",""],["a","DET",""],null,["biometric","ADJ",""],["categorisation","NOUN",""],["system","NOUN",""],["shall","AUX",""],["inform","VERB",""],["the","DET",""],["natural","ADJ",""],["persons","NOUN","person"],["exposed","VERB","expose"],["thereto","NOUN",""],["of","ADP",""],["the","DET",""],["operation","NOUN",""],["of","ADP",""],["the","DET",""],["system","NOUN",""],null,["and","CCONJ",""],["shall","AUX",""],["process","VERB",""],["the","DET",""],["personal","ADJ",""],["data","NOUN","datum"],["in","ADP",""],["accordance","NOUN",""],["with","ADP",""],["regulations","PROPN",""],null,["eu","PROPN",""],null,["2016/679","NOUN",""],["and","CC