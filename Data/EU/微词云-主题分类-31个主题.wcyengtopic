T",""],["implement","VERB",""],["the","DET",""],["instructions","NOUN","instruction"],["for","ADP",""],["use","NOUN",""],["and","CCONJ",""],["human","ADJ",""],["oversight","NOUN",""],["as","SCONJ",""],["set","VERB",""],["out","ADP",""],["in","ADP",""],["this","DET",""],["regulation","PROPN",""],["have","VERB",""],["the","DET",""],["necessary","ADJ",""],["competence","NOUN",""],null,["in","ADP",""],["particular","ADJ",""],["an","DET",""],["adequate","ADJ",""],["level","NOUN",""],["of","ADP",""],["ai","PROPN",""],["literacy","NOUN",""],null,["training","NOUN",""],["and","CCONJ",""],["authority","NOUN",""],["to","PART",""],["properly","ADV",""],["fulfil","VERB",""],["those","DET",""],["tasks","NOUN","task"],null,["those","DET","those"],["obligations","NOUN","obligation"],["should","AUX",""],["be","AUX",""],["without","ADP",""],["prejudice","NOUN",""],["to","ADP",""],["other","ADJ",""],["deployer","NOUN",""],["obligations","NOUN","obligation"],["in","ADP",""],["relation","NOUN",""],["to","ADP",""],["high","ADJ",""],null,["risk","NOUN",""],["ai","PROPN",""],["systems","NOUN","system"],["under","ADP",""],["union","PROPN",""],["or","CCONJ",""],["national","ADJ",""],["law","NOUN",""],null],"text":"(91) Given the nature of AI systems and the risks to safety and fundamental rights possibly associated with their use, including as regards the need to ensure proper monitoring of the performance of an AI system in a real-life setting, it is appropriate to set specific responsibilities for deployers.Deployers should in particular take appropriate technical and organisational measures to ensure they use high-risk AI systems in accordance with the instructions of use and certain other obligations should be provided for with regard to monitoring of the functioning of the AI systems and with regard to record-keeping, as appropriate.Furthermore, deployers should ensure that the persons assigned to implement the instructions for use and human oversight as set out in this Regulation have the necessary competence, in particular an adequate level of AI literacy, training and authority to properly fulfil those tasks.Those obligations should be without prejudice to other deployer obligations in relation to high-risk AI systems under Union or national law.","idx":90,"match_words":["give","the nature","system","risk","safety","fundamental","right","possibly","associate","their use","include","regard","the need","ensure","proper monitoring","the performance","an ai system","real","life","setting","appropriate","set","specific","responsibility","deployer","deployer","particular","take","appropriate","technical","organisational","measure","ensure","use","high","risk","system","accordance","instruction","use","certain","other","obligation","provide","regard","monitoring","the functioning","system","regard","record","keeping","appropriate","furthermore","deployer","ensure","person","assign","implement","instruction","use","human oversight","set","out","this regulation","have","the necessary competence","in particular an adequate level","ai literacy","training","authority","properly","fulfil","task","obligation","prejudice","other","deployer","obligation","relation","high","risk","system","union","national law"],"words":["give","the nature","of","ai","system","and","the","risk","to","safety","and","fundamental","right","possibly","associate","with","their use","include","as","regard","the need","to","ensure","proper monitoring","of","the performance","of","an ai system","in","a","real","life","setting","it","be","appropriate","to","set","specific","responsibility","for","deployer","deployer","should","in","particular","take","appropriate","technical","and","organisational","measure","to","ensure","they","use","high","risk","ai","system","in","accordance","with","the","instruction","of","use","and","certain","other","obligation","should","be","provide","for","with","regard","to","monitoring","of","the functioning","of","the","ai","system","and","with","regard","to","record","keeping","as","appropriate","furthermore","deployer","should","ensure","that","the","person","assign","to","implement","the","instruction","for","use","and","human oversight","as","set","out","in","this regulation","have","the necessary competence","in particular an adequate level","of","ai literacy","training","and","authority","to","properly","fulfil","those","task","those","obligation","should","be","without","prejudice","to","other","deployer","obligation","in","relation","to","high","risk","ai","system","under","union","or","national law"],"unmatched_count":64,"match_length":84,"cut_length":148},{"key":"91","text_words":[null,["92","NUM",""],null,["this","DET","this"],["regulation","PROPN",""],["is","AUX","be"],["without","ADP",""],["prejudice","NOUN",""],["to","ADP",""],["obligations","NOUN","obligation"],["for","SCONJ",""],["employers","NOUN","employer"],["to","PART",""],["inform","VERB",""],["or","CCONJ",""],["to","PART",""],["inform","VERB",""],["and","CCONJ",""],["consult","VERB",""],["workers","NOUN","worker"],["or","CCONJ",""],["their","PRON",""],["representatives","NOUN","representative"],["under","ADP",""],["union","PROPN",""],["or","CCONJ",""],["national","ADJ",""],["law","NOUN",""],["and","CCONJ",""],["practice","NOUN",""],null,["including","VERB","include"],["directive","PROPN",""],["2002/14","NUM",""],["/","SYM",""],["ec","PROPN",""],["of","ADP",""],["the","DET",""],["european","PROPN",""],["parliament","PROPN",""],["and","CCONJ",""],["of","ADP",""],["the","DET",""],["council","PROPN",""],null,null,["39","NUM",""],null,null,["on","ADP",""],["decisions","NOUN","decision"],["to","PART",""],["put","VERB",""],["into","ADP",""],["service","NOUN",""],["or","CCONJ",""],["use","VERB",""],["ai","PROPN",""],["systems","NOUN","system"],null,["it","PRON","it"],["remains","VERB","remain"],["necessary","ADJ",""],["to","PART",""],["ensure","VERB",""],["information","NOUN",""],["of","ADP",""],["workers","NOUN","worker"],["and","CCONJ",""],["their","