ulation.","idx":457,"match_words":["notify","body","avoid","unnecessary","burden","provider","perform","activity","take","due account","the size","the provider","the sector","operate","its structure","the degree","complexity","high","risk","system","concern","particular","view","minimise","administrative","burden","compliance","cost","small","enterprise","the meaning","recommendation","2003/361","notify","body","nevertheless","respect","the degree","the level","protection","require","the compliance","high","risk","system","requirement","this regulation"],"words":["notify","body","shall","avoid","unnecessary","burden","for","provider","when","perform","their","activity","and","take","due account","of","the size","of","the provider","the sector","in","which","it","operate","its structure","and","the degree","of","complexity","of","the","high","risk","ai","system","concern","in","particular","in","view","of","minimise","administrative","burden","and","compliance","cost","for","and","small","enterprise","within","the meaning","of","recommendation","2003/361","ec","the","notify","body","shall","nevertheless","respect","the degree","of","rigour","and","the level","of","protection","require","for","the compliance","of","the","high","risk","ai","system","with","the","requirement","of","this regulation"],"unmatched_count":37,"match_length":47,"cut_length":84},{"key":"464","text_words":[["3","X",""],null,["notified","VERB","notify"],["bodies","NOUN","body"],["shall","AUX",""],["make","VERB",""],["available","ADJ",""],["and","CCONJ",""],["submit","VERB",""],["upon","SCONJ",""],["request","NOUN",""],["all","DET",""],["relevant","ADJ",""],["documentation","NOUN",""],null,["including","VERB","include"],["the","DET",""],["providers","NOUN","provider"],["’","PART",""],["documentation","NOUN",""],null,["to","ADP",""],["the","DET",""],["notifying","NOUN",""],["authority","NOUN",""],["referred","VERB","refer"],["to","ADP",""],["in","ADP",""],["article","PROPN",""],null,["28","NUM",""]