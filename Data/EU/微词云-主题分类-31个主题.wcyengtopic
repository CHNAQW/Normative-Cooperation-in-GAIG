17/746.","idx":146,"match_words":["appropriate","the commission","facilitate","the extent","possible","access","testing","experimentation","facility","body","group","laboratory","establish","pursuant","any relevant union harmonisation legislation","fulfil","task","the context","conformity assessment","product","device","cover","that union harmonisation legislation","particular","the case","regard","expert","panel","expert","laboratory","reference","laboratory","the field","medical","device","pursuant","regulations","2017/745","2017/746"],"words":["it","be","appropriate","that","the commission","facilitate","to","the extent","possible","access","to","testing","and","experimentation","facility","to","body","group","or","laboratory","establish","or","accredit","pursuant","to","any relevant union harmonisation legislation","and","which","fulfil","task","in","the context","of","conformity assessment","of","product","or","device","cover","by","that union harmonisation legislation","this","be","in","particular","the case","as","regard","expert","panel","expert","laboratory","and","reference","laboratory","in","the field","of","medical","device","pursuant","to","regulations","eu","2017/745","and","eu","2017/746"],"unmatched_count":29,"match_length":39,"cut_length":68},{"key":"147","text_words":[null,["148","NUM",""],null,["this","DET","this"],["regulation","PROPN",""],["should","AUX",""],["establish","VERB",""],["a","DET",""],null,["governance","NOUN",""],["framework","NOUN",""],["that","PRON",""],["both","PRON",""],["allows","VERB","allow"],["to","PART",""],["coordinate","VERB",""],["and","CCONJ",""],["support","VERB",""],["the","DET",""],["application","NOUN",""],["of","ADP",""],["this","DET",""],["regulation","PROPN",""],["at","ADP",""],["national","ADJ",""],["level","NOUN",""],null,["as","ADV",""],["well","ADV",""],["as","ADP",""],["build","VERB",""],["capabilities","NOUN","capability"],["at","ADP",""],["union","PROPN",""],["level","NOUN",""],["and","CCONJ",""],["integr