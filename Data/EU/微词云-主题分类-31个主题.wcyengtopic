tive","NOUN","directive"],null,["eu","PROPN",""],null,["2019/790","NOUN",""],["introduced","VERB","introduce"],["exceptions","NOUN","exception"],["and","CCONJ",""],["limitations","NOUN","limitation"],["allowing","VERB","allow"],["reproductions","NOUN","reproduction"],["and","CCONJ",""],["extractions","NOUN","extraction"],["of","ADP",""],["works","NOUN","work"],["or","CCONJ",""],["other","ADJ",""],["subject","ADJ",""],["matter","NOUN",""],null,["for","ADP",""],["the","DET",""],["purpose","NOUN",""],["of","ADP",""],["text","NOUN",""],["and","CCONJ",""],["data","NOUN",""],["mining","NOUN",""],null,["under","ADP",""],["certain","ADJ",""],["conditions","NOUN","condition"],null,["under","ADP","under"],["these","DET",""],["rules","NOUN","rule"],null,["rightsholders","NOUN","rightsholder"],["may","AUX",""],["choose","VERB",""],["to","PART",""],["reserve","VERB",""],["their","PRON",""],["rights","NOUN","right"],["over","ADP",""],["their","PRON",""],["works","NOUN","work"],["or","CCONJ",""],["other","ADJ",""],["subject","NOUN",""],["matter","NOUN",""],["to","PART",""],["prevent","VERB",""],["text","NOUN",""],["and","CCONJ",""],["data","NOUN","datum"],["mining","NOUN",""],null,["unless","SCONJ",""],["this","PRON",""],["is","AUX","be"],["done","VERB","do"],["for","ADP",""],["the","DET",""],["purposes","NOUN","purpose"],["of","ADP",""],["scientific","ADJ",""],["research","NOUN",""],null,["where","SCONJ","where"],["the","DET",""],["rights","NOUN","right"],["to","PART",""],["opt","VERB",""],["out","ADP",""],["has","AUX","have"],["been","AUX","be"],["expressly","ADV",""],["reserved","VERB","reserve"],["in","ADP",""],["an","DET",""],["appropriate","ADJ",""],["manner","NOUN",""],null,["providers","NOUN","provider"],["of","ADP",""],["general","ADJ",""],null,["purpose","NOUN",""],["ai","PROPN",""],["models","NOUN","model"],["need","VERB",""],["to","PART",""],["obtain","VERB",""],["an","DET",""],["authorisation","NOUN",""],["from","ADP",""],["rightsholders","NOUN","rightsholder"],["if","SCONJ",""],["they","PRON",""],["want","VERB",""],["to","PART",""],["carry","VERB",""],["out","ADP",""],["text","NOUN",""],["and","CCONJ",""],["data","NOUN","datum"],["mining","NOUN",""],["over","ADP",""],["such","ADJ",""],["works","NOUN","work"],null],"text":"(105) General-purpose AI models, in particular large generative AI models, capable of generating text, images, and other content, present unique innovation opportunities but also challenges to artists, authors, and other creators and the way their creative content is created, distributed, used and consumed.The development and training of such models require access to vast amounts of text, images, videos and other data.Text and data mining techniques may be used extensively in this context for the retrieval and analysis of such content, which may be protected by copyright and related rights.Any use of copyright protected content requires the authorisation of the rightsholder concerned unless relevant copyright exceptions and limitations apply.Directive (EU) 2019/790 introduced exceptions and limitations allowing reproductions and extractions of works or other subject matter, for the purpose of text and data mining, under certain conditions.Under these rules, rightsholders may choose to reserve their rights over their works or other subject matter to prevent text and data mining, unless this is done for the purposes of scientific research.Where the rights to opt out has been expressly reserved in an appropriate manner, providers of general-purpose AI models need to obtain an authorisation from rightsholders if they want to carry out text and data mining over such works.","idx":104,"match_words":["general","purpose","model","particular","large","model","capable","generating text","image","other content","present","unique","innovation","opportunity","also","challenge","other","the way","their creative content","create","distribute","use","the development","training","such","model","require","access","amount","text","image","video","other","datum","text","data mining","technique","may","use","this context","the retrieval","analysis","such content","may","protect","copyright","related","right","any use","copyright","protect","content","require","the authorisation","the rightsholder","concern","relevant","copyright","exception","limitation","apply","directive","2019/790","introduce","exception","limitation","allow","work","other subject matter","the purpose","text","data mining","certain","condition","rule","rightsholder","may","choose","right","over","work","other subject matter","prevent","text","datum","mining","purpose","scientific research","right","opt","out","have","expressly","an appropriate manner","provider","general","purpose","model","need","obtain","an authorisation","rightsholder","carry","out","text","datum","mining","over","such","work"],"words":["general","purpose","ai","model","in","particular","large","generative","ai","model","capable","of","generating text","image","and","other content","present","unique","innovation","opportunity","but","also","challenge","to","artist","author","and","other","creator","and","the way","their creative content","be","create","distribute","use","and","consume","the development","and","training","of","such","model","require","access","to","vast","amount","of","text","image","video","and","other","datum","text","and","data mining","technique","may","be","use","extensively","in","this context","for","the retrieval","and","analysis","of","such content","which","may","be","protect","by","copyright","and","related","right","any use","of","copyright","protect","content","require","the authorisation","of","the rightsholder","concern","unless","relevant","copyright","exception","and","limitation","apply","directive","eu","2019/790","introduce","exception","and","limitation","allow","reproduction","and","extraction","of","work","or","other subject matter","for","the purpose","of","text","and","data mining","under","certain","condition","under","these","rule","rightsholder","may","choose","to","reserve","their","right","over","their","work","or","other subject matter","to","prevent","text","and","datum","mining","unless","this","be","do","for","the","purpose","of","scientific research","where","the","right","to","opt","out","have","be","expressly","reserve","in","an appropriate manner","provider","of","general","purpose","ai","model","need","to","obtain","an authorisation","from","rightsholder","if","they","want","to","carry","out","text","and","datum","mining","over","such","work"],"unmatched_count":79,"match_length":110,"cut_length":189},{"key":"105","text_words":[null,["106","NUM",""],null,["providers","NOUN","provider"],["that","PRON",""],["place","VERB",""],["general","ADJ",""],null,["purpose","NOUN",""],["ai","PROPN",""],["models","NOUN","model"],["on","ADP",""],["the","DET",""],["union","PROPN",""],["market","NOUN",""],["should","AUX",""],["ensure","VERB",""],["compliance","NOUN",""],["with","ADP",""],["the","DET",""],["relevant","ADJ",""],["obligations","NOUN","obligation"],["in","ADP",""],["this","DET",""],["regulation","PROPN",""],null,["to","ADP","to"],["that","DET",""],["end","NOUN",""],null,["providers","NOUN","provider"],["of","ADP",""],["general","ADJ",""],null,["purpose","NOUN",""],["ai","PROPN",""],["models","NOUN","model"],["should","AUX",""],["put","VERB",""],["in","ADP",""],["place","NOUN",""],["a","DET",""],null,["policy","NOUN",""],["to","PART",""],["comply","VERB",""],["with","ADP",""],["union","PROPN",""],["law","NOUN",""],["on","ADP",""],["copyright","NOUN",""],["and","CCONJ",""],["related","ADJ",""],["rights","NOUN","right"],null,["in","ADP",""],["particular","ADJ",""],["to","PART",""],["identify","VERB",""],["and","CCONJ",""],["comply","VERB",""],["with","ADP",""],["the","DET",""],["reservation","NOUN",""],["of","ADP",""],["rights","NOUN","right"],["expressed","VERB","express"],["by","ADP",""],["rightsholders","NOUN","rightsholder"],["pursuant","ADJ",""],["to","ADP",""],["article","NOUN","article"],null,["4(3","NUM",""],null,["of","ADP",""],["directive","PROPN",""],null,["eu","PROPN",""],null,["2019/790","NOUN",""],null,["any","DET","any"],["provider","NOUN",""],["placing","VERB","place"],["a","DET",""],null,["general","ADJ",""],null,["purpose","NOUN",""],["ai","PROPN",""],["model","NOUN",""],["on","ADP",""],["the","DET",""],["union","PROPN",""],["market","NOUN",""],["should","AUX",""],["comply","VERB",""],["with","ADP",""],["this","DET",""],["obligation","NOUN",""],null,["regardless","ADV",""],["of","ADP",""],["the","DET",""],["jurisdiction","NOUN",""],["in","ADP",""],["which","PRON",""],["the","DET",""],["copyright","NOUN",""],null,["relevant","ADJ",""],["acts","NOUN","act"],["underpinning","VERB","underpin"],["the","DET",""],["training","NOUN",""],["of","ADP",""],["those","DET",""],["general","ADJ",""],null,["purpose","NOUN",""],["ai","PROPN",""],["models","NOUN","model"],["take","VERB",""],["place","NOUN",""],null,["this","PRON","this"],["is","AUX","be"],["necessary","ADJ",""],["to","PART",""],["ensure","VERB",""],["a","DET",""],null,["level","NOUN",""],["playing","NOUN",""],["field","NOUN",""],["among","ADP",""],["providers","NOUN","provider"],["of","ADP",""],["general","ADJ",""],null,["purpose","NOUN",""],["ai","PROPN",""],["models","NOUN","model"],["where","SCONJ",""],["no","DET",""],["provider","NOUN",""],["should","AUX",""],["be","AUX",""],["able","ADJ",""],["to","PART",""],["gain","VERB",""],["a","DET",""],null,["competitive","ADJ",""],["advantage","NOUN",""],["in","ADP",""],["the","DET",""],["union","PROPN",""],["market","NOUN",""],["by","ADP",""],["applying","VERB","apply"],["lower","ADJ","low"],["copyright","NOUN",""],["standards","NOUN","standard"],["than","ADP",""],["those","PRON",""],["provided","VERB","provide"],["in","ADP",""],["the","DET",""],["union","PROPN",""],null],"text":"(106) Providers that place general-purpose AI models on the Union market should ensure compliance with the relevant obligations in this Regulation.To that end, providers of general-purpose AI models should put in place a policy to comply with Union law on copyright and related rights, in particular to identify and comply with the reservation of rights expressed by rightsholders pursuant to Article 4(3) of Directive (EU) 2019/790.Any provider placing a general-purpose AI model on the Union market should comply with this obligation, regardless of the jurisdiction in which the copyright-relevant acts underpinning the training of those general-purpose AI models take place.This is necessary to ensure a level playing field among providers of general-purpose AI models where no provider should be able to gain a competitive advantage in the Union market by applying lower copyright standards than those provided in the Union.","idx":105,"match_words":["provider","place","general","purpose","model","the union market","ensure","compliance","relevant","obligation","this regulation","that end","provider","general","purpose","model","put","place","policy","comply","union law","copyright","related","right","particular","identify","comply","the reservation","right","express","rightsholder","pursuant","article","directive","2019/790","any provider","place","general","purpose","model","the union market","comply","this obligation","regardless","the jurisdiction","copyright","relevant","act","the training","general","purpose","model","take","place","necessary","ensure","level","playing","field","provider","general","purpose","model","no provider","able","gain","competitive","the union market","apply","low","copyright","standard","provide","the union"],"words":["provider","that","place","general","purpose","ai","model","on","the union market","should","ensure","compliance","with","the","relevant","obligation","in","this regulation","to","that end","provider","of","general","purpose","ai","model","should","put","in","place","a","policy","to","comply","with","union law","on","copyright","and","related","right","in","particular