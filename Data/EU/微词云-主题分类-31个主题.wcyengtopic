OUN",""],null],"text":"3. Where the Commission concludes that the arguments submitted pursuant to paragraph 2 are not sufficiently substantiated and the relevant provider was not able to demonstrate that the general-purpose AI model does not present, due to its specific characteristics, systemic risks, it shall reject those arguments, and the general-purpose AI model shall be considered to be a general-purpose AI model with systemic risk.","idx":565,"match_words":["the commission","conclude","argument","submit","pursuant","paragraph","sufficiently","the relevant provider","able","demonstrate","general","purpose","model","present","due","specific","characteristic","systemic risk","reject","argument","general","purpose","model","consider","general","purpose","model","systemic","risk"],"words":["where","the commission","conclude","that","the","argument","submit","pursuant","to","paragraph","be","not","sufficiently","substantiate","and","the relevant provider","be","not","able","to","demonstrate","that","the","general","purpose","ai","model","do","not","present","due","to","its","specific","characteristic","systemic risk","it","shall","reject","those","argument","and","the","general","purpose","ai","model","shall","be","consider","to","be","a","general","purpose","ai","model","with","systemic","risk"],"unmatched_count":31,"match_length":29,"cut_length":60},{"key":"577","text_words":[["4","X",""],null,["the","DET","the"],["commission","PROPN",""],["may","AUX",""],["designate","VERB",""],["a","DET",""],null,["general","ADJ",""],null,["purpose","NOUN",""],["ai","PROPN",""],["model","NOUN",""],["as","ADP",""],["presenting","VERB","present"],["systemic","ADJ",""],["risks","NOUN","risk"],null,null,["ex","X",""],["officio","X",""],null,["or","CCONJ",""],["following","VERB","follow"],["a","DET",""],null,["qualified","ADJ",""],["alert","NOUN",""],["from","ADP",""],["the","DET",""],["scientific","ADJ",""],["panel","NOUN",""],["pursuant","ADJ",""],["to","ADP",""],["article","NOUN"