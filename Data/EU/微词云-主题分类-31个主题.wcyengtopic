workers and their representatives on the planned deployment of high-risk AI systems at the workplace where the conditions for those information or information and consultation obligations in other legal instruments are not fulfilled.Moreover, such information right is ancillary and necessary to the objective of protecting fundamental rights that underlies this Regulation.Therefore, an information requirement to that effect should be laid down in this Regulation, without affecting any existing rights of workers.","idx":91,"match_words":["this regulation","prejudice","obligation","employer","inform","inform","consult","worker","representative","union","national law","practice","include","directive","the european parliament","the council","decision","put","service","use","system","remain","necessary","ensure","information","worker","representative","plan","deployment","high","risk","system","the workplace","condition","those information","information","consultation","obligation","other","legal","instrument","fulfil","moreover","such information","right","ancillary","necessary","the objective","protect","fundamental","right","this regulation","therefore","an information requirement","that effect","lay","down","this regulation","affect","exist","right","worker"],"words":["this regulation","be","without","prejudice","to","obligation","for","employer","to","inform","or","to","inform","and","consult","worker","or","their","representative","under","union","or","national law","and","practice","include","directive","ec","of","the european parliament","and","of","the council","on","decision","to","put","into","service","or","use","ai","system","it","remain","necessary","to","ensure","information","of","worker","and","their","representative","on","the","plan","deployment","of","high","risk","ai","system","at","the workplace","where","the","condition","for","those information","or","information","and","consultation","obligation","in","other","legal","instrument","be","not","fulfil","moreover","such information","right","be","ancillary","and","necessary","to","the objective","of","protect","fundamental","right","that","underlie","this regulation","therefore","an information requirement","to","that effect","should","be","lay","down","in","this regulation","without","affect","any","exist","right","of","worker"],"unmatched_count":53,"match_length":62,"cut_length":115},{"key":"92","text_words":[null,["93","NUM",""],null,["whilst","SCONJ","whilst"],["risks","NOUN","risk"],["related","VERB","relate"],["to","ADP",""],["ai","PROPN",""],["systems","NOUN","system"],["can","AUX",""],["result","VERB",""],["from","ADP",""],["the","DET",""],["way","NOUN",""],["such","ADJ",""],["systems","NOUN","system"],["are","AUX","be"],["designed","VERB","design"],null,["risks","NOUN","risk"],["can","AUX",""],["as","ADV",""],["well","ADV",""],["stem","VERB",""],["from","ADP",""],["how","SCONJ",""],["such","ADJ",""],["ai","PROPN",""],["systems","NOUN","system"],["are","AUX","be"],["used","VERB","use"],null,["deployers","NOUN","deployer"],["of","ADP",""],["high","ADJ",""],null,["risk","NOUN",""],["ai","PROPN",""],["system","NOUN",""],["therefore","ADV",""],["play","VERB",""],["a","DET",""],null,["critical","ADJ",""],["role","NOUN",""],["in","ADP",""],["ensuring","VERB","ensure"],["that","SCONJ",""],["fundamental","ADJ",""],["rights","NOUN","right"],["are","AUX","be"],["protected","VERB","protect"],null,["complementing","VERB","complement"],["the","DET",""],["obligations","NOUN","obligation"],["of","ADP",""],["the","DET",""],["provider","NOUN",""],["when","SCONJ",""],["developing","VERB","develop"],["the","DET",""],["ai","PROPN",""],["system","NOUN",""],null,["deployers","NOUN","deployer"],["are","AUX","be"],["best","ADV","well"],["placed","VERB","place"],["to","PART",""],["understand","VERB",""],["how","SCONJ",""],["the","DET",""],["high","ADJ",""],null,["risk","NOUN",""],["ai","PROPN",""],["system","NOUN",""],["will","AUX",""],["be","AUX",""],["used","VERB","use"],["con