Regulation.To carry out its monitoring and supervision tasks, the AI Office shall have all the powers of a market surveillance authority provided for in this Section and Regulation (EU) 2019/1020.","idx":744,"match_words":["an ai system","base","general","purpose","model","the model","the system","develop","the same provider","the ai office","have","power","monitor","supervise","compliance","that ai system","obligation","this regulation","carry","out","monitoring","supervision","task","the ai office","have","all","power","market","surveillance","authority","provide","this section","regulation"],"words":["where","an ai system","be","base","on","a","general","purpose","ai","model","and","the model","and","the system","be","develop","by","the same provider","the ai office","shall","have","power","to","monitor","and","supervise","compliance","of","that ai system","with","obligation","under","this regulation","to","carry","out","its","monitoring","and","supervision","task","the ai office","shall","have","all","the","power","of","a","market","surveillance","authority","provide","for","in","this section","and","regulation","eu"],"unmatched_count":26,"match_length":33,"cut_length":59},{"key":"758","text_words":[["2","X",""],null,["where","SCONJ","where"],["the","DET",""],["relevant","ADJ",""],["market","NOUN",""],["surveillance","NOUN",""],["authorities","NOUN","authority"],["have","VERB",""],["sufficient","ADJ",""],["reason","NOUN",""],["to","PART",""],["consider","VERB",""],["general","ADJ",""],null,["purpose","NOUN",""],["ai","PROPN",""],["systems","NOUN","system"],["that","PRON",""],["can","AUX",""],["be","AUX",""],["used","VERB","use"],["directly","ADV",""],["by","ADP",""],["deployers","NOUN","deployer"],["for","ADP",""],["at","ADV",""],["least","ADV",""],["one","NUM",""],["purpose","NOUN",""],["that","PRON",""],["is","AUX","be"],["classified","VERB","classify"],["as","ADP",""],["high","ADJ",""],null,["risk","NOUN",""],["pursuant","NOUN",""],["to","ADP",""],["this","DE