"law","NOUN","","",["pobj","with"]],""],"neg=0.023,neu=0.737,pos=0.097,compound=0.2422"],[["neg=0.057,neu=0.786,pos=0.157,compound=0.5719,span=(26) In order to introduce a proportionate and effective set of binding rules for AI systems, a clearly defined risk-based approach should be followed.","neg=0.08,neu=0.92,pos=0.0,compound=-0.2732,span=That approach should tailor the type and content of such rules to the intensity and scope of the risks that AI systems can generate.","neg=0.115,neu=0.79,pos=0.095,compound=-0.2263,span=It is therefore necessary to prohibit certain unacceptable AI practices, to lay down requirements for high-risk AI systems and obligations for the relevant operators, and to lay down transparency obligations for certain AI systems."],["order","a proportionate and effective set","binding rules","AI systems","a clearly defined risk-based approach","That approach","the type","content","such rules","the intensity","scope","the risks","that","AI systems","It","certain unacceptable AI practices","requirements","high-risk AI systems","obligations","the relevant operators","transparency obligations","certain AI systems"],["",["26","NUM","","CARDINAL",["dep","follow"]],"",["In","ADP","in","",["prep","follow"]],["order","NOUN","","",["pobj","in"]],["to","PART","","",["aux","introduce"]],["introduce","VERB","","",["acl","order"]],["a","DET","","",["det","set"]],"",["proportionate","ADJ","","",["amod","set"]],["and","CCONJ","","",["cc","proportionate"]],["effective","ADJ","","",["conj","proportionate"],[2.1,""]],["set","NOUN","","",["dobj","introduce"]],["of","ADP","","",["prep","set"]],["binding","VERB","bind","",["amod","rule"]],["rules","NOUN","rule","",["pobj","of"]],["for","ADP","","",["prep","rule"]],["AI","PROPN","","ORG",["compound","system"]],["systems","NOUN","system","",["pobj","for"]],"",["a","DET","","",["det","approach"]],"",["clearly","ADV","","",["advmod","define"],[1.7,""]],["defined","VERB","define","",["amod","approach"]],["risk","NOUN","","",["npadvmod","base"],[-1.1,""]],"",["based","VERB","base","",["amod","approach"]],["approach","NOUN","","",["nsubjpass","follow"]],["should","AUX","","",["aux","follow"]],["be","AUX","","",["auxpass","follow"]],["followed","VERB","follow","",["ROOT","follow"]],"",["That","DET","that","",["det","approach"]],["approach","NOUN","","",["nsubj","tailor"]],["should","AUX","","",["aux","tailor"]],["tailor","VERB","","",["ROOT","tailor"]],["the","DET","","",["det","type"]],["type","NOUN","","",["dobj","tailor"]],["and","CCONJ","","",["cc","type"]],["content","NOUN","","",["conj","type"]],["of","ADP","","",["prep","type"]],["such","ADJ","","",["amod","rule"]],["rules","NOUN","rule","",["pobj","of"]],["to","ADP","","",["prep","tailor"]],["the","DET","","",["det","intensity"]],["intensity","NOUN","","",["pobj","to"]],["and","CCONJ","","",["cc","intensity"]],["scope","NOUN","","",["conj","intensity"]],["of","ADP","","",["prep","intensity"]],["the","DET","","",["det","risk"]],["risks","NOUN","risk","",["pobj","of"],[-1.1,""]],["that","PRON","","",["dobj","generate"]],["AI","PROPN","","ORG",["compound","system"]],["systems","NOUN","system","",["nsubj","generate"]],["can","AUX","","",["aux","generate"]],["generate","VERB","","",["relcl","risk"]],"",["It","PRON","it","",["nsubj","be"]],["is","AUX","be","",["ROOT","be"]],["therefore","ADV","","",["advmod","be"]],["necessary","ADJ","","",["acomp","be"]],["to","PART","","",["aux","prohibit"]],["prohibit","VERB","","",["xcomp","be"]],["certain","ADJ","","",["amod","practice"],[1.1,""]],["unacceptable","ADJ","","",["amod","practice"],[-2,""]],["AI","PROPN","","ORG",["compound","practice"]],["practices","NOUN","practice","",["dobj","prohibit"]],"",["to","PART","","",["aux","lay"]],["lay","VERB","","",["advcl","prohibit"]],["down","ADP","","",["prt","lay"]],["requirements","NOUN","requirement","",["dobj","lay"]],["for","ADP","","",["prep","requirement"]],["high","ADJ","","",["amod","risk"]],"",["risk","NOUN","","",["compound","system"],[-1.1,""]],["AI","PROPN","","ORG",["compound","system"]],["systems","NOUN","system","",["pobj","for"]],["and","CCONJ","","",["cc","system"]],["obligations","NOUN","obligation","",["conj","system"]],["for","ADP","","",["prep","requirement"]],["the","DET","","",["det","operator"]],["relevant","ADJ","","",["amod","operator"]],["operators","NOUN","operator","",["pobj","for"]],"",["and","CCONJ","","",["cc","lay"]],["to","PART","","",["aux","lay"]],["lay","VERB","","",["conj","lay"]],["down","ADP","","",["prt","lay"]],["transparency","NOUN","","",["compound","obligation"]],["obligations","NOUN","obligation","",["dobj","lay"]],["for","ADP","","",["prep","obligation"]],["certain","ADJ","","",["amod","system"],[1.1,""]],["AI","PROPN","","ORG",["compound","system"]],["systems","NOUN","system","",["pobj","for"]],""],"neg=0.084,neu=0.832,pos=0.084,compound=0.0241"],[["neg=0.04,neu=0.798,pos=0.162,compound=0.7506,span=(27) While the risk-based approach is the basis for a proportionate and effective set of binding rules, it is important to recall the 2019 Ethics guidelines for trustworthy AI developed by the independent AI HLEG appointed by the Commission.","neg=0.0,neu=0.681,pos=0.319,compound=0.9042,span=In those guidelines, the AI HLEG developed seven non-binding ethical principles for AI which are intended to help ensure that AI is trustworthy and ethically sound.","neg=0.0,neu=0.88,pos=0.12,compound=0.5994,span=The seven principles include human agency and oversight; technical robustness and safety; privacy and data governance; transparency; diversity, non-discrimination and fairness; societal and environmental well-being and accountability.","neg=0.0,neu=0.812,pos=0.188,compound=0.8556,span=Without prejudice to the legally binding requirements of this Regulation and any other applicable Union law, those guidelines contribute to the design of coherent, trustworthy and human-centric AI, in line with the Charter and with the values on which the Union is founded.","neg=0.0,neu=0.912,pos=0.088,compound=0.6124,span=According to the guidelines of the AI HLEG, human agency and oversight means that AI systems are developed and used as a tool that serves people, respects human dignity and personal autonomy, and that is functioning in a way that can be appropriately controlled and overseen by humans.","neg=0.1,neu=0.776,pos=0.124,compound=0.1189,span=Technical robustness and safety means that AI systems are developed and used in a way that allows robustness in the case of problems and resilience against attempts to alter the use or performance of the AI system so as to allow unlawful use by third parties, and minimise unintended harm.","neg=0.0,neu=0.929,pos=0.071,compound=0.3818,span=Privacy and data governance means that AI systems are developed and used in accordance with privacy and data protection rules, while processing data that meets high standards in terms of quality and integrity.","neg=0.028,neu=0.936,pos=0.036,compound=0.128,span=Transparency means that AI systems are developed and used in a way that allows appropriate traceability and explainability, while making humans aware that they communicate or interact with an AI system, as well as duly informing deployers of the capabilities and limitations of that AI system and affected persons about their rights.","neg=0.1,neu=0.856,pos=0.044,compound=-0.4767,span=Diversity, non-discrimination and fairness means that AI systems are developed and used in a way that includes diverse actors and promotes equal access, gender equality and cultural diversity, while avoiding discriminatory impacts and unfair biases that are prohibited by Union or national law.","neg=0.0,neu=0.822,pos=0.178,compound=0.8555,span=Social and environmental well-being means that AI systems are developed and used in a sustainable and environmentally friendly manner as well as in a way to benefit all human beings, while monitoring and assessing the long-term impacts on the individual, society and democracy.","neg=0.0,neu=0.0,pos=0.0,compound=0.0,span=The application of those principles should be translated, when possible, in the design and use of AI models.","neg=0.0,neu=0.0,pos=0.0,compound=0.0,span=They should in any case serve as a basis for the drafting of codes of conduct under this Regulation.","neg=0.0,neu=0.773,pos=0.227,compound=0.875,span=All stakeholders, including industry, academia, civil society and standardisation organisations, are encouraged to take into account, as appropriate, the ethical principles for the development of voluntary best practices and standards."],["the risk-based approach","the basis","a proportionate and effective set","binding rules","it","the 2019 Ethics guidelines","trustworthy AI","the independent AI HLEG","the Commission","those guidelines","the AI HLEG","seven non-binding ethical principles","AI","which","AI","The seven principles","human agency","oversight","technical robustness","safety","privacy and data governance","transparency","diversity","-","discrimination","fairness","well-being","accountability","prejudice","the legally binding requirements","this Regulation","any other applicable Union law","those guidelines","the design","coherent, trustworthy and human-centric AI","line","the Charter","the values","which","the Union","the guidelines","the AI HLEG","human agency","oversight","AI systems","a tool","that","people","human dignity","personal autonomy","that","a way","that","humans","Technical robustness","safety","AI systems","a way","that","robustness","the case","problems","resilience","attempts","the use","performance","the AI system","unlawful use","third parties","unintended harm","Privacy and data governance","AI systems","accordance","privacy and data protection rules","data","that","high standards","terms","quality","integrity","Transparency","AI systems","a way","that","appropriate traceability","explainability","humans","they","an AI system","deployers","the capabilities","limitations","that AI system","affected person