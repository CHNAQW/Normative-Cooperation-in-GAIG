_3P3CPTQAL.2J05HPIO844GJLA.2JFS2AQRB.COP.9621P.5G4E.V3.NLP_ENGLISH.9OM2QQE|{"text":{"bytes":552082,"bytes_str":"539.14 KB","length":549105,"tkey":"dc13538241228c9daa55b9f8b888cd1b","_md5":"dc13538241228c9daa55b9f8b888cd1b"},"cdit":[],"sop":{"senti":true,"model":"en_core_web_sm"},"cop":{"remove_words":[],"remove_tags":["SYM","EOL","SPACE","NUM","PUNCT","X"],"remove_parser_type":[],"remove_parser_tags":["CCONJ","CONJ","AUX","PRON","NUM","PART","PUNCT","SCONJ","SYM","ADP"],"parser_min_total":2,"senti_neu_range":[-0.1,0.1],"tag_list":[{"tag":"名词","total":22901,"_tag":"NOUN"},{"tag":"介词","total":13484,"_tag":"ADP"},{"tag":"限定词","total":9977,"_tag":"DET"},{"tag":"动词","total":8939,"_tag":"VERB"},{"tag":"形容词","total":7908,"_tag":"ADJ"},{"tag":"专有名词","total":5592,"_tag":"PROPN"},{"tag":"并列连词","total":4319,"_tag":"CCONJ"},{"tag":"助动词","total":4125,"_tag":"AUX"},{"tag":"代词","total":1934,"_tag":"PRON"},{"tag":"助词","total":1675,"_tag":"PART"},{"tag":"副词","total":1510,"_tag":"ADV"},{"tag":"从属连词","total":1344,"_tag":"SCONJ"},{"tag":"感叹词","total":2,"_tag":"INTJ"}]},"d":[[["neg=0.0,neu=0.799,pos=0.201,compound=0.9823,span=(1) The purpose of this Regulation is to improve the functioning of the internal market by laying down a uniform legal framework in particular for the development, the placing on the market, the putting into service and the use of artificial intelligence systems (AI systems) in the Union, in accordance with Union values, to promote the uptake of human centric and trustworthy artificial intelligence (AI) while ensuring a high level of protection of health, safety, fundamental rights as enshrined in the Charter of Fundamental Rights of the European Union (the ‘Charter’), including democracy, the rule of law and environmental protection, to protect against the harmful effects of AI systems in the Union, and to support innovation.","neg=0.052,neu=0.879,pos=0.069,compound=0.4215,span=This Regulation ensures the free movement, cross-border, of AI-based goods and services, thus preventing Member States from imposing restrictions on the development, marketing and use of AI systems, unless explicitly authorised by this Regulation."],["The purpose","this Regulation","the functioning","the internal market","a uniform legal framework","the development","the market","service","artificial intelligence systems","(AI systems","the Union","accordance","Union values","the uptake","human centric","trustworthy artificial intelligence","AI","a high level","protection","health","safety","fundamental rights","the Charter","Fundamental Rights","the European Union","(the ‘Charter","democracy","the rule","law and environmental protection","the harmful effects","AI systems","the Union","innovation","This Regulation","the free movement","-","border","AI-based goods","services","Member States","restrictions","the development","marketing","use","AI systems","this Regulation"],["",["1","X","","CARDINAL",["meta","be"]],"",["The","DET","the","",["det","purpose"]],["purpose","NOUN","","",["nsubj","be"]],["of","ADP","","",["prep","purpose"]],["this","DET","","",["det","Regulation"]],["Regulation","PROPN","","",["pobj","of"]],["is","AUX","be","",["ROOT","be"]],["to","PART","","",["aux","improve"]],["improve","VERB","","",["xcomp","be"],[1.9,""]],["the","DET","","",["det","functioning"]],["functioning","NOUN","","",["dobj","improve"]],["of","ADP","","",["prep","functioning"]],["the","DET","","",["det","market"]],["internal","ADJ","","",["amod","market"]],["market","NOUN","","",["pobj","of"]],["by","ADP","","",["prep","improve"]],["laying","VERB","lay","",["pcomp","by"]],["down","ADP","","",["prt","lay"]],["a","DET","","",["det","framework"]],"",["uniform","ADJ","","",["amod","framework"]],["legal","ADJ","","",["amod","framework"],[0.5,""]],["framework","NOUN","","",["dobj","lay"]],["in","ADP","","",["prep","framework"]],["particular","ADJ","","",["amod","in"]],["for","ADP","","",["prep","framework"]],["the","DET","","",["det","development"]],["development","NOUN