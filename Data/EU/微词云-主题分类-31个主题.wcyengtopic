",""],["input","NOUN",""],["data","NOUN","datum"],null,["that","DET",""],["deployer","NOUN",""],["shall","AUX",""],["ensure","VERB",""],["that","SCONJ",""],["input","NOUN",""],["data","NOUN","datum"],["is","AUX","be"],["relevant","ADJ",""],["and","CCONJ",""],["sufficiently","ADV",""],["representative","ADJ",""],["in","ADP",""],["view","NOUN",""],["of","ADP",""],["the","DET",""],["intended","VERB","intend"],["purpose","NOUN",""],["of","ADP",""],["the","DET",""],["high","ADJ",""],null,["risk","NOUN",""],["ai","PROPN",""],["system","NOUN",""],null],"text":"4.Without prejudice to paragraphs 1 and 2, to the extent the deployer exercises control over the input data, that deployer shall ensure that input data is relevant and sufficiently representative in view of the intended purpose of the high-risk AI system.","idx":393,"match_words":["prejudice","paragraph","the extent","the deployer","exercise","control","over","input","datum","that deployer","ensure","input","datum","relevant","sufficiently","representative","view","intend","purpose","high","risk","system"],"words":["without","prejudice","to","paragraph","and","to","the extent","the deployer","exercise","control","over","the","input","datum","that deployer","shall","ensure","that","input","datum","be","relevant","and","sufficiently","representative","in","view","of","the","intend","purpose","of","the","high","risk","ai","system"],"unmatched_count":15,"match_length":22,"cut_length":37},{"key":"399","text_words":[["5","X",""],null,["deployers","NOUN","deployer"],["shall","AUX",""],["monitor","VERB",""],["the","DET",""],["operation","NOUN",""],["of","ADP",""],["the","DET",""],["high","ADJ",""],null,["risk","NOUN",""],["ai","PROPN",""],["system","NOUN",""],["on","ADP",""],["the","DET",""],["basis","NOUN",""],["of","ADP",""],["the","DET",""],["instructions","NOUN","instruction"],["for","ADP",""],["use","NOUN",""],["and","CCONJ",""],null,["where","SCONJ",""],["relevant","ADJ",""],null,["inform","VERB",""],["providers","NOUN