NJ",""],["regulations","NOUN","regulation"],null,["among","ADP",""],["other","ADJ",""],["factors","NOUN","factor"],null,["ai","PROPN",""],["actors","NOUN","actor"],["developing","VERB","develop"],["ai","PROPN",""],["systems","NOUN","system"],["in","ADP",""],["countries","NOUN","country"],["which","PRON",""],["have","AUX",""],["established","VERB","establish"],["or","CCONJ",""],["adopted","VERB","adopt"],["ethical","ADJ",""],["standards","NOUN","standard"],["on","ADP",""],["ai","PROPN",""],["should","AUX",""],["respect","VERB",""],["these","DET",""],["standards","NOUN","standard"],["when","SCONJ",""],["exporting","VERB","export"],["these","DET",""],["products","NOUN","product"],null,["developing","VERB","develop"],["or","CCONJ",""],["applying","VERB","apply"],["their","PRON",""],["ai","PROPN",""],["systems","NOUN","system"],["in","ADP",""],["countries","NOUN","country"],["where","SCONJ",""],["such","ADJ",""],["standards","NOUN","standard"],["may","AUX",""],["not","PART",""],["exist","VERB",""],null,["while","SCONJ",""],["respecting","VERB","respect"],["applicable","ADJ",""],["international","ADJ",""],["law","NOUN",""],["and","CCONJ",""],["domestic","ADJ",""],["legislation","NOUN",""],null,["standards","NOUN","standard"],["and","CCONJ",""],["practices","NOUN","practice"],["of","ADP",""],["these","DET",""],["countries","NOUN","country"],null],"text":"Member States should take appropriate steps to ensure competitive markets and consumer protection, considering possible measures and mechanisms at national, regional and international levels, to prevent abuse of dominant market positions, including by monopolies, in relation to AI systems throughout their life cycle, whether these are data, research, technology, or market.Member States should prevent the resulting inequalities, assess relevant markets and promote competitive markets.Due consideration should be given to LMICs, in particular LDCs, LLDCs and SIDS, which are more exposed and vulnerable to the possibility of abuses of market dominance as a result of a lack of infrastructure, human capacity and regulations, among other factors.AI actors developing AI systems in countries which have established or adopted ethical standards on AI should respect these standards when exporting these products, developing or applying their AI systems in countries where such standards may not exist, while respecting applicable international law and domestic legislation, standards and practices of these countries.","idx":160,"match_words":["member states","take","appropriate","step","ensure","market","consumer protection","consider","possible","measure","mechanism","national","regional","international","level","prevent","abuse","market","position","include","relation","system","their life cycle","datum","research","technology","market","member states","prevent","result","inequality","assess","relevant","market","promote","market","due","consideration","give","lmic","particular","ldc","lldc","sids","more","vulnerable","the possibility","abuse","market dominance","a result","a lack","infrastructure","human capacity","regulation","other","factor","actor","develop","system","country","have","establish","adopt","ethical","standard","respect","standard","product","develop","apply","system","country","such","standard","exist","respect","applicable international law","domestic legislation","standard","practice","country"],"words":["member states","should","take","appropriate","step","to","ensure","competitive","market","and","consumer protection","consider","possible","measure","and","mechanism","at","national","regional","and","international","level","to","prevent","abuse","of","dominant","market","position","include","by","monopoly","in","relation","to","ai","system","throughout","their life cycle","whether","these","be","datum","research","technology","or","market","member states","should","prevent","the","result","inequality","assess","relevant","market","and","promote","competitive","market","due","c