"rural","ADJ",""],["and","CCONJ",""],["urban","ADJ",""],["areas","NOUN","area"],null,["and","CCONJ",""],["among","ADP",""],["all","DET",""],["persons","NOUN","person"],["regardless","ADV",""],["of","ADP",""],["race","NOUN",""],null,["colour","NOUN",""],null,["descent","NOUN",""],null,["gender","NOUN",""],null,["age","NOUN",""],null,["language","NOUN",""],null,["religion","NOUN",""],null,["political","ADJ",""],["opinion","NOUN",""],null,["national","ADJ",""],["origin","NOUN",""],null,["ethnic","ADJ",""],["origin","NOUN",""],null,["social","ADJ",""],["origin","NOUN",""],null,["economic","ADJ",""],["or","CCONJ",""],["social","ADJ",""],["condition","NOUN",""],["of","ADP",""],["birth","NOUN",""],null,["or","CCONJ",""],["disability","NOUN",""],["and","CCONJ",""],["any","DET",""],["other","ADJ",""],["grounds","NOUN","ground"],null,["in","ADP",""],["terms","NOUN","term"],["of","ADP",""],["access","NOUN",""],["to","ADP",""],["and","CCONJ",""],["participation","NOUN",""],["in","ADP",""],["the","DET",""],["ai","PROPN",""],["system","NOUN",""],["life","NOUN",""],["cycle","NOUN",""],null,["at","ADP","at"],["the","DET",""],["international","ADJ",""],["level","NOUN",""],null,["the","DET",""],["most","ADV",""],["technologically","ADV",""],["advanced","ADJ",""],["countries","NOUN","country"],["have","VERB",""],["a","DET",""],["responsibility","NOUN",""],["of","ADP",""],["solidarity","NOUN",""],["with","ADP",""],["the","DET",""],["least","ADJ",""],["advanced","ADJ",""],["to","PART",""],["ensure","VERB",""],["that","SCONJ",""],["the","DET",""],["benefits","NOUN","benefit"],["of","ADP",""],["ai","PROPN",""],["technologies","NOUN","technology"],["are","AUX","be"],["shared","VERB","share"],["such","DET",""],["that","DET",""],["access","NOUN",""],["to","ADP",""],["and","CCONJ",""],["participation","NOUN",""],["in","ADP",""],["the","DET",""],["ai","PROPN",""],["system","NOUN",""],["life","NOUN",""],["cycle","NOUN",""],["for","ADP",""],["the","DET",""],["latter","ADJ",""],["contributes","NOUN","contribute"],["to","ADP",""],["a","DET",""],["fairer","ADJ","fair"],["world","NOUN",""],["order","NOUN",""],["with","ADP",""],["regard","NOUN",""],["to","ADP",""],["information","NOUN",""],null,["communication","NOUN",""],null,["culture","NOUN",""],null,["education","NOUN",""],null,["research","NOUN",""],["and","CCONJ",""],["socio","NOUN",""],null,["economic","ADJ",""],["and","CCONJ",""],["political","ADJ",""],["stability","NOUN",""],null],"text":"AI actors should promote social justice and safeguard fairness and non-discrimination of any kind in compliance with international law.This implies an inclusive approach to ensuring that the benefits of AI technologies are available and accessible to all, taking into consideration the specific needs of different age groups, cultural systems, different language groups, persons with disabilities, girls and women, and disadvantaged, marginalized and vulnerable people or people in vulnerable situations.Member States should work to promote inclusive access for all, including local communities, to AI systems with locally relevant content and services, and with respect for multilingualism and cultural diversity.Member States should work to tackle digital divides and ensure inclusive access to and participation in the development of AI.At the national level, Member States should promote equity between rural and urban areas, and among all persons regardless of race, colour, descent, gender, age, language, religion, political opinion, national origin, ethnic origin, social origin, economic or social condition of birth, or disability and any other grounds, in terms of access to and participation in the AI system life cycle.At the international level, the most technologically advanced countries have a responsibility of solidarity with the least advanced to ensure that the benefits of AI technologies are shared such that access to and participation in the AI system life cycle for the latter contributes to a fairer world order with regard to information, communication, culture, education, research and socio-economic and political stability.","idx":62,"match_words":["actor","promote","social justice","safeguard","fairness","non","discrimination","any kind","compliance","international law","an inclusive approach","ensure","benefit","technology","available","accessible","take","consideration","specific","need","different","age","group","cultural","system","different","language","group","person","disability","girl","woman","marginalized and vulnerable people","people","vulnerable","situation","member states","work","promote","inclusive access","include","local","community","system","locally relevant content","service","respect","cultural diversity","member states","work","tackle","digital","divide","ensure","inclusive access","participation","the development","the national level","member states","promote","area","person","regardless","race","colour","descent","gender","age","language","religion","political opinion","national origin","ethnic origin","social origin","economic or social condition","birth","disability","other","ground","term","access","participation","the ai system life cycle","the international level","technologically","advanced","country","have","a responsibility","solidarity","least","advanced","ensure","benefit","technology","share","such that access","participation","the ai system life cycle","contribute","fair","world","order","regard","information","communication","culture","education","research","socio","economic","political"],"words":["ai","actor","should","promote","social justice","and","safeguard","fairness","and","non","discrimination","of","any kind","in","compliance","with","international law","this","imply","an inclusive approach","to","ensure","that","the","benefit","of","ai","technology","be","available","and","accessible","to","all","take","into","consideration","the","specific","need","of","different","age","group","cultural","system","different","language","group","person","with","disability","girl","and","woman","and","disadvantaged","marginalized and vulnerable people","or","people","in","vulnerable","situation","member states","should","work","to","promote","inclusive access","for","all","include","local","community","to","ai","system","with","locally relevant content","and","service","and","with","respect","for","multilingualism","and","cultural diversity","member states","should","work","to","tackle","digital","divide","and","ensure","inclusive access","to","and","participation","in","the development","of","ai","at","the national level","member states","should","promote","equity","between","rural","and","urban","area","and","among","all","person","regardless","of","race","colour","descent","gender","age","language","religion","political opinion","national origin","ethnic origin","social origin","economic or social condition","of","birth","or","disability","and","any","other","ground","in","term","of","access","to","and","participation","in","the ai system life cycle","at","the international level","the","most","technologically","advanced","country","have","a responsibility","of","solidarity","with","the","least","advanced","to","ensure","that","the","benefit","of","ai","technology","be","share","such that access","to","and","participation","in","the ai system life cycle","for","the","latter","contribute","to","a","fair","world","order","with","regard","to","information","communication","culture","education","research","and","socio","economic","and","political","stability"],"unmatched_count":93,"match_length":112,"cut_length":205},{"key":"63","text_words":[["ai","PROPN",""],["actors","NOUN","actor"],["should","AUX",""],["make","VERB",""],["all","DET",""],["reasonable","ADJ",""],["efforts","NOUN","effort"],["to","PART",""],["minimize","VERB",""],["and","CCONJ",""],["avoid","VERB",""],["reinforcing","VERB","reinforce"],["or","CCONJ",""],["perpetuating","VERB","perpetuate"],["discriminatory","ADJ",""],["or","CCONJ",""],["biased","ADJ",""],["applications","NOUN","application"],["and","CCONJ",""],["outcomes","NOUN","outcome"],["throughout","ADP",""],["the","DET",""],["life","NOUN",""],["cycle","NOUN",""],["of","ADP",""],["the","DET",""],["ai","PROPN",""],["system","NOUN",""],["to","PART",""],["ensure","VERB",""],["fairness","NOUN",""],["of","ADP",""],["such","ADJ",""],["systems","NOUN","system"],null,["effective","ADJ","effective"],["remedy","NOUN",""],["should","AUX",""],["be","AUX",""],["available","ADJ",""],["against","ADP",""],["discrimination","NOUN",""],["and","CCONJ",""],["biased","ADJ",""],["algorithmic","ADJ",""],["determination","NOUN",""],null],"text":"AI actors should make all reasonable efforts to minimize and avoid reinforcing or perpetuating discriminatory or biased applications and outcomes throughout the life cycle of the AI system to ensure fairness of such systems.Effective remedy should be available against discrimination and biased algorithmic determination.","idx":63,"match_words":["actor","make","effort","avoid","reinforce","application","outcome","the life cycle","the ai system","ensure","fairness","such","system","effective remedy","available","discrimination","biased algorithmic determination"],"words":["ai","actor","should","make","all","reasonable","effort","to","minimize","and","avoid","reinforce","or","perpetuate","discriminatory","or","biased","application","and","outcome","throughout","the life cycle","of","the ai system","to","ensure","fairness","of","such","system","effective remedy","should","be","available","against","discrimination","and","biased algorithmic determination"],"unmatched_count":21,"match_length":17,"cut_length":38},{"key":"64","text_words":[["furthermore","ADV","furthermore"],null,["digital","ADJ",""],["and","CCONJ",""],["knowledge","NOUN",""],["divides","NOUN","divide"],["within","ADP",""],["and","CCONJ",""],["between","ADP",""],["countries","NOUN","country"],["need","VERB",""],["to","PART",""],["be","AUX",""],["addressed","VERB","address"],["throughout","ADP",""],["an","DET",""],["ai","PROPN",""],["system","NOUN",""],["life","NOUN",""],["cycle","NOUN",""],null,["including","VERB","include"],["in","ADP",""],["terms","NOUN","term"],["of","ADP",""],["access","NOUN",""],["and","CCONJ",""],["quality","NOUN",""],["of","ADP",""],["access","NOUN",""],["to","ADP",""],["technology","NOUN",""],["and","CCONJ",""],["data","NOUN","datum"],null,["in","ADP",""],["accordance","NOUN",""],["with","ADP",""],["relevant","ADJ",""],["national","ADJ",""],null,["regional","ADJ",""],["and","CCONJ",""],["international","ADJ",""],["legal","ADJ",""],["frameworks","NOUN","framework"],null,["as","ADV",""],["well","ADV",""],["as","ADP",""],["in","ADP",""],["terms","NOUN","term"],["of","ADP",""],["connectivity","NOUN",""],null,["knowledge","NOUN",""],["and","CCONJ",""],["skills","NOUN","skill"],["and","CCONJ",""],["meaningful","ADJ",""],["participation","NOUN",""],["of","ADP",""],["the","DET",""],["affected","ADJ",""],["communities","NOUN","community"],null,["such","ADJ",""],["that","SCONJ",""],["every","DET",""],["person","NOUN",""],["is","AUX","be"],["treated","VERB","treat"],["equitably","ADV",""],null],"text":"Furthermore, digital and knowledge divides within and between countries need to be addressed throughout an AI system life cycle, including in terms of access and quality of access to technology and data, in accordance with relevant national, regional and international legal frameworks, as well as in terms of connectivity, knowledge and skills and meaningful participation of the affected communities, such that every person is treated equitably.","idx":64,"match_words":["furthermore","digital","knowledge","divide","country","need","address","an ai system life cycle","include","term","access","quality","access","technology","datum","accordance","relevant","national","regional","international","legal","framework","well","term","knowledge","skill","meaningful participation","community","such","every person"],"words":["fur