UN",""],["intensive","ADJ",""],["or","CCONJ",""],["resource","NOUN",""],null,["intensive","ADJ",""],["character","NOUN",""],["of","ADP",""],["some","PRON",""],["of","ADP",""],["them","PRON","they"],["and","CCONJ",""],["the","DET",""],["respective","ADJ",""],["impact","NOUN",""],["on","ADP",""],["the","DET",""],["environment","NOUN",""],null,["member","PROPN",""],["states","PROPN",""],["should","AUX",""],["ensure","VERB",""],["that","SCONJ",""],["ai","PROPN",""],["actors","NOUN","actor"],null,["inline","VERB",""],["with","ADP",""],["the","DET",""],["principle","NOUN",""],["of","ADP",""],["proportionality","NOUN",""],null,["favour","NOUN",""],["data","NOUN","datum"],null,["energy","NOUN",""],["and","CCONJ",""],["resource","NOUN",""],null,["efficient","ADJ",""],["ai","PROPN",""],["methods","NOUN","method"],null,["requirements","NOUN","requirement"],["should","AUX",""],["be","AUX",""],["developed","VERB","develop"],["to","PART",""],["ensure","VERB",""],["that","SCONJ",""],["appropriate","ADJ",""],["evidence","NOUN",""],["is","AUX","be"],["available","ADJ",""],["to","PART",""],["show","VERB",""],["that","SCONJ",""],["an","DET",""],["ai","PROPN",""],["application","NOUN",""],["will","AUX",""],["have","VERB",""],["the","DET",""],["intended","VERB","intend"],["effect","NOUN",""],null,["or","CCONJ",""],["that","SCONJ",""],["safeguards","NOUN","safeguard"],["accompanying","VERB","accompany"],["an","DET",""],["ai","PROPN",""],["application","NOUN",""],["can","AUX",""],["support","VERB",""],["the","DET",""],["justification","NOUN",""],["for","ADP",""],["its","PRON",""],["use","NOUN",""],null,["if","SCONJ","if"],["this","PRON",""],["can","AUX",""],["not","PART",""],["be","AUX",""],["done","VERB","do"],null,["the","DET",""],["precautionary","ADJ",""],["principle","NOUN",""],["must","AUX",""],["be","AUX",""],["favoured","VERB","favour"],null,["and","CCONJ",""],["in","ADP",""],["instances","NOUN","instance"],["where","SCONJ",""],["there","PRON",""],["are","VERB","be"],["disproportionate","ADJ",""],["negative","ADJ",""],["impacts","NOUN","impact"],["on","ADP",""],["the","DET",""],["environment","NOUN",""],null,["ai","PROPN",""],["should","AUX",""],["not","PART",""],["be","AUX",""],["used","VERB","use"],null],"text":"When choosing AI methods, given the potential data- intensive or resource-intensive character of some of them and the respective impact on the environment, Member States should ensure that AI actors, inline with the principle of proportionality, favour data, energy and resource-efficient AI methods.Requirements should be developed to ensure that appropriate evidence is available to show that an AI application will have the intended effect, or that safeguards accompanying an AI application can support the justification for its use.If this cannot be done, the precautionary principle must be favoured, and in instances where there are disproportionate negative impacts on the environment, AI should not be used.","idx":126,"match_words":["choose","method","give","potential","intensive","resource","intensive","the respective impact","the environment","member states","ensure","actor","the principle","proportionality","datum","energy","resource","efficient","method","requirement","develop","ensure","appropriate evidence","available","an ai application","have","intend","effect","safeguard","an ai application","support","the justification","its use","the precautionary principle","negative","impact","the environment","use"],"words":["when","choose","ai","method","give","the","potential","data-","intensive","or","resource","intensive","character","of","some","of","they","and","the respective impact","on","the environment","member states","should","ensure","that","ai","actor","inline","with","the principle","of","proportionality","favour","datum","energy","and","resource","efficient","ai","method","requirement","should","be","develop","to","ensure","that","appropriate evidence","be","available","to","show","that","an ai application","will","have","the","intend","effect","or","that","safeguard","accompany","an ai application","can","support","the justification","for","its use","if","this","can","not","be","do","the precautionary principle","must","be","favour","and","in","instance","where","there","be","disproportionate","negative","impact","on","the environment","ai","should","not","be","use"],"unmatched_count":57,"match_length":38,"cut_length":95},{"key":"128","text_words":[["member","PROPN",""],["states","PROPN",""],["should","AUX",""],["ensure","VERB",""],["that","SCONJ",""],["the","DET",""],["potential","NOUN",""],["for","ADP",""],["digital","ADJ",""],["technologies","NOUN","technology"],["and","CCONJ",""],["artificial","ADJ",""],["intelligence","NOUN",""],["to","PART",""],["contribute","VERB",""],["to","ADP",""],["achieving","VERB","achieve"],["gender","NOUN",""],["equality","NOUN",""],["is","AUX","be"],["fully","ADV",""],["maximized","VERB","maximize"],null,["and","CCONJ",""],["must","AUX",""],["ensure","VERB",""],["that","SCONJ",""],["the","DET",""],["human","ADJ",""],["rights","NOUN","right"],["and","CCONJ",""],["fundamental","ADJ",""],["freedoms","NOUN","freedom"],["of","ADP",""],["girls","NOUN","girl"],["and","CCONJ",""],["women","NOUN","woman"],null,["and","CCONJ",""],["their","PRON",""],["safety","NOUN",""],["and","CCONJ",""],["integrity","NOUN",""],["are","AUX","be"],["not","PART",""],["violated","VERB","violate"],["at","ADP",""],["any","DET",""],["stage","NOUN",""],["of","ADP",""],["the","DET",""],["ai","PROPN",""],["system","NOUN",""],["life","NOUN",""],["cycle","NOUN",""],null,["moreover","ADV","moreover"],null,["ethical","PROPN",""],["impact","PROPN",""],["assessment","PROPN",""],["should","AUX",""],["include","VERB",""],["a","DET",""],["transversal","ADJ",""],["gender","NOUN",""],["perspective","NOUN",""],null],"text":"Member States should ensure that the potential for digital technologies and artificial intelligence to contribute to achieving gender equality is fully maximized, and must 