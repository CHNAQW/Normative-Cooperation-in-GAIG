uation","NOUN",""],null,["a","DET",""],["contextual","ADJ",""],["assessment","NOUN",""],["will","AUX",""],["be","AUX",""],["necessary","ADJ",""],["to","PART",""],["manage","VERB",""],["potential","ADJ",""],["tensions","NOUN","tension"],null,["taking","VERB","take"],["into","ADP",""],["account","NOUN",""],["the","DET",""],["principle","NOUN",""],["of","ADP",""],["proportionality","NOUN",""],["and","CCONJ",""],["in","ADP",""],["compliance","NOUN",""],["with","ADP",""]],"text":"While all the values and principles outlined below are desirable per se, in any practical contexts, there may be tensions between these values and principles.In any given situation, a contextual assessment will be necessary to manage potential tensions, taking into account the principle of proportionality and in compliance with","idx":36,"match_words":["value","principle","outline","below","context","tension","value","principle","give","situation","a contextual assessment","necessary","potential","tension","take","account","the principle","proportionality","compliance"],"words":["while","all","the","value","and","principle","outline","below","be","desirable","per","in","any","practical","context","there","may","be","tension","between","these","value","and","principle","in","any","give","situation","a contextual assessment","will","be","necessary","to","manage","potential","tension","take","into","account","the principle","of","proportionality","and","in","compliance","with"],"unmatched_count":27,"match_length":19,"cut_length":46},{"key":"37","text_words":[["human","ADJ",""],["rights","NOUN","right"],["and","CCONJ",""],["fundamental","ADJ",""],["freedoms","NOUN","freedom"],null,["in","ADP","in"],["all","DET",""],["cases","NOUN","case"],null,["any","DET",""],["possible","ADJ",""],["limitations","NOUN","limitation"],["on","ADP",""],["human","ADJ",""],["rights","NOUN","right"],["and","CCONJ",""],["fundamental","ADJ",""],["freedoms","NOUN","freedom"],["must","AUX",""],["have","VERB",""],["a","DET",""