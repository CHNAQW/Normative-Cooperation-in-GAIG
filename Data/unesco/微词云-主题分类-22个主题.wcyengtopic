f AI is appropriate and, if so, should include further assessment to determine what the appropriate method is, as well as assessment as to whether such adoption would result in violations or abuses of Member States’ human rights law obligations, and if that is the case, prohibit its use.","idx":97,"match_words":["member states","public","authority","carry","transparent","self","assessment","exist","system","particular","include","the assessment","the adoption","appropriate","include","further assessment","determine","the appropriate method","well","assessment","such adoption","result","abuse","member","states","human","right","law","obligation","the case","its use"],"words":["member states","and","public","authority","should","carry","out","transparent","self","assessment","of","exist","and","propose","ai","system","which","in","particular","should","include","the assessment","of","whether","the adoption","of","ai","be","appropriate","and","if","so","should","include","further assessment","to","determine","what","the appropriate method","be","as","well","as","assessment","as","to","whether","such adoption","would","result","in","violation","or","abuse","of","member","states","’","human","right","law","obligation","and","if","that","be","the case","prohibit","its use"],"unmatched_count":38,"match_length":31,"cut_length":69},{"key":"99","text_words":[["member","PROPN",""],["states","PROPN",""],["should","AUX",""],["encourage","VERB",""],["public","ADJ",""],["entities","NOUN","entity"],null,["private","ADJ",""],["sector","NOUN",""],["companies","NOUN","company"],["and","CCONJ",""],["civil","ADJ",""],["society","NOUN",""],["organizations","NOUN","organization"],["to","PART",""],["involve","VERB",""],["different","ADJ",""],["stakeholders","NOUN","stakeholder"],["in","ADP",""],["their","PRON",""],["ai","PROPN",""],["governance","NOUN",""],["and","CCONJ",""],["to","PART",""],["consider","VERB",""],["adding","VERB","add"],["the","DET",""],["role","NOUN",""],["of","ADP",""],