der and adaptive governance and collaboration","idx":85,"match_words":["multi","stakeholder","adaptive governance","collaboration"],"words":["multi","stakeholder","and","adaptive governance","and","collaboration"],"unmatched_count":2,"match_length":4,"cut_length":6},{"key":"87","text_words":[["international","ADJ","international"],["law","NOUN",""],["and","CCONJ",""],["national","ADJ",""],["sovereignty","NOUN",""],["must","AUX",""],["be","AUX",""],["respected","VERB","respect"],["in","ADP",""],["the","DET",""],["use","NOUN",""],["of","ADP",""],["data","NOUN","datum"],null,["that","PRON","that"],["means","VERB","mean"],["that","SCONJ",""],["states","PROPN",""],null,["complying","VERB","comply"],["with","ADP",""],["international","ADJ",""],["law","NOUN",""],null,["can","AUX",""],["regulate","VERB",""],["the","DET",""],["data","NOUN","datum"],["generated","VERB","generate"],["within","ADP",""],["or","CCONJ",""],["passing","VERB","pass"],["through","ADP",""],["their","PRON",""],["territories","NOUN","territory"],null,["and","CCONJ",""],["take","VERB",""],["measures","NOUN","measure"],["towards","ADP",""],["effective","ADJ",""],["regulation","NOUN",""],["of","ADP",""],["data","NOUN","datum"],null,["including","VERB","include"],["data","NOUN",""],["protection","NOUN",""],null,["based","VERB","base"],["on","ADP",""],["respect","NOUN",""],["for","ADP",""],["the","DET",""],["right","NOUN",""],["to","ADP",""],["privacy","NOUN",""],["in","ADP",""],["accordance","NOUN",""],["with","ADP",""],["international","ADJ",""],["law","NOUN",""],["and","CCONJ",""],["other","ADJ",""],["human","ADJ",""],["rights","NOUN","right"],["norms","NOUN","norm"],["and","CCONJ",""],["standards","NOUN","standard"],null],"text":"International law and national sovereignty must be respected in the use of data.That means that States, complying with international law, can regulate the data generated within or passing through their territories, and take measures towards effective regulation of data, including data protection, based on respect for the right to privacy in accordance with international law and other human rights norms and standards.","idx":86,"match_words":["international law","national sovereignty","respect","the use","datum","mean","states","comply","international law","regulate","datum","territory","take","measure","effective regulation","datum","include","data protection","base","respect","the right","privacy","accordance","international law","other","human","right","norm","standard"],"words":["international law","and","national sovereignty","must","be","respect","in","the use","of","datum","that","mean","that","states","comply","with","international law","can","regulate","the","datum","generate","within","or","pass","through","their","territory","and","take","measure","towards","effective regulation","of","datum","include","data protection","base","on","respect","for","the right","to","privacy","in","accordance","with","international law","and","other","human","right","norm","and","standard"],"unmatched_count":26,"match_length":29,"cut_length":55},{"key":"88","text_words":[["participation","NOUN","participation"],["of","ADP",""],["different","ADJ",""],["stakeholders","NOUN","stakeholder"],["throughout","ADP",""],["the","DET",""],["ai","PROPN",""],["system","NOUN",""],["life","NOUN",""],["cycle","NOUN",""],["is","AUX","be"],["necessary","ADJ",""],["for","ADP",""],["inclusive","ADJ",""],["approaches","NOUN","approach"],["to","ADP",""],["ai","PROPN",""],["governance","NOUN",""],null,["enabling","VERB","enable"],["the","DET",""],["benefits","NOUN","benefit"],["to","PART",""],["be","AUX",""],["shared","VERB","share"],["by","ADP",""],["all","PRON",""],null,["and","CCONJ",""],["to","PART",""],["contribute","VERB",""],["to","ADP",""],["sustainable","ADJ",""],["development","NOUN",""],null,["stakeholders","NOUN","stakeholder"],["include","VERB",""],["but","CCONJ",""],["are","AUX","be"],["not","PART",""],["limited","VERB","limit"],["to","ADP",""],["governments","NOUN","government"],null,["intergovernmental","ADJ",""],["organizations","NOUN","organization"],null,["the","DET",""],["technical","ADJ",""],["community","NOUN",""],null,["civil","ADJ",""],["society","NOUN",""],null,["researchers","NOUN","researcher"],["and","CCONJ",""],["academia","NOUN",""],null,["media","NOUN","medium"],null,["education","NOUN",""],null,["policy","NOUN",""],null,["makers","NOUN","maker"],null,["private","ADJ",""],["sector","NOUN",""],["companies","NOUN","company"],null,["human","ADJ",""],["rights","NOUN","right"],["institutions","NOUN","institution"],["and","CCONJ",""],["equality","NOUN",""],["bodies","NOUN","body"],null,["anti","ADJ",""],null,["discrimination","ADJ",""],["monitoring","NOUN",""],["bodies","NOUN","body"],null,["and","CCONJ",""],["groups","NOUN","group"],["for","ADP",""],["youth","NOUN",""],["and","CCONJ",""],["children","NOUN","child"],null,["the","DET","the"],["adoption","NOUN",""],["of","ADP",""],["open","ADJ",""],["standards","NOUN","standard"],["and","CCONJ",""],["interoperability","NOUN",""],["to","PART",""],["facilitate","VERB",""],["collaboration","NOUN",""],["should","AUX",""],["be","AUX",""],["in","ADP",""],["place","NOUN",""],null,["measures","NOUN","measure"],["should","AUX",""],["be","AUX",""],["adopted","VERB","adopt"],["to","PART",""],["take","VERB",""],["into","ADP",""],["account","NOUN",""],["shifts","NOUN","shift"],["in","ADP",""],["technologies","NOUN","technology"],null,["the","DET",""],["emergence","NOUN",""],["of","ADP",""],["new","ADJ",""],["groups","NOUN","group"],["of","ADP",""],["stakeholders","NOUN","stakeholder"],null,["and","CCONJ",""],["to","PART",""],["allow","VERB",""],["for","ADP",""],["meaningful","ADJ",""],["participation","NOUN",""],["by","ADP",""],["marginalized","ADJ",""],["groups","NOUN","group"],null,["communities","NOUN","community"],["and","CCONJ",""],["individuals","NOUN","individual"],["and","CCONJ",""],null,["where","SCONJ",""],["relevant","ADJ",""],null,["in","ADP",""],["the","DET",""],["case","NOUN",""],["of","ADP",""],["indigenous","ADJ","indigenous"],["peoples","PROPN",""],null,["respect","NOUN",""],["for","ADP",""],["the","DET",""],["self","NOUN",""],null,["governance","NOUN",""],["of","ADP",""],["their","PRON",""],["data","NOUN","datum"],null],"text":"Participation of different stakeholders throughout the AI system life cycle is necessary for inclusive approaches to AI governance, enabling the benefits to be shared by all, and to contribute to sustainable development.Stakeholders include but are not limited to governments, intergovernmental organizations, the technical community, civil society, researchers and academia, media, education, policy-makers, private sector companies, human rights institutions and equality bodies, anti-discrimination monitoring bodies, and groups for youth and children.The adoption of open standards and interoperability to facilitate collaboration should be in place.Measures should be adopted to take into account shifts in technologies, the emergence of new groups of stakeholders, and to allow for meaningful participation by marginalized groups, communities and individuals and, where relevant, in the case of Indigenous Peoples, respect for the self-governance of their data.","idx":87,"match_words":["participation","different","stakeholder","the ai system life cycle","necessary","inclusive","approach","ai governance","enable","benefit","share","contribute","sustainable development","stakeholder","include","limit","government","intergovernmental","organization","the technical community","civil society","researcher","academia","medium","education","policy","private","sector","company","human","right","institution","equality","body","discrimination","monitoring","body","group","child","the adoption","open","standard","facilitate","collaboration","place","measure","adopt","take","account","technology","new","group","stakeholder","allow","meaningful participation","marginalized","group","community","individual","releva