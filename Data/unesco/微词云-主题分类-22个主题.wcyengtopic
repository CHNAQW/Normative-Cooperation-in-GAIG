",""],["the","DET",""],["development","NOUN",""],["of","ADP",""],["sets","NOUN","set"],["of","ADP",""],["indicators","NOUN","indicator"],null,["data","NOUN","datum"],["collection","NOUN",""],["and","CCONJ",""],["processing","NOUN",""],["should","AUX",""],["be","AUX",""],["conducted","VERB","conduct"],["in","ADP",""],["accordance","NOUN",""],["with","ADP",""],["international","ADJ",""],["law","NOUN",""],null,["national","ADJ",""],["legislation","NOUN",""],["on","ADP",""],["data","NOUN",""],["protection","NOUN",""],["and","CCONJ",""],["data","NOUN","datum"],["privacy","NOUN",""],null,["and","CCONJ",""],["the","DET",""],["values","NOUN","value"],["and","CCONJ",""],["principles","NOUN","principle"],["outlined","VERB","outline"],["in","ADP",""],["this","DET",""],["recommendation","PROPN",""],null],"text":"In the interests of promoting best policies and practices related to ethics of AI, appropriate tools and indicators should be developed for assessing the effectiveness and efficiency thereof against agreed standards, priorities and targets, including specific targets for persons belonging to disadvantaged, marginalized populations, and vulnerable people or people invulnerable situations, as well as the impact of AI systems at individual and societal levels.The monitoring and assessment of the impact of AI systems and related AI ethics policies and practices should be carried out continuously in a systematic way proportionate to the relevant risks.This should be based on internationally agreed frameworks and involve evaluations of private and public institutions, providers and programmes, including self-evaluations, as well as tracer studies and the development of sets of indicators.Data collection and processing should be conducted in accordance with international law, national legislation on data protection and data privacy, and the values and principles outlined in this Recommendation.","idx":173,"match_words":["interest","promote","good","policy","practice","relate","ethic","appropriate","tool","develop","assess","the effectiveness","thereof","agree","standard","target","include","specific","target","person","marginalized","vulnerable people","people","invulnerable","situation","well","the impact","system","individual","societal","level","the monitoring","assessment","the impact","system","relate","ethic","policy","practice","carry","a systematic way","relevant","risk","base","internationally","agree","framework","involve","evaluation","private","public","institution","programme","include","self","evaluation","well","study","the development","set","datum","collection","processing","accordance","international law","national legislation","data protection","datum","privacy","value","principle","outline","this recommendation"],"words":["in","the","interest","of","promote","good","policy","and","practice","relate","to","ethic","of","ai","appropriate","tool","and","indicator","should","be","develop","for","assess","the effectiveness","and","efficiency","thereof","against","agree","standard","priority","and","target","include","specific","target","for","person","belong","to","disadvantaged","marginalized","population","and","vulnerable people","or","people","invulnerable","situation","as","well","as","the impact","of","ai","system","at","individual","and","societal","level","the monitoring","and","assessment","of","the impact","of","ai","system","and","relate","ai","ethic","policy","and","practice","should","be","carry","out","continuously","in","a systematic way","proportionate","to","the","relevant","risk","this","should","be","base","on","internationally","agree","framework","and","involve","evaluation","of","private","and","public","institution","provider","and","programme","include","self","evaluation","as","well","as","tracer","study","and","the development","of","set","of","indicator","datum","collection","and","processing","should","be","conduct","in","accordance","with","international law","national legislation","on","data protection","and","datum","privacy","and","the","value","and","principle","outline","in","this recommendation"],"unmatched_count":73,"match_length":73,"cut_length":146},{"key":"175","text_words":[["in","ADP","in"],["particular","ADJ",""],null,["member","PROPN",""],["states","PROPN",""],["may","AUX",""],["wish","VERB",""],["to","PART",""],["consider","VERB",""],["possible","ADJ",""],["mechanisms","NOUN","mechanism"],["for","ADP",""],["monitoring","NOUN",""],["and","CCONJ",""],["evaluation","NOUN",""],null,["such","ADJ",""],["as","ADP",""],["an","DET",""],["ethics","NOUN","ethic"],["commission","NOUN",""],null,["ai","PROPN",""],["ethics","NOUN","ethic"],["observatory","NOUN",""],null,["repository","NOUN",""],["covering","VERB","cover"],["human","ADJ",""],["rights","NOUN","right"],null,["compliant","ADJ",""],["and","CCONJ",""],["ethical","ADJ",""],["development","NOUN",""],["of","ADP",""],["ai","PROPN",""],["systems","NOUN","system"],null,["or","CCONJ",""],["contributions","NOUN","contribution"],["to","ADP",""],["existing","VERB","exist"],["initiatives","NOUN","initiative"],["by","ADP",""],["addressing","VERB","address"],["adherence","NOUN",""],["to","ADP",""],["ethical","ADJ",""],["principles","NOUN","principle"],["across","ADP",""],["unesco","PROPN",""],null,["areas","NOUN","area"],["of","ADP",""],["competence","NOUN",""],null,["an","DET",""],["experience-","NOUN",""],["sharing","NOUN",""],["mechanism","NOUN",""],null,["ai","PROPN",""],["regulatory","ADJ",""],["sandboxes","NOUN","sandbox"],null,["and","CCONJ",""],["an","DET",""],["assessment","NOUN",""],["guide","NOUN",""],["for","ADP",""],["all","DET",""],["ai","PROPN",""],["actors","NOUN","actor"],["to","PART",""],["evaluate","VERB",""],["their","PRON",""],["adherence","NOUN",""],["to","ADP",""],["policy","NOUN",""],["recommendations","NOUN","recommendation"],["mentioned","VERB","mention"],["in","ADP",""],["this","DET",""],["document","NOUN",""],null],"text":"In particular, Member States may wish to consider possible mechanisms for monitoring and evaluation, such as an ethics commission, AI ethics observatory, repository covering human rights-compliant and ethical development of AI systems, or contributions to existing initiatives by addressing adherence to ethical principles across UNESCO’s areas of competence, an experience- sharing mechanism, AI regulatory sandboxes, and an assessment guide for all AI actors to evaluate their adherence to policy recommendations mentioned in this document.","idx":174,"match_words":["particular","member states","consider","possible","mechanism","monitoring","evaluation","such","ethic","commission","ethic","repository","human","right","ethical","development","system","exist","initiative","address","adherence","ethical","principle","unesco","area","an experience- sharing mechanism","regulatory","an assessment guide","actor","evaluate","their adherence","policy","recommendation","this document"],"words":["in","particular","member states","may","wish","to","consider","possible","mechanism","for","monitoring","and","evaluation","such","as","an","ethic","commission","ai","ethic","observatory","repository","cover","human","right","compliant","and","ethical","development","of","ai","system","or","contribution","to","exist","initiative","by","address","adherence","to","ethical","principle","across","unesco","area","of","competence","an experience- sharing mechanism","ai","regulatory","sandbox","and","an assessment guide","for","all","ai","actor","to","evaluate","their adherence","to","policy","recommendation","mention","in","this document"],"unmatched_count":33,"match_length":34,"cut_length":67},{"key":"176","text_words":[["member","PROPN",""],["states","PROPN",""],["and","CCONJ",""],["all","DET",""],["other","ADJ",""],["stakeholders","NOUN","stakeholder"],["as","SCONJ",""],["identified","VERB","identify"],["in","ADP",""],["this","DET",""],["recommendation","PROPN",""],["should","AUX",""],["respect","VERB",""],null,["promote","VERB",""],["and","CCONJ",