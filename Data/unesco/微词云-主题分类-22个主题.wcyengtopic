stems","NOUN","ecosystem"],["and","CCONJ",""],["human","ADJ",""],["lives","NOUN","life"],null,["including","VERB","include"],["the","DET",""],["human","ADJ",""],["mind","NOUN",""],null,["in","ADP",""],["part","NOUN",""],["because","SCONJ",""],["of","ADP",""],["the","DET",""],["new","ADJ",""],["ways","NOUN","way"],["in","ADP",""],["which","PRON",""],["its","PRON",""],["use","NOUN",""],["influences","VERB","influence"],["human","ADJ",""],["thinking","NOUN",""],null,["interaction","NOUN",""],["and","CCONJ",""],["decision","NOUN",""],null,["making","NOUN",""],["and","CCONJ",""],["affects","VERB","affect"],["education","NOUN",""],null,["human","ADJ",""],null,["social","ADJ",""],["and","CCONJ",""],["natural","ADJ",""],["sciences","NOUN","science"],null,["culture","NOUN",""],null,["and","CCONJ",""],["communication","NOUN",""],["and","CCONJ",""],["information","NOUN",""],null],"text":"Recognizing the profound and dynamic positive and negative impacts of artificial intelligence (AI) on societies, environment, ecosystems and human lives, including the human mind, in part because of the new ways in which its use influences human thinking, interaction and decision-making and affects education, human, social and natural sciences, culture, and communication and information,","idx":2,"match_words":["recognize","dynamic","positive","negative","impact","artificial intelligence","society","environment","ecosystem","human","life","include","the human mind","part","new","way","its use","human thinking","interaction","decision","making","affect","education","human","social","natural","science","culture","communication","information"],"words":["recognize","the","profound","and","dynamic","positive","and","negative","impact","of","artificial intelligence","ai","on","society","environment","ecosystem","and","human","life","include","the human mind","in","part","because","of","the","new","way","in","which","its use","influence","human thinking","interaction","and","decision","making","and","affect","education","human","social","and","natural","science","culture","and","communication","and","information"],"unmatched_count":20,"match_length":30,"cut_length":50},{"key":"3","text_words":[["recalling","VERB","recall"],["that","PRON",""],null,["by","ADP",""],["the","DET",""],["terms","NOUN","term"],["of","ADP",""],["its","PRON",""],["constitution","PROPN",""],null,["unesco","PROPN",""],["seeks","VERB","seek"],["to","PART",""],["contribute","VERB",""],["to","ADP",""],["peace","NOUN",""],["and","CCONJ",""],["security","NOUN",""],["by","ADP",""],["promoting","VERB","promote"],["collaboration","NOUN",""],["among","ADP",""],["nations","NOUN","nation"],["through","ADP",""],["education","NOUN",""],null,["the","DET",""],["sciences","NOUN","science"],null,["culture","NOUN",""],null,["and","CCONJ",""],["communication","NOUN",""],["and","CCONJ",""],["information","NOUN",""],null,["in","ADP",""],["order","NOUN",""],["to","PART",""],["further","VERB",""],["universal","ADJ",""],["respect","NOUN",""],["for","ADP",""],["justice","NOUN",""],null,["for","ADP",""],["the","DET",""],["rule","NOUN",""],["of","ADP",""],["law","NOUN",""],["and","CCONJ",""],["for","ADP",""],["the","DET",""],["human","ADJ",""],["rights","NOUN","right"],["and","CCONJ",""],["fundamental","ADJ",""],["freedoms","NOUN","freedom"],["which","PRON",""],["are","AUX","be"],["affirmed","VERB","affirm"],["for","ADP",""],["the","DET",""],["peoples","NOUN","people"],["of","ADP",""],["the","DET",""],["world","NOUN",""],null],"text":"Recalling that, by the terms of its Constitution, UNESCO seeks to contribute to peace and security by promoting collaboration among nations through education, the sciences, culture, and communication and information, in order to further universal respect for justice, for the rule of law and for the human rights and fundamental freedoms which are affirmed for the peoples of the world,","idx":3,"match_words":["term","its constitution","unesco","contribute","security","promote","collabora