T",""],["access","VERB",""],["the","DET",""],["reasons","NOUN","reason"],["for","ADP",""],["a","DET",""],["decision","NOUN",""],["affecting","VERB","affect"],["their","PRON",""],["rights","NOUN","right"],["and","CCONJ",""],["freedoms","NOUN","freedom"],null,["and","CCONJ",""],["have","VERB",""],["the","DET",""],["option","NOUN",""],["of","ADP",""],["making","VERB","make"],["submissions","NOUN","submission"],["to","ADP",""],["a","DET",""],["designated","VERB","designate"],["staff","NOUN",""],["member","NOUN",""],["of","ADP",""],["the","DET",""],["private","ADJ",""],["sector","NOUN",""],["company","NOUN",""],["or","CCONJ",""],["public","ADJ",""],["sector","NOUN",""],["institution","NOUN",""],["able","ADJ",""],["to","PART",""],["review","VERB",""],["and","CCONJ",""],["correct","VERB",""],["the","DET",""],["decision","NOUN",""],null,["ai","PROPN",""],["actors","NOUN","actor"],["should","AUX",""],["inform","VERB",""],["users","NOUN","user"],["when","SCONJ",""],["a","DET",""],["product","NOUN",""],["or","CCONJ",""],["service","NOUN",""],["is","AUX","be"],["provided","VERB","provide"],["directly","ADV",""],["orwith","VERB",""],["the","DET",""],["assistance","NOUN",""],["of","ADP",""],["ai","PROPN",""],["systems","NOUN","system"],["in","ADP",""],["a","DET",""],["proper","ADJ",""],["and","CCONJ",""],["timely","ADJ",""],["manner","NOUN",""],null],"text":"While efforts need to be made to increase transparency and explainability of AI systems, including those with extra-territorial impact, throughout their life cycle to support democratic governance, the level of transparency and explainability should always be appropriate to the context and impact, as there may be a need to balance between transparency and explainability and other principles such as privacy, safety and security.People should be fully informed when a decision is informed by or is made on the basis of AI algorithms, including when it affects their safety or human rights, and in those circumstances should have the opportunity to request explanatory information from the relevant AI actor or public sector institutions.In addition, individuals should be able to access the reasons for a decision affecting their rights and freedoms, and have the option of making submissions to a designated staff member of the private sector company or public sector institution able to review and correct the decision.AI actors should inform users when a product or service is provided directly orwith the assistance of AI systems in a proper and timely manner.","idx":75,"match_words":["effort","need","make","increase","transparency","explainability","system","include","impact","their life cycle","support","democratic governance","the level","transparency","explainability","always","appropriate","the context","impact","a need","transparency","explainability","other","principle","such","privacy","safety","security","people","fully","inform","a decision","inform","make","the basis","algorithm","include","affect","their safety","human","right","circumstance","have","the opportunity","explanatory information","the relevant ai actor","public sector institution","addition","individual","able","access","reason","a decision","affect","right","freedom","have","the option","make","member","the private sector company","public","sector","institution","able","review","the decision","actor","inform","user","a product","service","provide","the assistance","system","a proper and timely manner"],"words":["while","effort","need","to","be","make","to","increase","transparency","and","explainability","of","ai","system","include","those","with","extra","territorial","impact","throughout","their life cycle","to","support","democratic governance","the level","of","transparency","and","explainability","should","always","be","appropriate","to","the context","and","impact","as","there","may","be","a need","to","balance","between","transparency","and","explainability","and","other","principle","such","as","privacy","safety","