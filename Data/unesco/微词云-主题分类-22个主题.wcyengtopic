ational levels.","idx":98,"match_words":["member states","encourage","public","entity","private","sector","company","civil","society","organization","involve","different","stakeholder","their ai governance","consider","the role","an independent ai ethics officer","some other mechanism","ethical impact assessment","monitoring","effort","ensure","ethical guidance","system","member states","private","sector","company","civil","society","organization","the support","unesco","encourage","create","a network","independent ai ethics officers","give","support","this process","national","regional","international","level"],"words":["member states","should","encourage","public","entity","private","sector","company","and","civil","society","organization","to","involve","different","stakeholder","in","their ai governance","and","to","consider","add","the role","of","an independent ai ethics officer","or","some other mechanism","to","oversee","ethical impact assessment","auditing","and","continuous","monitoring","effort","and","ensure","ethical guidance","of","ai","system","member states","private","sector","company","and","civil","society","organization","with","the support","of","unesco","be","encourage","to","create","a network","of","independent ai ethics officers","to","give","support","to","this process","at","national","regional","and","international","level"],"unmatched_count":27,"match_length":44,"cut_length":71},{"key":"100","text_words":[["member","PROPN",""],["states","PROPN",""],["should","AUX",""],["foster","VERB",""],["the","DET",""],["development","NOUN",""],["of","ADP",""],null,["and","CCONJ",""],["access","NOUN",""],["to","ADP",""],null,["a","DET",""],["digital","ADJ",""],["ecosystem","NOUN",""],["for","ADP",""],["ethical","ADJ",""],["and","CCONJ",""],["inclusive","ADJ",""],["development","NOUN",""],["of","ADP",""],["ai","PROPN",""],["systems","NOUN","system"],["at","ADP",""],["the","DET",""],["national","ADJ",""],["level","NOUN",""],null,["including","VERB","inc