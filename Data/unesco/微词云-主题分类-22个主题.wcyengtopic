"live","peaceful","just","interconnected","society","require","solidarity","a permanent search","peaceful","relation","care","other","the natural environment","broad","sense","the term"],"words":["the notion","of","human","be","interconnect","be","base","on","the knowledge","that","every human","belong","to","a","great","whole","which","thrive","when","all","its","constituent","part","be","enable","to","thrive","live","in","peaceful","just","and","interconnected","society","require","an","organic","immediate","uncalculated","bond","of","solidarity","characterize","by","a permanent search","for","peaceful","relation","tend","towards","care","for","other","and","the natural environment","in","the","broad","sense","of","the term"],"unmatched_count":37,"match_length":24,"cut_length":61},{"key":"55","text_words":[["this","DET","this"],["value","NOUN",""],["demands","VERB","demand"],["that","SCONJ",""],["peace","NOUN",""],null,["inclusiveness","NOUN",""],["and","CCONJ",""],["justice","NOUN",""],null,["equity","NOUN",""],["and","CCONJ",""],["interconnectedness","NOUN",""],["should","AUX",""],["be","AUX",""],["promoted","VERB","promote"],["throughout","ADP",""],["the","DET",""],["life","NOUN",""],["cycle","NOUN",""],["of","ADP",""],["ai","PROPN",""],["systems","NOUN","system"],null,["in","ADP",""],["so","ADV",""],["far","ADV",""],["as","SCONJ",""],["the","DET",""],["processes","NOUN","process"],["of","ADP",""],["the","DET",""],["life","NOUN",""],["cycle","NOUN",""],["of","ADP",""],["ai","PROPN",""],["systems","NOUN","system"],["should","AUX",""],["not","PART",""],["segregate","VERB",""],null,["objectify","VERB",""],["or","CCONJ",""],["undermine","VERB",""],["freedom","NOUN",""],["and","CCONJ",""],["autonomous","ADJ",""],["decision","NOUN",""],null,["making","NOUN",""],["as","ADV",""],["well","ADV",""],["as","ADP",""],["the","DET",""],["safety","NOUN",""],["of","ADP",""],["human","ADJ",""],["beings","NOUN","being"],["and","CCONJ",""],["communities","NOUN","community"],null,["divide","VERB",""],["and","CCONJ",""],["turn","VERB",""],["individuals","NOUN","individual"],["and","CCONJ",""],["groups","NOUN","group"],["against","ADP",""],["each","DET",""],["other","ADJ",""],null,["or","CCONJ",""],["threaten","VERB",""],["the","DET",""],["coexistence","NOUN",""],["between","ADP",""],["humans","NOUN","human"],null,["other","ADJ",""],["living","VERB","live"],["beings","NOUN","being"],["and","CCONJ",""],["the","DET",""],["natural","ADJ",""],["environment","NOUN",""],null],"text":"This value demands that peace, inclusiveness and justice, equity and interconnectedness should be promoted throughout the life cycle of AI systems, in so far as the processes of the life cycle of AI systems should not segregate, objectify or undermine freedom and autonomous decision-making as well as the safety of human beings and communities, divide and turn individuals and groups against each other, or threaten the coexistence between humans, other living beings and the natural environment.","idx":55,"match_words":["this value","demand","inclusiveness","justice","interconnectedness","promote","the life cycle","system","far","process","the life cycle","system","undermine","freedom","decision","making","well","the safety","human","being","community","divide","individual","group","other","the coexistence","human","other","live","being","the natural environment"],"words":["this value","demand","that","peace","inclusiveness","and","justice","equity","and","interconnectedness","should","be","promote","throughout","the life cycle","of","ai","system","in","so","far","as","the","process","of","the life cycle","of","ai","system","should","not","segregate","objectify","or","undermine","freedom","and","autonomous","decision","making","as","well","as","the safety","of","human","being","and","community","divide","and","turn","individual","and","group","against","each","other","or","threaten","the coexistence","between","human","other","live","being","and","the natural environment"],