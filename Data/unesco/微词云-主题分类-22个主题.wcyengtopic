UN",""],["held","VERB","hold"],["by","ADP",""],["private","ADJ",""],["entities","NOUN","entity"],null,["member","PROPN",""],["states","PROPN",""],null,["private","ADJ",""],["sector","NOUN",""],["companies","NOUN","company"],["and","CCONJ",""],["civil","ADJ",""],["society","NOUN",""],["should","AUX",""],["investigate","VERB",""],["the","DET",""],["sociological","ADJ",""],["and","CCONJ",""],["psychological","ADJ",""],["effects","NOUN","effect"],["of","ADP",""],["ai","PROPN",""],null,["based","VERB","base"],["recommendations","NOUN","recommendation"],["on","ADP",""],["humans","NOUN","human"],["in","ADP",""],["their","PRON",""],["decision","NOUN",""],null,["making","VERB","make"],["autonomy","NOUN",""],null,["ai","PROPN",""],["systems","NOUN","system"],["identified","VERB","identify"],["as","ADP",""],["potential","ADJ",""],["risks","NOUN","risk"],["to","ADP",""],["human","ADJ",""],["rights","NOUN","right"],["should","AUX",""],["be","AUX",""],["broadly","ADV",""],["tested","VERB","test"],["by","ADP",""],["ai","PROPN",""],["actors","NOUN","actor"],null,["including","VERB","include"],["in","ADP",""],["real","ADJ",""],null,["world","NOUN",""],["conditions","NOUN","condition"],["if","SCONJ",""],["needed","VERB","need"],null,["as","ADP",""],["part","NOUN",""],["of","ADP",""],["the","DET",""],["ethical","PROPN",""],["impact","PROPN",""],["assessment","PROPN",""],null,["before","ADP",""],["releasing","VERB","release"],["them","PRON","they"],["in","ADP",""],["the","DET",""],["market","NOUN",""],null],"text":"Member States and private sector companies should develop due diligence and oversight mechanisms to identify, prevent, mitigate and account for how they address the impact of AI systems on the respect for human rights, rule of law and inclusive societies.Member States should also be able to assess the socio- economic impact of AI systems on poverty and ensure that the gap between people living in wealth and poverty, as well as the digital divide among and within countries, are not increased with the massive adoption of AI technologies at present and in the future.In order to do this, in particular, enforceable transparency protocols should be implemented, corresponding to the access to information, including information of public interest held by private entities.Member States, private sector companies and civil society should investigate the sociological and psychological effects of AI-based recommendations on humans in their decision-making autonomy.AI systems identified as potential risks to human rights should be broadly tested by AI actors, including in real-world conditions if needed, as part of the Ethical Impact Assessment, before releasing them in the market.","idx":91,"match_words":["member states","private","sector","company","develop","due","diligence","oversight","mechanism","identify","prevent","mitigate","account","address","the impact","system","the respect","human","right","rule","law","inclusive","society","member states","also","able","assess","the socio- economic impact","system","ensure","the gap","people","live","well","the digital divide","country","increase","the massive adoption","technology","present","the future","order","particular","transparency","implement","the access","information","include","information","public interest","private","entity","member states","private","sector","company","civil society","investigate","effect","base","recommendation","human","decision","make","autonomy","system","identify","potential","risk","human","right","actor","include","world","condition","need","part","the ethical impact assessment","the market"],"words":["member states","and","private","sector","company","should","develop","due","diligence","and","oversight","mechanism","to","identify","prevent","mitigate","and","account","for","how","they","address","the impact","of","ai","system","on","the respect","for","human","right","rule","of","law","and","inclusive","society","member states","should","also","be","able","to","assess","the socio- economic impact","of","ai","system","on","poverty","and","ensure","that","the gap","between","people","live","in","wealth","and","poverty","as","well","as","the digital divide","among","and","within","country","be","not","increase","with","the massive adoption","of","ai","technology","at","present","and","in","the future","in","order","to","do","this","in","particular","enforceable","transparency","protocol","should","be","implement","correspond","to","the access","to","information","include","information","of","public interest","hold","by","private","entity","member states","private","sector","company","and","civil society","should","investigate","the","sociological","and","psychological","effect","of","ai","base","recommendation","on","human","in","their","decision","make","autonomy","ai","system","identify","as","potential","risk","to","human","right","should","be","broadly","test","by","ai","actor","include","in","real","world","condition","if","need","as","part","of","the ethical impact assessment","before","release","they","in","the market"],"unmatched_count":85,"match_length":79,"cut_length":164},{"key":"93","text_words":[["member","PROPN",""],["states","PROPN",""],["and","CCONJ",""],["business","NOUN",""],["enterprises","NOUN","enterprise"],["should","AUX",""],["implement","VERB",""],["appropriate","ADJ",""],["measures","NOUN","measure"],["to","PART",""],["monitor","VERB",""],["all","DET",""],["phases","NOUN","phase"],["of","ADP",""],["an","DET",""],["ai","PROPN",""],["system","NOUN",""],["life","NOUN",""],["cycle","NOUN",""],null,["including","VERB","include"],["the","DET",""],["functioning","NOUN",""],["of","ADP",""],["algorithms","NOUN","algorithm"],["used","VERB","use"],["for","ADP",""],["decision","NOUN",""],null,["making","NOUN",""],null,["the","DET",""],["data","NOUN","datum"],null,["as","ADV",""],["well","ADV",""],["as","ADP",""],["ai","PROPN",""],["actors","NOUN","actor"],["involved","VERB","involve"],["in","ADP",""],["the","DET",""],["process","NOUN",""],null,["especially","ADV",""],["in","ADP",""],["public","ADJ",""],["services","NOUN","service"],["and","CCONJ",""],["where","SCONJ",""],["direct","ADJ",""],["end","NOUN",""],null,["user","NOUN",""],["interaction","NOUN",""],["is","AUX","be"],["needed","VERB","need"],null,["as","ADP",""],["part","NOUN",""],["of","ADP",""],["ethical","ADJ",""],["impact","NOUN",""],["assessment","NOUN",""],null,["member","PROPN",""],["states","PROPN",""],["’","PART",""],["human","ADJ",""],["rights","NOUN","right"],["law","NOUN",""],["obligations","NOUN","obligation"],["should","AUX",""],["form","VERB",""],["part","NOUN",""],["of","ADP",""],["the","DET",""],["ethical","ADJ",""],["aspects","NOUN","aspect"],["of","ADP",""],["ai","PROPN",""],["system","NOUN",""],["assessments","NOUN","assessment"],null],"text":"Member States and business enterprises should implement appropriate measures to monitor all phases of an AI system life cycle, including the functioning of algorithms used for decision-making, the data, as well as AI actors involved in the process, especially in public services and where direct end-user interaction is needed, as part of ethical impact assessment.Member States’ human rights law obligations should form part of the ethical aspects of AI system assessments.","idx":92,"match_words":["member states","business","enterprise","implement","appropriate","measure","monitor","phase","an ai system life cycle","include","the functioning","algorithm","use","decision","making","datum","well","actor","involve","the process","especially","public","service","direct","end","user","interaction","need","part","ethical impact assessment","member","states","human","right","law","obligation","form","part","ethical","aspect","system","assessment"],"words":["member states","and","business","enterprise","should","implement","appropriate","measure","to","monitor","all","phase","of","an ai system life cycle","include","the functioning","of","algorithm","use","for","deci