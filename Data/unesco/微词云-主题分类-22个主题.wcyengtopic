","PROPN",""],null,["of","ADP",""],["ai","PROPN",""],["technologies","NOUN","technology"],null,["sharing","NOUN",""],["of","ADP",""],["best","ADJ","good"],["practices","NOUN","practice"],null,["assessment","NOUN",""],["guidelines","NOUN","guideline"],["and","CCONJ",""],["other","ADJ",""],["mechanisms","NOUN","mechanism"],["and","CCONJ",""],["analytical","ADJ",""],["work","NOUN",""],null],"text":"UNESCO recognizes that Member States will be at different stages of readiness to implement this Recommendation, in terms of scientific, technological, economic, educational, legal, regulatory, infrastructural, societal, cultural and other dimensions.It is noted that “readiness” here is a dynamic status.In order to enable the effective implementation of this Recommendation, UNESCO will therefore: (1) develop a readiness assessment methodology to assist interested Member States in identifying their status at specific moments of their readiness trajectory along a continuum of dimensions; and (2) ensure support for interested Member States in terms of developing a UNESCO methodology for Ethical Impact Assessment (EIA) of AI technologies, sharing of best practices, assessment guidelines and other mechanisms and analytical work.","idx":89,"match_words":["unesco","recognize","member states","different","stage","readiness","implement","this recommendation","term","scientific","technological","economic","educational","legal","regulatory","societal","cultural","other","dimension","readiness","here","a dynamic status","order","enable","the effective implementation","this recommendation","unesco","therefore","develop","a readiness assessment methodology","assist","interested member states","identify","their status","specific","their readiness trajectory","a continuum","dimension","ensure","support","interested member states","term","develop","a unesco methodology","ethical impact assessment","eia","technology","sharing","good","practice","assessment","guideline","other","mechanism","analytical work"],"words":["unesco","recognize","that","member states","will","be","at","different","stage","of","readiness","to","implement","this recommendation","in","term","of","scientific","technological","economic","educational","legal","regulatory","infrastructural","societal","cultural","and","other","dimension","it","be","note","that","readiness","here","be","a dynamic status","in","order","to","enable","the effective implementation","of","this recommendation","unesco","will","therefore","develop","a readiness assessment methodology","to","assist","interested member states","in","identify","their status","at","specific","moment","of","their readiness trajectory","along","a continuum","of","dimension","and","ensure","support","for","interested member states","in","term","of","develop","a unesco methodology","for","ethical impact assessment","eia","of","ai","technology","sharing","of","good","practice","assessment","guideline","and","other","mechanism","and","analytical work"],"unmatched_count":36,"match_length":55,"cut_length":91},{"key":"91","text_words":[["member","PROPN",""],["states","PROPN",""],["should","AUX",""],["introduce","VERB",""],["frameworks","NOUN","framework"],["for","ADP",""],["impact","NOUN",""],["assessments","NOUN","assessment"],null,["such","ADJ",""],["as","ADP",""],["ethical","ADJ",""],["impact","NOUN",""],["assessment","NOUN",""],null,["to","PART",""],["identify","VERB",""],["and","CCONJ",""],["assess","VERB",""],["benefits","NOUN","benefit"],null,["concerns","NOUN","concern"],["and","CCONJ",""],["risks","NOUN","risk"],["of","ADP",""],["ai","PROPN",""],["systems","NOUN","system"],null,["as","ADV",""],["well","ADV",""],["as","ADP",""],["appropriate","ADJ",""],["risk","NOUN",""],["prevention","NOUN",""],null,["mitigation","NOUN",""],["and","CCONJ",""],["monitoring","NOUN",""],["measures","NOUN","measure"],null,["among","ADP",""],["other","ADJ",""],["assurance","NOUN",""],["mechanisms","NOUN","mechanism"],null,["such","ADJ","such"],["impact","NOUN",""],["assessments","NOUN","assessment"],["should","AUX",""],["identify","VERB",""],["impacts","NOUN","impact"],["on","ADP",""],["human","ADJ",""],["rights","NOUN","right"],["and","CCONJ",""],["fundamental","ADJ",""],["freedoms","NOUN","freedom"],null,["in","ADP",""],["particular","ADJ",""],["but","CCONJ",""],["not","PART",""],["limited","VERB","limit"],["to","ADP",""],["the","DET",""],["rights","NOUN","right"],["of","ADP",""],["marginalized","ADJ",""],["and","CCONJ",""],["vulnerable","ADJ",""],["people","NOUN",""],["or","CCONJ",""],["people","NOUN",""],["invulnerable","ADJ",""],["situations","NOUN","situation"],null,["labour","NOUN",""],["rights","NOUN","right"],null,["the","DET",""],["environment","NOUN",""],["and","CCONJ",""],["ecosystems","NOUN","ecosystem"],["and","CCONJ",""],["ethical","ADJ",""],["and","CCONJ",""],["social","ADJ",""],["implications","NOUN","implication"],null,["and","CCONJ",""],["facilitate","VERB",""],["citizen","NOUN",""],["participation","NOUN",""],["in","ADP",""],["line","NOUN",""],["with","ADP",""],["the","DET",""],["values","NOUN","value"],["and","CCONJ",""],["principles","NOUN","principle"],["set","VERB",""],["forth","ADP",""],["in","ADP",""],["this","DET",""],["recommendation","PROPN",""],null],"text":"Member States should introduce frameworks for impact assessments, such as ethical impact assessment, to identify and assess benefits, concerns and risks of AI systems, as well as appropriate risk prevention, mitigation and monitoring measures, among other assurance mechanisms.Such impact assessments should identify impacts on human rights and fundamental freedoms, in particular but not limited to the rights of marginalized and vulnerable people or people invulnerable situations, labour rights, the environment and ecosystems and ethical and social implications, and facilitate citizen participation in line with the values and principles set forth in this Recommendation.","idx":90,"match_words":["member states","introduce","framework","impact","assessment","such","ethical impact assessment","identify","assess","benefit","concern","risk","system","well","appropriate risk prevention","mitigation","monitoring","measure","other","mechanism","such","impact","assessment","identify","impact","human","right","fundamental","freedom","particular","limit","right","marginalized and vulnerable people","people","invulnerable","situation","labour","right","the environment","ecosystem","ethical","social","implication","facilitate","citizen participation","line","value","principle","set","this recommendation"],"words":["member states","should","introduce","framework","for","impact","assessment","such","as","ethical impact assessment","to","identify","and","assess","benefit","concern","and","risk","of","ai","system","as","well","as","appropriate risk prevention","mitigation","and","monitoring","measure","among","other","assurance","mechanism","such","impact","assessment","should","identify","impact","on","human","right","and","fundamental","freedom","in","particular","but","not","limit","to","the","right","of","marginalized and vulnerable people","or","people","invulnerable","situation","labour","right","the environment","and","ecosystem","and","ethical","and","social","implication","and","facilitate","citizen participation","in","line","with","the","value","and","principle","set","forth","in","this recommendation"],"unmatched_count":33,"match_length":50,"cut_length":83},{"key":"92","text_words":[["member","PROPN",""],["states","PROPN",""],["and","CCONJ",""],["private","ADJ",""],["sector","NOUN",""],["companies","NOUN","company"],["should","AUX",""],["develop","VERB",""],["due","ADJ",""],["diligence","NOUN",""],["and","CCONJ",""],["oversight","NOUN",""],["mechanisms","NOUN","mechanism"],["to","PART",""],["identify","VERB",""],null,["prevent","NOUN",""],null,["mitigate","NOUN",""],["and","CCONJ",""],["account","VERB",""],["for","ADP",""],["how","SCONJ",""],["they","PRON",""],["address","VERB",""],["the","DET",""]