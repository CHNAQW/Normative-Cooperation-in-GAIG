cation","NOUN",""],null,["targeted","VERB","target"],["at","ADP",""],["supporting","VERB","support"],["girls","NOUN","girl"],["and","CCONJ",""],["women","NOUN","woman"],["to","PART",""],["make","VERB",""],["sure","ADJ",""],["they","PRON",""],["are","AUX","be"],["not","PART",""],["left","VERB","leave"],["out","ADP",""],["of","ADP",""],["the","DET",""],["digital","ADJ",""],["economy","NOUN",""],["powered","VERB","power"],["by","ADP",""],["ai","PROPN",""],null,["special","ADJ","special"],["investment","NOUN",""],["in","ADP",""],["providing","VERB","provide"],["targeted","VERB","target"],["programmes","NOUN","programme"],["and","CCONJ",""],["gender-","NOUN",""],["specific","ADJ",""],["language","NOUN",""],null,["to","PART",""],["increase","VERB",""],["the","DET",""],["opportunities","NOUN","opportunity"],["of","ADP",""],["girls","NOUN","girl"],["’","PUNCT","'"],["and","CCONJ",""],["women","NOUN","woman"],null,["participation","NOUN",""],["in","ADP",""],["science","NOUN",""],null,["technology","NOUN",""],null,["engineering","NOUN",""],null,["and","CCONJ",""],["mathematics","PROPN",""],null,["stem","PROPN",""],null,null,["including","VERB","include"],["information","NOUN",""],["and","CCONJ",""],["communication","NOUN",""],["technologies","NOUN","technology"],null,["ict","PROPN",""],null,["disciplines","NOUN","discipline"],null,["preparedness","NOUN",""],null,["employability","NOUN",""],null,["equal","ADJ",""],["career","NOUN",""],["development","NOUN",""],["and","CCONJ",""],["professional","ADJ",""],["growth","NOUN",""],["of","ADP",""],["girls","NOUN","girl"],["and","CCONJ",""],["women","NOUN","woman"],null,["should","AUX",""],["be","AUX",""],["considered","VERB","consider"],["and","CCONJ",""],["implemented","VERB","implement"],null],"text":"Member States should have dedicated funds from their public budgets linked to financing gender-responsive schemes, ensure that national digital policies include a gender action plan, and develop relevant policies, for example, on labour education, targeted at supporting girls and women to make sure they are not left out of the digital economy powered by AI.Special investment in providing targeted programmes and gender- specific language, to increase the opportunities of girls’ and women’s participation in science, technology, engineering, and mathematics (STEM), including information and communication technologies (ICT) disciplines, preparedness, employability, equal career development and professional growth of girls and women, should be considered and implemented.","idx":128,"match_words":["member states","have","fund","public","gender","scheme","ensure","national","digital","policy","include","a gender action plan","develop","relevant","policy","example","labour education","target","support","girl","woman","make","leave","the digital economy","power","special investment","provide","target","programme","gender- specific language","increase","opportunity","girl","woman","participation","science","technology","engineering","include","information","communication","technology","discipline","equal career development","professional growth","girl","woman","consider","implement"],"words":["member states","should","have","dedicate","fund","from","their","public","budget","link","to","finance","gender","responsive","scheme","ensure","that","national","digital","policy","include","a gender action plan","and","develop","relevant","policy","for","example","on","labour education","target","at","support","girl","and","woman","to","make","sure","they","be","not","leave","out","of","the digital economy","power","by","ai","special investment","in","provide","target","programme","and","gender- specific language","to","increase","the","opportunity","of","girl","and","woman","participation","in","science","technology","engineering","and","mathematics","stem","include","information","and","communication","technology","ict","discipline","preparedness","employability","equal career development","and","professional gr