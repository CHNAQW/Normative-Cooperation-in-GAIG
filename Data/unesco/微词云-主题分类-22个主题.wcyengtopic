d","incentive","against","define","objective","strengthen","the research-","and","evidence","base","analysis","of","and","report","on","policy","regard","ai","ethic","collect","and","disseminate","progress","innovation","research","report","scientific","publication","datum","and","statistic","regard","policy","for","ai","ethic","include","through","exist","initiative","to","support","share","good","practice","and","mutual learning","and","to","advance","the implementation","of","this recommendation"],"unmatched_count":81,"match_length":96,"cut_length":177},{"key":"173","text_words":[["processes","NOUN","process"],["for","ADP",""],["monitoring","NOUN",""],["and","CCONJ",""],["evaluation","NOUN",""],["should","AUX",""],["ensure","VERB",""],["broad","ADJ",""],["participation","NOUN",""],["of","ADP",""],["all","DET",""],["stakeholders","NOUN","stakeholder"],null,["including","VERB","include"],null,["but","CCONJ",""],["not","PART",""],["limited","VERB","limit"],["to","ADP",""],null,["vulnerable","ADJ",""],["people","NOUN",""],["or","CCONJ",""],["people","NOUN",""],["invulnerable","ADJ",""],["situations","NOUN","situation"],null,["social","ADJ","social"],null,["cultural","ADJ",""],["and","CCONJ",""],["gender","NOUN",""],["diversity","NOUN",""],["should","AUX",""],["be","AUX",""],["ensured","VERB","ensure"],null,["with","ADP",""],["a","DET",""],["view","NOUN",""],["to","ADP",""],["improving","VERB","improve"],["learning","NOUN",""],["processes","NOUN","process"],["and","CCONJ",""],["strengthening","VERB","strengthen"],["the","DET",""],["connections","NOUN","connection"],["between","ADP",""],["findings","NOUN","finding"],null,["decision","NOUN",""],null,["making","NOUN",""],null,["transparency","NOUN",""],["and","CCONJ",""],["accountability","NOUN",""],["for","ADP",""],["results","NOUN","result"],null],"text":"Processes for monitoring and evaluation should ensure broad participation of all stakeholders, including, but not limited to, vulnerable people or people invulnerable situations.Social, cultural and gender diversity should be ensured, with a view to improving learning processes and strengthening the connections between findings, decision-making, transparency and accountability for results.","idx":172,"match_words":["process","monitoring","evaluation","ensure","broad participation","stakeholder","include","limit","vulnerable","people","people","invulnerable","situation","social","cultural","gender","diversity","ensure","a view","improve","learning","process","strengthen","decision","making","transparency","accountability","result"],"words":["process","for","monitoring","and","evaluation","should","ensure","broad participation","of","all","stakeholder","include","but","not","limit","to","vulnerable","people","or","people","invulnerable","situation","social","cultural","and","gender","diversity","should","be","ensure","with","a view","to","improve","learning","process","and","strengthen","the","connection","between","finding","decision","making","transparency","and","accountability","for","result"],"unmatched_count":21,"match_length":28,"cut_length":49},{"key":"174","text_words":[["in","ADP","in"],["the","DET",""],["interests","NOUN","interest"],["of","ADP",""],["promoting","VERB","promote"],["best","ADJ","good"],["policies","NOUN","policy"],["and","CCONJ",""],["practices","NOUN","practice"],["related","VERB","relate"],["to","ADP",""],["ethics","NOUN","ethic"],["of","ADP",""],["ai","PROPN",""],null,["appropriate","ADJ",""],["tools","NOUN","tool"],["and","CCONJ",""],["indicators","NOUN","indicator"],["should","AUX",""],["be","AUX",""],["developed","VERB","develop"],["for","ADP",""],["assessing","VERB","assess"],["the","DET",""],["effectiveness","NOUN",""],["and","CCONJ",""],["efficiency","NOUN",""],["thereof","ADV",""],["against","ADP",""],["agreed","VERB","agree"],["standards","NOUN","standard"],null,["priorities","NOUN","priority"],["and","CCONJ",""],["targets","NOUN","target"],null,["including","VERB","include"],["specific","ADJ"