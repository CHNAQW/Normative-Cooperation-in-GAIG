ll,["economic","ADJ",""],["and","CCONJ",""],["environmental","ADJ",""],["impact","NOUN",""],["of","ADP",""],["ai","PROPN",""],["technologies","NOUN","technology"],["should","AUX",""],["therefore","ADV",""],["be","AUX",""],["carried","VERB","carry"],["out","ADP",""],["with","ADP",""],["full","ADJ",""],["cognizance","NOUN",""],["of","ADP",""],["the","DET",""],["implications","NOUN","implication"],["of","ADP",""],["ai","PROPN",""],["technologies","NOUN","technology"],["for","ADP",""],["sustainability","NOUN",""],["as","ADP",""],["a","DET",""],["set","NOUN",""],["of","ADP",""],["constantly","ADV",""],["evolving","VERB","evolve"],["goals","NOUN","goal"],["across","ADP",""],["a","DET",""],["range","NOUN",""],["of","ADP",""],["dimensions","NOUN","dimension"],null,["such","ADJ",""],["as","ADP",""],["currently","ADV",""],["identified","VERB","identify"],["in","ADP",""],["the","DET",""],["sustainable","PROPN",""],["development","PROPN",""],["goals","PROPN",""],null,["sdgs","PROPN",""],null,["of","ADP",""],["the","DET",""],["united","PROPN",""],["nations","PROPN",""],null],"text":"The development of sustainable societies relies on the achievement of a complex set of objectives on a continuum of human, social, cultural, economic and environmental dimensions.The advent of AI technologies can either benefit sustainability objectives or hinder their realization, depending on how they are applied across countries with varying levels of development.The continuous assessment of the human, social, cultural, economic and environmental impact of AI technologies should therefore be carried out with full cognizance of the implications of AI technologies for sustainability as a set of constantly evolving goals across a range of dimensions, such as currently identified in the Sustainable Development Goals (SDGs) of the United Nations.","idx":65,"match_words":["the development","sustainable","society","the achievement","a complex set","objective","a continuum","human","social","cultural","economic","environmental","dimension","the advent","technology","benefit","sustainability","objective","their realization","apply","country","level","development","the continuous assessment","human","social","cultural","economic","environmental","impact","technology","therefore","carry","full cognizance","implication","technology","sustainability","a set","a range","dimension","such","identify","the sustainable development goals","the united nations"],"words":["the development","of","sustainable","society","rely","on","the achievement","of","a complex set","of","objective","on","a continuum","of","human","social","cultural","economic","and","environmental","dimension","the advent","of","ai","technology","can","either","benefit","sustainability","objective","or","hinder","their realization","depend","on","how","they","be","apply","across","country","with","vary","level","of","development","the continuous assessment","of","the","human","social","cultural","economic","and","environmental","impact","of","ai","technology","should","therefore","be","carry","out","with","full cognizance","of","the","implication","of","ai","technology","for","sustainability","as","a set","of","constantly","evolve","goal","across","a range","of","dimension","such","as","currently","identify","in","the sustainable development goals","sdgs","of","the united nations"],"unmatched_count":49,"match_length":44,"cut_length":93},{"key":"67","text_words":[["right","ADV","right"],["to","ADP",""],["privacy","PROPN",""],null,["and","CCONJ",""],["data","PROPN",""],["protection","PROPN",""]],"text":"Right to Privacy, and Data Protection","idx":66,"match_words":["right","privacy","data","protection"],"words":["right","to","privacy","and","data","protection"],"unmatched_count":2,"match_length":4,"cut_length":6},{"key":"68","text_words":[["privacy","NOUN","privacy"],null,["a","DET",""],["right","ADJ",""],["essential","ADJ",""],["to","ADP",""],["the","DET",""],["protection","NOUN",""],["of","ADP",""],["human","A