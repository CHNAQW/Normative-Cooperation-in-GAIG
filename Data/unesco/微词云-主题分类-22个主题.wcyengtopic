,["of","ADP",""],["recommender","ADJ","recommend"],["systems","NOUN","system"],["should","AUX",""],["be","AUX",""],["part","NOUN",""],["of","ADP",""],["those","DET",""],["efforts","NOUN","effort"],null],"text":"Member States should invest in and promote digital and media and information literacy skills to strengthen critical thinking and competencies needed to understand the use and implication of AI systems, in order to mitigate and counter disinformation, misinformation and hate speech.A better understanding and evaluation of both the positive and potentially harmful effects of recommender systems should be part of those efforts.","idx":154,"match_words":["member states","invest","promote","digital","medium","information","literacy","skill","strengthen","critical thinking","need","understand","the use","implication","system","order","mitigate","disinformation","misinformation and hate speech","well","understanding","evaluation","positive","potentially","effect","recommend","system","part","effort"],"words":["member states","should","invest","in","and","promote","digital","and","medium","and","information","literacy","skill","to","strengthen","critical thinking","and","competency","need","to","understand","the use","and","implication","of","ai","system","in","order","to","mitigate","and","counter","disinformation","misinformation and hate speech","a","well","understanding","and","evaluation","of","both","the","positive","and","potentially","harmful","effect","of","recommend","system","should","be","part","of","those","effort"],"unmatched_count":28,"match_length":29,"cut_length":57},{"key":"156","text_words":[["member","PROPN",""],["states","PROPN",""],["should","AUX",""],["create","VERB",""],["enabling","VERB","enable"],["environments","NOUN","environment"],["for","SCONJ",""],["media","NOUN","medium"],["to","PART",""],["have","VERB",""],["the","DET",""],["rights","NOUN","right"],["and","CCONJ",""],["resources","NOUN","resource"],["to","PART",""],["effectively","ADV