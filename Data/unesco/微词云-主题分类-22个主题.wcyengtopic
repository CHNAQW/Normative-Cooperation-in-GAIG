",""],["environment","NOUN",""],null,["biodiversity","NOUN",""],["and","CCONJ",""],["ecosystems","NOUN","ecosystem"],[";","PUNCT",""],["and","CCONJ",""],["to","PART",""],["respect","VERB",""],["cultural","ADJ",""],["diversity","NOUN",""],["in","ADP",""],["all","DET",""],["stages","NOUN","stage"],["of","ADP",""],["the","DET",""],["ai","PROPN",""],["system","NOUN",""],["life","NOUN",""],["cycle;to","NOUN",""],["foster","ADJ",""],["multi","NOUN",""],null,["stakeholder","ADJ",""],null,["multidisciplinary","ADJ",""],["and","CCONJ",""],["pluralistic","ADJ",""],["dialogue","NOUN",""],["and","CCONJ",""],["consensus","NOUN",""],["building","NOUN",""],["about","ADP",""],["ethical","ADJ",""],["issues","NOUN","issue"],["relating","VERB","relate"],["to","ADP",""],["ai","PROPN",""],["systems;to","NOUN",""],["promote","VERB",""],["equitable","ADJ",""],["access","NOUN",""],["to","ADP",""],["developments","NOUN","development"],["and","CCONJ",""],["knowledge","NOUN",""],["in","ADP",""],["the","DET",""],["field","NOUN",""],["of","ADP",""],["ai","PROPN",""],["and","CCONJ",""],["the","DET",""],["sharing","NOUN",""],["of","ADP",""],["benefits","NOUN","benefit"],null,["with","ADP",""],["particular","ADJ",""],["attention","NOUN",""],["to","ADP",""],["the","DET",""],["needs","NOUN","need"],["and","CCONJ",""],["contributions","NOUN","contribution"],["of","ADP",""],["lmics","NOUN","lmic"],null,["including","VERB","include"],["ldcs","NOUN","ldc"],null,["lldcs","NOUN","lldc"],["and","CCONJ",""],["sids","PROPN",""],null],"text":"The objectives of this Recommendation are: to provide a universal framework of values, principles and actions to guide States in the formulation of their legislation, policies or other instruments regarding AI, consistent with international law;to guide the actions of individuals, groups, communities, institutions and private sector companies to ensure the embedding of ethics in all stages of the AI system life cycle;to protect, promote and respect human rights and fundamental freedoms, human dignity and equality, including gender equality; to safeguard the interests of present and future generations; to preserve the environment, biodiversity and ecosystems; and to respect cultural diversity in all stages of the AI system life cycle;to foster multi-stakeholder, multidisciplinary and pluralistic dialogue and consensus building about ethical issues relating to AI systems;to promote equitable access to developments and knowledge in the field of AI and the sharing of benefits, with particular attention to the needs and contributions of LMICs, including LDCs, LLDCs and SIDS.","idx":33,"match_words":["objective","this recommendation","provide","a universal framework","value","principle","action","guide","states","the formulation","their legislation","policy","other","instrument","regard","consistent","international law;to","guide","action","individual","group","community","institution","private","sector","company","ensure","the embedding","ethic","stage","the ai system life","protect","promote","respect","human","right","fundamental","freedom","human dignity","equality","include","gender equality","safeguard","interest","present","future","generation","preserve","the environment","ecosystem","respect","cultural diversity","stage","the ai system life","foster multi","stakeholder","multidisciplinary","pluralistic dialogue","consensus building","ethical","issue","relate","promote","equitable access","development","knowledge","the field","the sharing","benefit","particular attention","need","lmic","include","ldc","lldc","sids"],"words":["the","objective","of","this recommendation","be","to","provide","a universal framework","of","value","principle","and","action","to","guide","states","in","the formulation","of","their legislation","policy","or","other","instrument","regard","ai","consistent","with","international law;to","guide","the","action","of","individual","group","community","institution","and","private","sector","company","to","ensur