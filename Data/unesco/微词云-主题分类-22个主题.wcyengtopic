em"],["to","PART",""],["contribute","VERB",""],["throughout","ADP",""],["their","PRON",""],["life","NOUN",""],["cycle","NOUN",""],["to","ADP",""],["the","DET",""],["interconnectedness","NOUN",""],["of","ADP",""],["all","DET",""],["living","NOUN",""],["creatures","NOUN","creature"],["with","ADP",""],["each","DET",""],["other","ADJ",""],["and","CCONJ",""],["with","ADP",""],["the","DET",""],["natural","ADJ",""],["environment","NOUN",""],null],"text":"AI actors should play a participative and enabling role to ensure peaceful and just societies, which is based on an interconnected future for the benefit of all, consistent with human rights and fundamental freedoms.The value of living in peaceful and just societies points to the potential of AI systems to contribute throughout their life cycle to the interconnectedness of all living creatures with each other and with the natural environment.","idx":53,"match_words":["actor","play","enable","role","ensure","peaceful","just","society","base","an interconnected future","the benefit","consistent","human","right","fundamental","freedom","the value","live","peaceful","just","society","the potential","system","contribute","their life cycle","the interconnectedness","other","the natural environment"],"words":["ai","actor","should","play","a","participative","and","enable","role","to","ensure","peaceful","and","just","society","which","be","base","on","an interconnected future","for","the benefit","of","all","consistent","with","human","right","and","fundamental","freedom","the value","of","live","in","peaceful","and","just","society","point","to","the potential","of","ai","system","to","contribute","throughout","their life cycle","to","the interconnectedness","of","all","living","creature","with","each","other","and","with","the natural environment"],"unmatched_count":33,"match_length":28,"cut_length":61},{"key":"54","text_words":[["the","DET","the"],["notion","NOUN",""],["of","ADP",""],["humans","NOUN","human"],["being","AUX","b